# The value last reported as unusable for each setting. A worker thread that reads a bad
# interval every few seconds should say so once, not once a pass.
_reportedBadSettings = {}

def settingProblem(name, value, detail):
    """Reports an unusable setting once, to the log and to the UI."""
    if name in _reportedBadSettings and _reportedBadSettings[name] == value:
        return
    _reportedBadSettings[name] = value
    msg = "Setting {} is unusable ({!r}): {}".format(name, value, detail)
    logger.error(msg)
    try:
        triggerEvent("error", msg)
    except Exception:
        # No event loop yet -- this is reachable from initStuff() before the UI exists.
        # The log line above is the part that must not be lost.
        pass

def numericSetting(name, fallback=None):
    """The setting as a number inside its bounds, or `fallback`.

    A drop-in for `s.q(name, fallback=X)` at every numeric read site, with the one
    difference that a value outside settingBounds[name] is refused and reported rather
    than used. The fallback that comes back is the caller's own -- the same one it
    already had -- so nothing here invents a value for a setting nobody entered.

    Unset returns the fallback silently: that is the normal state under the no-defaults
    contract and says nothing about the operator's intentions. Out of bounds is reported,
    because it means they entered something that cannot be honoured.
    """
    value = s.q(name, fallback=None)
    if value is None or value == "":
        return fallback
    floor, ceiling = settingBounds[name]
    # bool before number: isinstance(True, int) is True, and True would otherwise sail
    # through every comparison below as 1.
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        settingProblem(name, value, "not a number")
        return fallback
    if value < floor or value > ceiling:
        settingProblem(name, value, "outside {} to {}".format(floor, ceiling))
        return fallback
    _reportedBadSettings.pop(name, None)
    return value

def storedBaud(name):
    """The stored rate if it is one of the standard ones, otherwise None.

    What the settings dialog shows. A rate outside the standard set vanishes rather than
    being offered back for re-selection: there is no hardware it could be right for.
    """
    value = s.q(name, fallback=None)
    return int(value) if value in baudRates else None

def baudSetting(name):
    """The baud rate to open a port with, or None -- which callers must treat as fatal.

    The one numeric setting with no fallback, deliberately. An interval that is out of
    range can be replaced with a sane one and everything downstream is merely differently
    timed; a wrong baud does not fail cleanly, it yields bytes that parse into
    plausible-looking garbage, and on the environment board that garbage drives the fans.
    """
    value = storedBaud(name)
    if value is not None:
        _reportedBadSettings.pop(name, None)
        return value
    raw = s.q(name, fallback=None)
    if raw is not None and raw != "":
        settingProblem(name, raw, "not one of the standard baud rates")
    return None

def boundedNumber(label, name, **kwargs):
    """A settings field that carries its own bounds.

    Built from settingBounds so the dialog and the guard cannot disagree: a bound changed
    in one place is a bound changed in both.
    """
    floor, ceiling = settingBounds[name]
    return ui.number(label, value=s.q(name, fallback=None), min=floor, max=ceiling, **kwargs)

def spawn(coro):
    task = asyncio.create_task(coro)
    backgroundTasks.add(task)
    task.add_done_callback(backgroundTasks.discard)
    return task

# How long the RTSP open and the frame read may each take. Named because
# captureStopBudget() is derived from it: the capture worker sits inside grabRTSP, so the
# join that has to outlast a grab must be sized against this number and cannot be allowed
# to drift away from it.
rtspGrabTimeout = 10

# The widest a CCTV frame is allowed to reach the rest of the program. Cameras here are
# 1080p or better, and every stage downstream of the grab is paid per pixel: the colour
# conversion and the PIL wrap in grabRTSP, then the JPEG encode and the base64 in
# encodeImage, and finally the string itself down one websocket per connected client every
# stream_refresh seconds. Full-resolution q80 runs a few hundred kB, which base64 inflates
# by a third; at 960 wide it is a fraction of that, for a picture nobody inspects pixel by
# pixel -- the frame answers "is the roof where I left it", not "which star is that".
#
# 960 rather than a 16:9 480p width because the common inputs divide into it exactly (1920
# halves, 3840 quarters), and an integer reduction is the case cv2.resize's INTER_AREA has
# a fast path for. A camera that does not divide evenly still works, just by the general
# path. A module constant and not a setting on purpose: it is a pipeline property with one
# sensible value, like rtspGrabTimeout above, and nothing about it is per-installation.
streamMaxWidth = 960

def downscaleFrame(frame, maxWidth=streamMaxWidth):
    """Shrinks a decoded frame to at most maxWidth, keeping its aspect ratio.

    Done here, on the raw array, rather than on the PIL image grabRTSP returns: the caller
    that matters converts colour and wraps the buffer immediately afterwards, so resizing
    first makes those two cheaper as well, and cv2's reduction is faster than PIL's on the
    Pi. Net effect is less work than not resizing at all -- the resize costs far less than
    the JPEG encode it shrinks by the same factor.

    INTER_AREA because this only ever reduces: it averages the pixels that fall into each
    output cell, where the interpolating filters sample a few of them and alias whatever is
    finer than the new grid -- exactly the fence and gravel detail a CCTV frame is full of.

    A frame already at or below maxWidth is returned untouched. Never enlarges: there is no
    detail to recover, and it would cost every stage downstream to invent pixels.
    """
    height, width = frame.shape[:2]
    if width <= maxWidth:
        return frame
    # max(1, ...) so an implausibly wide, short frame cannot ask for a zero-height image,
    # which cv2 rejects outright.
    return cv2.resize(frame, (maxWidth, max(1, round(height * maxWidth / width))),
                      interpolation=cv2.INTER_AREA)


def grabRTSP(url: str, timeout=rtspGrabTimeout):
    logger.debug("Grabbing frame from {}".format(url))
    logger.debug("Opening capture")
    # The timeouts go in the constructor's params list, not into set() afterwards. The
    # open happens inside VideoCapture(), so a CAP_PROP_OPEN_TIMEOUT_MSEC set on the
    # returned object arrives after the thing it was meant to bound has already finished
    # -- which left the open governed only by FFMPEG's own default, tens of seconds
    # against a black-holed TCP connect. That is why a capture worker could outlast its
    # join by far more than the two timeouts below suggest.
    cap = cv2.VideoCapture(url, cv2.CAP_FFMPEG, [
        cv2.CAP_PROP_OPEN_TIMEOUT_MSEC, int(timeout * 1000),
        cv2.CAP_PROP_READ_TIMEOUT_MSEC, int(timeout * 1000),
        ])
    try:
        if not cap.isOpened():
            raise Exception("Failed to open RTSP stream at {}".format(url))
        logger.debug("Reading frame")
        ok, frame = cap.read()
        if not ok:
            raise Exception("Failed to read frame from stream at {}".format(url))
        if frame is None:
            raise Exception("Received empty frame from {}".format(url))
        # Downscaled before the conversion and the wrap, not after: both are per-pixel, and
        # so is everything the caller does with the result.
        return Image.fromarray(cv2.cvtColor(downscaleFrame(frame), cv2.COLOR_BGR2RGB))
    finally:
        cap.release()


def encodeImage(img, format="JPEG", **kwargs):
    """Encodes a PIL image as a data URI, on whatever thread is calling.

    ui.image accepts a PIL image directly, and that is the expensive way to give it one.
    NiceGUI encodes such a source to PNG, writes it to a temporary file, removes the
    previous FastAPI route and registers a new one for the new file (nicegui 3.15.0,
    elements/image.py and mixins/source_element.py) -- all of it synchronously, inside
    set_source(), which the refresh timers call *on the event loop*, once per connected
    client. A full-resolution PNG encode is the kind of work that stalls a Pi for a
    noticeable fraction of a second, and it was being done once per frame per client.

    A data URI is just a string. helpers.is_file() rejects anything starting with "data:"
    before it can become a Path, so set_source() does nothing but assign it, and the
    encoding happens here instead: once per frame, on the worker thread that produced it,
    no matter how many browsers are watching.

    JPEG by default, because the caller with the volume is the CCTV frame: far cheaper to
    encode than PNG and a fraction of the bytes to push down each websocket, for an image
    nobody examines pixel by pixel. Callers whose image is flat colour and text pass
    format="PNG", where lossy compression would only ring around the glyphs.
    """
    buffer = BytesIO()
    img.save(buffer, format, **kwargs)
    encoded = base64.b64encode(buffer.getvalue()).decode()
    return "data:image/{};base64,{}".format(format.lower(), encoded)


def createErrorImage(text: str):
    img = Image.new('RGB', (640, 360), color=(40, 40, 40))
    draw = ImageDraw.Draw(img)

    draw.text((20, 20), text, fill=(255, 255, 255))

    return encodeImage(img, "PNG")



# The most recent CCTV frame as a data URI, or None when there is nothing to show. A
# string rather than a PIL image on purpose -- see encodeImage() for what handing the
# latter to ui.image costs on the event loop.
last_stream_image = None
# time.monotonic() of the last frame publish (real or error), 0.0 until the first one.
# Read by updateStream() to judge staleness -- see last_stream_image's own comment above
# for why a failed grab still counts as a publish.
last_stream_image_time = 0.0
last_stream_image_lock = threading.Lock()
captureThread = None
# The current capture worker's stop event, and only that. startCaptureLoop() gives each new
# worker a fresh one rather than clearing this, so signalling one worker can never be undone
# on behalf of another -- exactly the reasoning behind roofStopEvent.
captureStopEvent = threading.Event()
# Bumped by stopCaptureLoop() whenever a worker is retired. A worker carries the value it was
# started with and leaves as soon as it no longer matches. A worker whose join expired would
# otherwise go on publishing last_stream_image alongside its replacement, and the two do not
# agree: a frame grabbed before the camera was reconfigured, or the error image from whatever
# made the old worker hang, would land on top of a good current frame at random. Read without
# a lock -- an int read is atomic under the GIL, and the check only has to be eventually
# right.
captureGeneration = 0

# On top of the two timeouts a grab can spend: cap.release(), which FFMPEG does not bound,
# and the JPEG encode of the frame that came back, which is real work on a Pi at 4K.
captureStopGrace = 3

def captureStopBudget():
    """How long stopCaptureLoop() waits for its worker.

    Derived from what the worker can actually be inside, the same way roofStopBudget()
    and environmentStopBudget() are. A flat 5s was shorter than one grab -- open and read
    are rtspGrabTimeout each -- so against a camera that was not answering the join did
    not occasionally expire, it expired every time, and every settings save abandoned a
    worker and logged a warning that read like a fault.

    Abandonment is still handled rather than prevented: FFMPEG may overrun its own
    timeouts and DNS is bounded by nothing, so this makes the common case join cleanly and
    leaves the generation check to cover the rest.
    """
    return 2 * rtspGrabTimeout + captureStopGrace

def captureLoop(stopEvent, generation):
    """The capture worker. Its stop event and its identity are arguments, not globals.

    stopEvent is this worker's own, so a worker that stopCaptureLoop() signalled stays
    signalled no matter what the next one does. generation is what makes a worker that could
    not be joined harmless: it stops publishing as soon as it no longer matches.

    A worker whose join timed out normally leaves through the stop event, which stays set.
    The generation check covers the window that event cannot -- the grab already in flight
    when the replacement was built, which against an unresponsive camera is seconds long.

    The body is guarded as a whole, like the weather and environment workers. Only the grab
    used to be, which left everything around it able to kill the thread outright: nothing
    restarts a capture worker until the next settings save, so the UI would sit on "Waiting
    for the stream ..." indefinitely and the traceback would go to threading.excepthook on
    stderr rather than through the logger. One bad pass costs a pass.
    """
    global last_stream_image, last_stream_image_time
    while not stopEvent.is_set():
        if generation != captureGeneration:
            logger.warning("Capture worker {} superseded by {}, exiting".format(
                generation, captureGeneration))
            break
        try:
            reason = cctvUnavailableReason()
            if reason is not None:
                # Nothing to connect to: an unconfigured stream has no address and an
                # unpowered camera would only swallow the full open timeout before failing.
                # Publish no frame at all -- the UI shows the reason instead, and a frame
                # from before the camera was switched off would be a lie.
                logger.debug("Not grabbing a CCTV frame: {}".format(reason))
                frame = None
            else:
                try:
                    # Encoded here, on this thread, rather than left as a PIL image for
                    # updateStream() to hand to ui.image -- that put a PNG encode and a
                    # temp-file write on the event loop for every client watching. Inside
                    # the same try as the grab, so an image that will not encode shows up as
                    # an error frame like any other failure instead of killing this pass.
                    frame = encodeImage(grabRTSP(s.q("stream_rtsp")), "JPEG", quality=80)
                except Exception as e:
                    frame = createErrorImage("{}".format(e))
            if generation != captureGeneration:
                # Superseded while this frame was being grabbed, which takes seconds against
                # a camera that is not answering. Publishing it now would put a frame from a
                # retired worker on top of whatever its replacement has already shown.
                logger.info("Capture worker superseded mid-grab, discarding the frame")
                break
            with last_stream_image_lock:
                last_stream_image = frame
                last_stream_image_time = time.monotonic()
        except Exception as e:
            # last_stream_image is deliberately left alone: whatever it holds is a real
            # frame from a pass that worked, and it ages out through the UI's own staleness
            # rules. Replacing it with an error image here would claim the camera failed
            # when the fault is on this side.
            logger.error("Error in capture loop: {}".format(e))
        finally:
            # This worker's own event. Already set for a worker on its way out, so neither
            # break above waits out a refresh period first.
            stopEvent.wait(numericSetting("stream_refresh", 5))

def stopCaptureLoop():
    global captureThread, captureGeneration
    # Before the join, not after: from here on any worker still running is superseded,
    # whether it manages to stop or not, and must not publish another frame.
    captureGeneration += 1
    if captureThread is not None and captureThread.is_alive():
        logger.info("Stopping capture loop")
        # This worker's own event, and it stays set: startCaptureLoop() gives the next worker
        # a fresh one instead of clearing this, so a worker that cannot be joined below can
        # never be woken again by the next start.
        captureStopEvent.set()
        budget = captureStopBudget()
        captureThread.join(timeout=budget)
        if captureThread.is_alive():
            # Not fatal, unlike the roof's equivalent: this worker holds no lock anything
            # else needs, and grabRTSP releases its capture in a finally, so it leaves of its
            # own accord once the grab it is stuck in returns. Superseded, it publishes
            # nothing more in the meantime. Worth saying out loud all the same -- it means
            # the camera or the RTSP stack is not answering within the join.
            logger.warning(
                    "Capture worker did not stop within {:.1f}s and was abandoned. It is "
                    "superseded and will publish no further frames; it exits by itself once "
                    "the grab it is stuck in returns. Note it still holds an RTSP session "
                    "until then, which the camera may count against its session "
                    "limit".format(budget))
        else:
            logger.info("Capture loop stopped")
    # Cleared either way: a thread that outlived its join is not something anything should go
    # on to join or signal again.
    captureThread = None

def startCaptureLoop():
    global captureThread, captureStopEvent
    stopCaptureLoop()
    logger.info("Starting capture loop")
    # A fresh event per worker, handed over as an argument, rather than clearing a shared
    # one. A previous worker that stopCaptureLoop() signalled but could not join is still
    # waiting on *its* event; clearing that same object here used to un-signal it, so the
    # orphan resumed grabbing and two workers then wrote last_stream_image.
    workerStopEvent = threading.Event()
    captureStopEvent = workerStopEvent
    # stopCaptureLoop() bumped the generation above, so this worker takes the current value
    # and every older one is already superseded.
    captureThread = threading.Thread(
        target=captureLoop,
        args=(workerStopEvent, captureGeneration),
        daemon=True,
        name="OMS rstp worker"
    )
    captureThread.start()
    logger.info("Capture loop started")



def getWeather():
    # scrapeWeather(), not the weather endpoint, which now serves this worker's own cache
    # and would be reading back what it is here to fetch.
    data = apiv1.scrapeWeather()
    if data.status_code != 200:
        raise Exception("Error getting weather: status code {}: {}".format(data.status_code, data.body))
    try:
        d = json.loads(data.body)
        return d
    except Exception as e:
        raise Exception("Error parsing json: {}".format(e))

def asNumber(value):
    """`value` as a float, or None if the station did not send a usable number.

    Fields go missing from the payload now and then, or arrive as null: a sensor the
    station could not read this cycle. Readers compare these against thresholds, where a
    None raises TypeError -- and a raise costs them every *other* field in the same pass,
    which is how one absent reading used to freeze the whole weather card. NaN is folded
    in here too, so callers have exactly one absent value to test for.
    """
    if value is None or isinstance(value, bool):
        return None
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return None if math.isnan(number) else number

environmentInfluxClient = None
environmentWriteApi = None
environmentSerial = None
environmentThread = None
# Bumped by stopEnvironmentWorker() whenever a worker is retired, exactly as roofGeneration
# is for the roof. A worker carries the value it was started with and leaves as soon as it
