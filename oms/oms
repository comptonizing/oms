    event loop, so everything that blocks -- joining worker threads, opening the roof
    and environment serial ports, each of which can take seconds on a wedged USB
    bridge -- is pushed to a worker thread. initSwitches() stays on the event loop:
    it can rewrite settings storage, which has to happen there (see applyFanMode), and
    is only GPIO work otherwise. It keeps its position between the two, because the
    roof has to claim its pins before the switch pins are checked against them.
    """
    await asyncio.to_thread(makeRoof)
    initSwitches()
    await asyncio.to_thread(startWorkers)

@app.on_shutdown
async def shutdown():
    stopCaptureLoop()
    stopEnvironmentWorker()
    stopWeatherWorker()
    # Joins the roof thread and then waits for roofLock to switch the fans off:
    # ~10s worst case, which would otherwise be spent with the event loop blocked
    # while uvicorn is trying to close the client websockets. asyncio.to_thread
    # rather than run.io_bound -- NiceGUI tears down its own executor on shutdown.
    await asyncio.to_thread(stopRoof)

@app.on_startup
async def startup():
    global mainLoop
    await s.init()
    mainLoop = asyncio.get_event_loop()
    spawn(updateWorker())
    await initStuff()

try:
    ui.run(dark=True, favicon="favicon.svg", port=args.port, reload=False)
except KeyboardInterrupt:
    logger.info("Shutdown requested, exiting")
