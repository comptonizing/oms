                title = title,
                margin = dict(l=10, r=10, t=50, b=10),
                legend = { "orientation": "h", "yanchor": "bottom", "y": 1.02, "xanchor": "right", "x": 1}
                )
        fig.update_xaxes(gridcolor='#555')
        fig.update_yaxes(gridcolor='#555')
        updatePlot(plot)
        return plot

    def makeUnavailableMessage(icon: str):
        """Placeholder shown in a camera card while that camera has nothing to show.

        Created hidden; showUnavailable() swaps it in for the image. Returns the panel
        and the label inside it, which is the pair that function expects.
        """
        with ui.column().classes("w-full items-center justify-center gap-2 py-16") as panel:
            ui.icon(icon, size="4rem").classes("text-gray-500")
            label = ui.label("").classes("text-center text-gray-400")
        panel.set_visibility(False)
        return panel, label

    def showUnavailable(image, message, reason):
        """Shows either the camera image or the message saying why there is none."""
        panel, label = message
        if reason is None:
            panel.set_visibility(False)
            image.set_visibility(True)
            return
        label.set_text(reason)
        image.set_visibility(False)
        panel.set_visibility(True)


    def settingsProblems():
        """Everything in the dialog that is outside its bounds, phrased for the operator.

        Only the fields with bounds are examined. An empty field is not a problem: not
        entering a value is how a setting is left unconfigured, and that is a supported
        state rather than a mistake.
        """
        problems = []
        for thing, widget in settings.items():
            if thing not in settingBounds:
                continue
            value = widget.value
            if value is None or value == "":
                continue
            floor, ceiling = settingBounds[thing]
            if isinstance(value, bool) or not isinstance(value, (int, float)):
                problems.append("{} must be a number".format(thing))
            elif value < floor or value > ceiling:
                problems.append("{} must be between {} and {}".format(thing, floor, ceiling))
        return problems

    async def saveSettings():
        problems = settingsProblems()
        if problems:
            # Nothing is stored, rather than storing the fields that happen to be fine.
            # A settings save is not a set of independent writes: the next statement
            # re-opens two serial ports and restarts three workers, and doing that
            # against a half-applied configuration is worse than not saving at all. The
            # operator keeps what they typed and can correct it in place.
            ui.notify("Not saved: " + "; ".join(problems), type="negative", multi_line=True)
            return
        # Applying takes ten to fifteen seconds -- two serial ports re-opened, three
        # workers stopped and started -- and it used to do that with the button still
        # live and nothing on screen to say anything was happening. Every impatient
        # click queued another complete re-initialization behind initLock: the roof
        # torn down and rebuilt again, and the environment port re-opened again, which
        # asserts DTR and resets the board on the other end of it. The loading state
        # lasts the whole pass; the notification only announces it, which is why both
        # are here.
        saveButton.disable()
        saveButton.props("loading")
