    # How far apart stacked lanes sit. 1.0 would let a series sitting at true touch the
    # baseline of the one above it, which reads as one signal rather than two.
    laneSpacing = 1.4

    def plotLanes(fig, lanes):
        """Draws boolean series as stacked lanes on one figure.

        Eight booleans on a shared 0/1 axis are eight traces drawn on top of each other,
        and the only one visible is whichever was added last. Each series gets a lane of
        its own instead: its value is drawn at its own offset, and the axis is ticked with
        the names rather than with numbers that would every one of them read 0 or 1.

        Step lines, not straight ones. These change instantly and hold, so a slope between
        two samples would draw a transition that never happened -- and where it happened is
        the whole question when a roof stopped halfway.

        `lanes` is (name, times, values, colour), bottom lane first, so a figure reads in
        the order its list is written.
        """
        for index, (name, times, values, colour) in enumerate(lanes):
            base = index * laneSpacing
            fig.add_scatter(
                    x = times,
                    y = [base + (1 if value else 0) for value in values],
                    mode = "lines",
                    line_shape = "hv",
                    name = name,
                    line = {"color": colour},
                    )
        fig.update_layout(
                showlegend = False,
                yaxis = {
                    "tickmode": "array",
                    "tickvals": [index * laneSpacing for index in range(len(lanes))],
                    "ticktext": [name for name, _, _, _ in lanes],
                    "range": [-0.4, (len(lanes) - 1) * laneSpacing + 1.4],
                    "gridcolor": "#555",
                    },
                )

