async def queryWeather(api, thing, start, window):
    query = """from(bucket: "weather")
      |> range(start: -{})
      |> filter(fn: (r) => r["_measurement"] == "weather")
      |> filter(fn: (r) => r["_field"] == "{}")
      |> aggregateWindow(every: {}, fn: mean, createEmpty: false)
      |> yield(name: "mean")""".format(start, thing, window)
    logger.debug("Querying weather: " + query)

    result = await api.query(org=s.q("weather_db_org"), query=query)
    vals = result.to_values()
    times = []
    values = []
    for ii in range(len(vals)):
        times.append(list(vals[ii])[4])
        values.append(list(vals[ii])[5])
    return times, values


updateQueue = asyncio.Queue()
updateCallbacks: dict[str, callable] = {}
def triggerEvent(*args):
    updateQueue.put_nowait(list(args))


async def updateWorker():
    while True:
        thing = await updateQueue.get()
        logger.debug("update workger got event {}".format(thing))
        for clientId, client in list(Client.instances.items()):
            if clientId not in updateCallbacks:
                continue
            async def run(cid=clientId, c=client):
                try:
                    with c:
                        await updateCallbacks[cid](thing)
                except Exception as e:
                    logger.warning("Error running callback on client {}:\n{}".format(cid, e))
            logger.debug("Dispatching event for client {}: {}".format(clientId, thing))
            asyncio.create_task(run())

def pinUsedForRoof(pin: int):
    l = [
            s.q("roof_pins_west_open"),
