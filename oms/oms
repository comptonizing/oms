    settings = {}

    def onTabChange(e):
        header_label.set_text(e.value)
        drawer.hide()

    # How long to let the loop breathe after pushing a figure to the browser. Five pushes
    # per pass, so this is the entire cost of being polite now that the per-query sleeps
    # are gone: 0.25s against the 4.5s they used to add.
    plotPushPause = 0.05

    def updatePlot(plot):
        plot.update()
        with plot._props.suspend_updates():
            plot._props['options']['config'] = {'displayModeBar': False, 'staticPlot': True}
        plot.client.outbox.enqueue_update(plot)

    async def pushPlot(plot):
        """Pushes a finished figure to the browser, then lets the loop breathe.

        This is where the work actually is: serializing a figure and enqueuing it for the
        websocket, once per plot. The pause sits here, after a push, rather than being
        spread over every query -- awaiting a query already yields the loop by itself, so
        the sleeps that used to follow each one were buying responsiveness that the await
        had already bought, at 0.3s a time.
        """
        updatePlot(plot)
        await asyncio.sleep(plotPushPause)

    def makePlot(title: str):
        plot = ui.plotly(go.Figure()).classes("w-full")
        fig = plot.figure
        fig.update_layout(
                height = 300,
                font_color='white',
                paper_bgcolor='rgba(0,0,0,0)',
