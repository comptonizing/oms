environmentGeneration = 0
# How long the board may say nothing at all before the worker gives up on the open port and
# opens it again. The board talks constantly -- it emits LOG: lines between measurements --
# so silence this long is a dead link, not a slow one. Sixty seconds is the same threshold
# updateFans judges the readings by, so a reopen never throws away anything still in use,
# and it is long enough that a board which is merely slow to answer is left alone.
environmentSilenceTimeout = 60

# On top of one full read: the parse and the lock handoff that follow it.
#
# The worker holds environmentLock across readline(), so anything waiting for that lock --
# or joining the thread itself -- has to outlast a read, and how long a read lasts is a
# setting. Derived rather than hardcoded for that reason: the flat 5s these waits used to
# carry was sized against a 2s timeout, and would have begun failing the moment
# weather_environment_timeout was set anywhere near its 5s ceiling. The failure is not
# subtle -- stopEnvironmentWorker gives up on the lock and the port, opened exclusive=True,
# stays claimed until the process exits.
environmentStopGrace = 3

def environmentStopBudget():
    return numericSetting("weather_environment_timeout", 2) + environmentStopGrace
environmentLock = threading.Lock()
# The current worker's stop event, and only that. startEnvironmentWorker() gives each new
# worker a fresh one rather than clearing this, so signalling one worker can never be undone
# on behalf of another -- exactly the reasoning behind captureStopEvent and roofStopEvent.
# Before this, the loop read this global directly, and startEnvironmentWorker()'s clear()
# could un-signal a zombie still sitting in wait(), reviving it to reopen a port a stop had
# just closed.
environmentStopEvent = threading.Event()
environmentParameterMap = { "T": "inside_temperature", "H": "inside_humidity" }
environmentLastData = {}
environmentWriteOptions = WriteOptions(
            batch_size = 20,
            flush_interval = 10000,
            jitter_interval = 0,
            retry_interval = 5000,
            max_retry_time = 600000,
            max_retries = 100,
            max_retry_delay = 60000,
            # How long close() may spend flushing what is still batched. Never exercised
            # until stopEnvironmentWorker() started closing the write API, and a minute of
            # it would have meant a minute-long shutdown whenever InfluxDB is unreachable.
            # Five seconds is enough for a healthy database on the LAN, and losing a few
            # buffered points from a dead one beats hanging the shutdown.
            max_close_wait = 5000,
            exponential_base = 2
    )
for thing in environmentParameterMap.values():
    environmentLastData[thing] = None
# time.monotonic(), like every other interval clock here: a wall-clock reading would be
# thrown off by an NTP step or a DST change, and this one decides whether the fans may run.
# 0.0 still means "never read", since monotonic() is never 0 in practice.
environmentLastData["timestamp"] = 0.0

# How old an inside reading may be before nothing should be concluded from it. Named here
# rather than written into each of the two places that judge it, which is what let the fan
# logic and the display disagree about what "current" means -- the fans have refused to run
# on anything older than this since long before there was anything on screen to compare it
# against.
#
# Not a setting: it is a property of how often the board reports, not of the site. The
# worker polls the board every couple of seconds, so a minute is roughly thirty missed
# readings -- far beyond a slow pass and well short of noticing a dead board only at dawn.
environmentStateMaxAge = 60

def getWeatherCache():
    """The last scrape and how old it is, as (payload, age in seconds).

    age is None when nothing has been scraped, for the same reason getEnvironment() reports
    it that way: never-fetched and long-stale are different problems and the caller has to
    be able to tell them apart. The payload is handed out as it was parsed -- readers
    outside this file want the station's own field names, not a translation of them.
    """
    with weatherCacheLock:
        payload = weatherCache
        stamp = weatherCacheTimestamp
    if stamp == 0.0:
        return payload, None
    return payload, time.monotonic() - stamp

def getEnvironment():
    """The last inside reading and how old it is, as ({name: value}, age in seconds).

    age is None when nothing has been read at all, which is a different thing from an old
    reading and has to stay distinguishable: a board that has never answered has no
    last-known value to caption, exactly as getRoofState() reports None rather than an age
    of zero.

    Deliberately takes no lock, the same call the fan logic already makes here and for the
    same reason: the worker writes the two values and then the timestamp, so the worst a
    read caught mid-update sees is one new value beside one that is a poll old, and both
    are far fresher than environmentStateMaxAge. A lock would put every reader on the
    worker's path to buy consistency that nothing here needs.
    """
    data = {thing: environmentLastData.get(thing)
            for thing in environmentParameterMap.values()}
    stamp = environmentLastData["timestamp"]
    if stamp == 0.0:
        return data, None
    return data, time.monotonic() - stamp

def closeEnvironmentDatabase():
    """Closes the InfluxDB write API and client, and forgets both.

    Deliberately takes no lock and must not be called under one. environmentLock guards
    the serial port, and none of this is the serial port -- while closing the write API
    flushes whatever is still batched, which is bounded by max_close_wait at five
    seconds against a database that has gone away. Holding the lock across that put a
    five second network wait inside the critical section that stopEnvironmentWorker's
    own bounded acquire has to outlast, and losing that race is what leaves the port
    claimed until the process exits.

    Each close is guarded separately: one that fails must not stop the other, since the
    whole point is to leave nothing behind. The write API goes first, because flushing it
    needs the client it belongs to.
    """
    global environmentInfluxClient, environmentWriteApi
    if environmentWriteApi is not None:
        try:
            environmentWriteApi.close()
        except Exception as e:
            logger.warning("Error closing the environment write API: {}".format(e))
        environmentWriteApi = None
    if environmentInfluxClient is not None:
        try:
            environmentInfluxClient.close()
        except Exception as e:
            logger.warning("Error closing the environment database client: {}".format(e))
        environmentInfluxClient = None

def closeEnvironmentSerial():
    """Closes the serial port and forgets it.

    The caller holds environmentLock. Closing a port another thread is reading from is
    not something to do on the off chance -- which is exactly why this half is separate
    from the database half above, and the only half that needs the lock at all.

    Without this the port stays claimed: it is opened exclusive=True, so its flock
    outlives the worker and is only released when the process exits.
    """
    global environmentSerial
    if environmentSerial is not None:
        try:
            environmentSerial.close()
        except (SerialException, OSError) as e:
            logger.warning("Error closing the environment serial port: {}".format(e))
        environmentSerial = None

def setupEnvironmentWorker(quiet=False):
    """Opens the environment serial port, and an InfluxDB client if one is configured.

    `quiet` is for the retry from inside environmentWorkerLoop. The first attempt tells
    the operator what went wrong; the retries a few seconds apart after it must not, or
    a board that is unconfigured or unplugged would fill the log and raise a UI
    notification on every single pass.
    """
    global environmentInfluxClient, environmentSerial, environmentLock, environmentWriteApi

    def report(level, msg, event=None):
        if quiet:
            logger.debug(msg)
            return
        getattr(logger, level)(msg)
        if event is not None:
            triggerEvent(event, msg)

    report("info", "Setting up environment sensor and database")

    # Everything down to the acquire below used to run under environmentLock, and none
    # of it is the board: settings reads, an InfluxDB client, a blocking log write and up
    # to four triggerEvent calls, plus the write API flush inside the old
    # closeEnvironmentResources(). environmentLock exists to say "nobody is mid-read on
    # the port", and the longer it is held for other reasons the likelier
    # stopEnvironmentWorker's bounded acquire is to expire -- which leaves the port
    # claimed until OMS exits. Same rule the roof worker keeps with DeferredLog and
    # DeferredEvents; here it is simpler to just not take the lock yet.
    closeEnvironmentDatabase()
    _db_url = s.q("weather_db_url", fallback=None)
    _db_token = s.q("weather_db_token", fallback=None)
    _db_org = s.q("weather_db_org", fallback=None)
    if _db_url not in [None, ""] and _db_token not in [None, ""] and _db_org not in [None, ""]:
        try:
            environmentInfluxClient = InfluxDBClient(
                    url = _db_url,
                    token = _db_token,
                    org = _db_org
                )
            environmentWriteApi = environmentInfluxClient.write_api(write_options=environmentWriteOptions)
        except Exception as e:
            report("error", f"Error setting up influx client: {e}", "error")
            return False
    else:
        # Not an error: the sensor is still read and the fan logic still works,
        # the readings just are not archived and the plots stay empty.
        logger.debug("No weather database configured, environment readings will not be stored")

    port = s.q("weather_environment_port", fallback=None)
    baud = baudSetting("weather_environment_baud")
    timeout = numericSetting("weather_environment_timeout", 2)
    if port is None:
        report("warning", "Environment serial port not available", "warning")
        return False
    if baud is None:
        # Separate from the port, and fatal rather than fallen back on: opening at
        # the wrong rate reads bytes that parse into plausible numbers, and those
        # numbers drive the fans.
        report("warning", "Environment baud rate is not one of the standard rates", "warning")
        return False
    report("info", "Opening serial port {}".format(port))

    # The board, and only the board. Note the two returns above no longer close the
    # serial port on their way out, where closeEnvironmentResources() used to: on both
    # paths that reach this function -- startEnvironmentWorker(), straight after a
    # stopEnvironmentWorker() that closed it, and the worker loop's retry, which only
    # runs when environmentSerial is already None -- there is no port open to close.
    if not environmentLock.acquire(timeout=environmentStopBudget()):
        report("warning", "Error acquiring environment lock")
        return False
    # Collected rather than reported in place, so that the UI event and the log write do
    # not happen while the lock is held.
    failure = None
    try:
        closeEnvironmentSerial()
        try:
            environmentSerial = Serial(port, baud, timeout=timeout, write_timeout=timeout, exclusive=True)
            environmentSerial.reset_input_buffer()
            environmentSerial.reset_output_buffer()
            if not environmentSerial.is_open:
                raise RuntimeError("Unknown error")
        except SerialException as e:
            failure = "Can not open serial port {}: {}".format(port, e)
            environmentSerial = None
    finally:
        environmentLock.release()
    if failure is not None:
        report("warning", failure, "error")
        return False
    return True

def environmentWorkerLoop(stopEvent, generation):
    """The environment worker. Its stop event and its identity are arguments, not globals.

    stopEvent is this worker's own, so a worker that stopEnvironmentWorker() signalled stays
    signalled no matter what the next one does -- startEnvironmentWorker() gives each new
    worker a fresh Event rather than clearing this one, exactly as captureStopEvent and
    roofStopEvent already do.

    generation still matters on top of that: a worker can be blocked inside
    setupEnvironmentWorker() -- which acquires environmentLock and reopens the port -- when
    it is superseded, and that call is not interruptible mid-flight. The stop event is only
    noticed on the next loop-top check, by which point the port may already be stomped; the
    generation rechecks around the call are what stop this worker from also reading a line
    that belongs to its replacement once setup returns.
    """
    global environmentInfluxClient, environmentSerial, environmentLock, environmentLastData, environmentWriteApi
    # When the board fell silent, or None while it is talking. Only ever set from this
    # thread, and deliberately a local: it describes this worker's port, and a superseded
    # worker must not leave its silence behind for the next one to act on.
    quietSince = None
    while not stopEvent.is_set():
        if generation != environmentGeneration:
            logger.warning("Environment worker {} superseded by {}, exiting".format(
                generation, environmentGeneration))
            break
        lockAcquired = False
        try:
            # The serial port is what this loop needs; InfluxDB is only where the
            # readings are archived. Requiring the client here meant that with no
            # database configured the port was reopened and then never read, so
            # environmentLastData never got a timestamp and updateFans always saw
            # stale data -- auto fan mode could never switch the fans on.
            if environmentSerial is None:
                if stopEvent.is_set():
                    # A stop is under way and has just closed the port. Re-opening it here
                    # would resurrect precisely what stopEnvironmentWorker() tore down.
                    break
                if generation != environmentGeneration:
                    # Superseded since the loop-top check, before reaching setup -- nothing
                    # has been touched yet, so exiting here is free.
                    logger.warning("Environment worker {} superseded by {}, exiting".format(
                        generation, environmentGeneration))
                    break
                # Quietly: this runs every few seconds for as long as the board is
                # missing, and the operator was already told once why.
                setupEnvironmentWorker(quiet=True)
                if generation != environmentGeneration:
                    # Superseded while setup ran. It may already have reopened the port out
                    # from under the worker that replaced this one -- that cannot be undone
                    # from here -- but reading from it next would steal a line that belonged
                    # to the replacement, so stop short of that.
                    logger.info("Environment worker superseded during setup, exiting")
                    break
                # A fresh port starts with a clean slate, whatever closed the old one.
                # Without this the silence measured against the previous port would carry
                # over and the first timeout on the new one would reopen it again.
                quietSince = None
            if environmentSerial is None:
                stopEvent.wait(numericSetting("weather_refresh", 5))
                continue
            # Derived, not a flat 10: the holders this waits out are setup opening the
            # port and a stop closing it, both of which are now bounded by the same
            # validated timeout plus its grace. It was the last hardcoded lock budget
            # left after the roof's and the stop path's were derived, and at 10 it was
            # twice the longest hold it could ever be waiting for.
            if not environmentLock.acquire(timeout=environmentStopBudget()):
                logger.warning("Error acquiring environment lock")
                continue
            lockAcquired = True
            try:
                line = environmentSerial.readline().decode("ascii").rstrip()
            except (SerialException, OSError) as e:
                logger.warning(f"Error reading from serial port: {e}. Resetting port")
                try:
                    environmentSerial.close()
                except (SerialException, OSError):
                    pass
                environmentSerial = None
                continue
            if len(line) == 0:
                # A timeout, not a disconnect: pyserial raises SerialException when the
                # port reports readable and then yields nothing, so an empty line here
                # means the board said nothing for weather_environment_timeout seconds.
                #
                # Nothing else in this loop ever reopens a port that stays open, and that
                # is how one quiet spell used to become a permanent one -- this warning
                # once per timeout for hours, no readings stored, and updateFans switching
                # the fans off on data over a minute old. The restart that fixed it fixed
                # it by reopening the port, which is all this does, only sooner.
                #
                # The reopen resets the board as well, which is deliberate. Opening the
                # port asserts DTR, which the Nano's USB-serial bridge drives low, and the
                # capacitor to RESET turns that falling edge into a reset pulse -- the same
                # auto-reset the Arduino IDE uses to enter the bootloader. So this recovers
                # a board that has hung, not only a serial port that has gone stale. It
                # also means a restart curing the symptom never proved the Pi side was at
                # fault: the restart reset the board too.
                if quietSince is None:
                    quietSince = time.monotonic()
                    logger.warning("Got empty data from environment board")
                elif time.monotonic() - quietSince > environmentSilenceTimeout:
                    logger.warning(
                            "No data from the environment board for over {}s, "
                            "reopening the serial port".format(environmentSilenceTimeout))
                    try:
                        environmentSerial.close()
                    except (SerialException, OSError) as e:
                        logger.warning("Error closing the environment serial port: {}".format(e))
                    environmentSerial = None
                else:
                    # Once is worth a warning, the rest of a quiet spell is not: at one
                    # line per timeout this used to be the only thing in the log.
                    logger.debug("Got empty data from environment board")
                continue
            # Any line at all means the link is alive, LOG: lines included -- they are what
            # the board sends between measurements.
            quietSince = None
            if line.startswith("LOG:"):
                continue
            thing = next((t for t in environmentParameterMap if line.startswith(t)), None)
            if thing is None:
                logger.warning(f"Uknown message from environment sensor: {line}")
                continue
            result =  parse(thing + ": {}", line)
            if result is None:
                logger.warning(f"Could not parse message {line}")
                continue
            key = environmentParameterMap[thing]
            value = float(result[0])
            if generation != environmentGeneration:
                # Superseded while this line was being read. The reading itself is fine --
                # same board, same value -- but the timestamp that goes with it is what
                # updateFans judges freshness by, and this worker is no longer the one
                # whose freshness that represents.
                logger.info("Environment worker superseded mid-read, discarding the reading")
                break
            environmentLastData[key] = value
            environmentLastData["timestamp"] = time.monotonic()
            # Released before the write, not after. environmentLock guards the serial
            # port, and an Influx append is not a serial operation -- holding it here put
            # a network client inside the critical section that stopEnvironmentWorker's
            # close has to wait out, and that wait is what decides whether the port is
            # ever released.
            environmentLock.release()
            lockAcquired = False
            if environmentWriteApi is not None:
                p = Point("weather").field(key, value)
                environmentWriteApi.write(bucket=s.q("weather_db_bucket", fallback=None), org=s.q("weather_db_org", fallback=None), record=p)
        except Exception as e:
            logger.warning(f"Error in environment loop: {e}")
            stopEvent.wait(numericSetting("weather_refresh", 5))
        finally:
            if lockAcquired:
                environmentLock.release()

def stopEnvironmentWorker():
    """Stops the worker and closes what it was holding.

    The closing is the point. Without it the serial port stays claimed -- it is opened
    exclusive=True, so the flock outlives the worker and is only released when the process
    exits -- and up to batch_size points, or a flush_interval worth of readings, are lost
    rather than written. setupEnvironmentWorker() has always done this on its way to
    rebuilding them; the shutdown path never did.
    """
    global environmentThread, environmentStopEvent, environmentGeneration
    # Before the join, not after: from here on any worker still running is superseded,
    # whether it manages to stop or not, and must not touch environmentLastData again.
    environmentGeneration += 1
    if environmentThread is not None and environmentThread.is_alive():
        logger.info("Stopping environment thread")
        environmentStopEvent.set()
        environmentThread.join(timeout=environmentStopBudget())
        if environmentThread.is_alive():
            logger.warning("Environment thread still alive")
        else:
            logger.info("Environment thread stopped")
    # Cleared either way: a thread that outlived its join is not something anything should
    # go on to join or signal again.
    environmentThread = None
    # The database first and without the lock: it is not the board, and closing the write
    # API flushes whatever is batched, which against an unreachable InfluxDB costs the
    # full max_close_wait. Holding environmentLock across that only made the acquire below
    # -- the one that decides whether the port is ever released -- more likely to expire.
    closeEnvironmentDatabase()
    # The worker can still be inside readline() if that join expired, and closing a port
    # out from under a thread that is reading it invites an obscure crash. The lock decides:
    # holding it means nobody is mid-read. If it cannot be had, say so plainly and leave
    # the port alone rather than forcing it.
    if not environmentLock.acquire(timeout=environmentStopBudget()):
        logger.error(
                "Could not acquire the environment lock to close the serial port; "
                "it stays claimed until OMS exits")
        return
    try:
        closeEnvironmentSerial()
    finally:
        environmentLock.release()

def startEnvironmentWorker():
    """Starts the environment worker, whether or not the board is there yet.

    The thread starts even when the first setup fails, because the loop retries setup on
    every pass: a board that is unconfigured or unplugged at boot then comes back on its
    own once it appears. Returning early here used to leave no thread at all, and the only
    other caller is a settings save, so nothing retried until the operator saved
    something. setupEnvironmentWorker() has already reported the specific reason to the
    UI, so this only notes the consequence -- and it is no longer fatal, hence a warning.
    """
    global environmentThread, environmentStopEvent
    stopEnvironmentWorker()
    # A fresh event per worker, handed over as an argument, rather than clearing the shared
    # one -- exactly as startCaptureLoop() and makeRoof() do it. A previous worker that
    # stopEnvironmentWorker() signalled but could not join is still waiting on *its* event;
    # clearing that same object here used to un-signal it, so the orphan resumed and could
    # reopen the port the stop had just closed.
    workerStopEvent = threading.Event()
    environmentStopEvent = workerStopEvent
    logger.info("Starting environment loop")
    if not setupEnvironmentWorker():
        logger.warning("Could not set up environment board, the worker will keep retrying")
    # stopEnvironmentWorker() bumped the generation above, so this worker takes the current
    # value and every older one is already superseded.
    environmentThread = threading.Thread(
            target = environmentWorkerLoop,
            args = (workerStopEvent, environmentGeneration),
            daemon = True,
            name = "Environment worker"
            )
    environmentThread.start()
    logger.info("Environment loop started")

async def queryWeather(api, thing, start, window):
    bucket = s.q("weather_db_bucket", fallback="weather") or "weather"
    query = """from(bucket: "{}")
      |> range(start: -{})
      |> filter(fn: (r) => r["_measurement"] == "weather")
      |> filter(fn: (r) => r["_field"] == "{}")
      |> aggregateWindow(every: {}, fn: mean, createEmpty: false)
      |> yield(name: "mean")""".format(bucket, start, thing, window)
    logger.debug("Querying weather: " + query)

    result = await api.query(org=s.q("weather_db_org"), query=query)
    vals = result.to_values()
    times = []
    values = []
    for ii in range(len(vals)):
        times.append(list(vals[ii])[4])
        values.append(list(vals[ii])[5])
    return times, values


async def queryState(api, fields, start, window):
    """Several fields of the "oms" measurement at once, as {field: (times, values)}.

    Its own function rather than a flag on queryWeather(), because the two differ in both
    halves. A different measurement, and last() rather than mean(): a state is not a
    quantity, the mean of "closed" and "opening" is not a thing, and last() is what keeps
    a value a value. createEmpty stays false for the same reason it is false there -- a
    window with no point in it is a gap, not a zero.

    All the fields of one plot in a single query, unlike queryWeather()'s one call per
    field. There are twenty-five of these against the weather's fifteen, and a pass over
    24h is already a few seconds of work on the Pi; asking for them one at a time would
    have roughly tripled a pass to draw four more figures.

    Read through the record API rather than to_values()' positional columns, because this
    needs the field name to sort the rows into series and that is what the column is for.
    """
    bucket = s.q("weather_db_bucket", fallback="weather") or "weather"
    query = """from(bucket: "{}")
      |> range(start: -{})
      |> filter(fn: (r) => r["_measurement"] == "oms")
      |> filter(fn: (r) => contains(value: r["_field"], set: [{}]))
      |> aggregateWindow(every: {}, fn: last, createEmpty: false)
      |> yield(name: "last")""".format(
              bucket, start, ", ".join('"{}"'.format(f) for f in fields), window)
    logger.debug("Querying state: " + query)

    series = {field: ([], []) for field in fields}
    for table in await api.query(org=s.q("weather_db_org"), query=query):
        for record in table.records:
            entry = series.get(record.get_field())
            if entry is None:
                # A field the query did not ask for cannot appear, but a bucket holding an
                # older schema can still answer with one this version does not know.
                continue
            entry[0].append(record.get_time())
            entry[1].append(record.get_value())
    return series


updateQueue = asyncio.Queue()
updateCallbacks: dict[str, callable] = {}
def triggerEvent(*args):
    global mainLoop
    mainLoop.call_soon_threadsafe(updateQueue.put_nowait, list(args))


async def updateWorker():
    while True:
        thing = await updateQueue.get()
        logger.debug("update worker got event {}".format(thing))
        for clientId, client in list(Client.instances.items()):
            # Bound here rather than looked up again inside dispatch(): the coroutine runs
            # later, and a client disconnecting in between takes its entry out of
            # updateCallbacks. The lookup then raised KeyError -- logged as a bare client
            # id, since that is all a KeyError carries.
            callback = updateCallbacks.get(clientId)
            if callback is None:
                continue
            async def dispatch(cid=clientId, c=client, t=thing, cb=callback):
                if cid not in updateCallbacks:
                    logger.debug("Client {} left before its callback ran".format(cid))
                    return
                try:
                    with c:
                        await cb(t)
                except Exception as e:
                    logger.warning("Error running callback on client {}:\n{}".format(cid, e))
            logger.debug("Dispatching event for client {}: {}".format(clientId, thing))
            spawn(dispatch())

def pinUsedForRoof(pin: int):
    """Whether `pin` is one of the four roof motion pins.

    Goes through readRoofConfig() rather than parsing the settings a second time, so an
    unusable roof configuration is reported in one place and fails closed here. Parsing
    inline used to raise TypeError out of initSwitches() -- and out of initStuff() with
    it -- for a roof pin that had been cleared in the settings dialog.

    No usable configuration means no Roof instance, so nothing is driving those pins and
    there is nothing to protect a switch from.
    """
    config = readRoofConfig()
    if config is None:
        return False
    return pin in [
            config["pinWestOpen"],
            config["pinWestClose"],
            config["pinEastOpen"],
            config["pinEastClose"]
            ]


switch_names = ["pier", "cctv", "pc", "allsky"]
switches = {}

def getSwitchState(name: str):
    # One lookup, not a membership test followed by a subscript. The worker threads call
    # this while initSwitches() is rebuilding `switches` on the event loop, and that rebuild
    # deletes entries (`del switches[other]` when a pin changes hands); a save landing
    # between the two statements used to raise KeyError on the calling thread.
    entry = switches.get(name)
    if entry is None:
        return switch.State.UNKN
    return entry["switch"].state

def switchConfigured(name: str):
    """Whether `name` has a pin set up, and can therefore be commanded.

    Deliberately not deviceUnavailableReason(), which answers a different question and is
    the wrong one here: that reports whether the *device* on the other end can be used, and
    a switch which is merely off counts as unavailable there. Commanding is about the
    switch, and a switch that is off is precisely the one a caller most wants to command.

    One lookup rather than a membership test and a subscript, for the same reason
    getSwitchState() does it that way: initSwitches() deletes entries as it rebuilds, on
    the event loop, while worker threads and API handlers are reading.
    """
    return switches.get(name) is not None

def deviceUnavailableReason(name: str, label: str):
    """Why the device powered by the switch `name` cannot be used, or None if it can.

    A device whose switch is not configured counts as unavailable: OMS can neither power
    it nor find out whether anything else did, so talking to it can only end in a
    timeout.
    """
    # Also one lookup rather than two, so that a switch disappearing mid-call cannot make
    # this report a state it read from an entry the membership test no longer covers.
    entry = switches.get(name)
    if entry is None:
        return "{} is not configured".format(label)
    state = entry["switch"].state
    if state is switch.State.ON:
        return None
    if state is switch.State.OFF:
        return "{} is switched off".format(label)
    return "{} is in an unknown state".format(label)

def cctvUnavailableReason():
    """Why no CCTV frame can be grabbed, or None if one can."""
    if s.q("stream_rtsp", fallback="") in (None, ""):
        return "No RTSP stream is configured"
    return deviceUnavailableReason("cctv", "CCTV camera")

def allskyUnavailableReason():
    """Why the allsky camera cannot be reached, or None if it can."""
    return deviceUnavailableReason("allsky", "Allsky camera")

def allskyImageUnavailableReason():
    """Why no allsky image can be shown, or None if one can."""
    reason = allskyUnavailableReason()
    if reason is not None:
        return reason
    if s.q("weather_image", fallback="") in (None, ""):
        return "No allsky image URL is configured"
    return None

def weatherUnavailableReason():
    """Why no weather data can be fetched, or None if it can.

    The weather station hangs off the allsky camera and is only reachable while that
    camera is powered, so switching the allsky off takes the weather data with it.
    """
    reason = allskyUnavailableReason()
    if reason is not None:
        return reason
    if s.q("weather_url", fallback="") in (None, ""):
        return "No weather URL is configured"
    return None

def initSwitch(name: str, pin: int, init: str, last: str):
    if init == "on":
        initState = switch.State.ON
    elif init == "last":
        initState = switch.State.ON if last == "on" else switch.State.OFF
    else:
        if init != "off":
            logger.warning("Unknown init value {} for switch {}, defaulting to off".format(init, name))
        initState = switch.State.OFF
    if name in switches:
        if switches[name]["switch"].pin == pin:
            switches[name]["init"] = init
            return
        del switches[name]

    switches[name] = {
            "switch": switch.Switch(pin, init=initState),
            "init": init
            }

def initSwitches():
    """Registers a Switch for every configured switch pin.

    Each switch is set up independently: an unusable pin -- non-numeric, or one GPIO
    refuses -- must cost only that one switch. Letting it propagate used to abandon the
    remaining switches and take initStuff() down with them.

    Every pin is collected before any of them is driven, because two switches sharing one
    pin means two devices wired to one relay: switching either would switch the other, and
    the second would report a state it does not control. The first name in switch_names
    wins a contested pin and the other is refused and reported.
    """
    wanted = {}
    for name in switch_names:
        try:
            pin = s.q(name + "_pin", fallback=None)
            init = s.q(name + "_init", fallback=None)
            last = s.q(name + "_last", fallback=None)
            if pin is None:
                logger.warning("Pin for {} is not set up in settings, skipping".format(name))
                continue
            pin = int(pin)
            if pinUsedForRoof(pin):
                logger.warning("Switch for {} with pin {} is already in use for roof, removing".format(name, pin))
                s.rm(name + "_pin")
                s.rm(name + "_init")
                s.rm(name + "_last")
                continue
            claimed = next((other for other, wish in wanted.items() if wish[0] == pin), None)
            if claimed is not None:
                # Refused rather than resolved: there is no way to guess which device is
                # really on the pin, and the settings are left alone so the operator can
                # see what they entered and correct it.
                msg = "Switch for {} cannot use pin {}, {} is already using it".format(name, pin, claimed)
                logger.error(msg)
                triggerEvent("error", msg)
                continue
            wanted[name] = (pin, init, last)
        except Exception as e:
            msg = "Error setting up switch {}: {}".format(name, e)
            logger.error(msg)
            triggerEvent("error", msg)
    # A pin a switch is taking over can still be held by a registration from an earlier
    # pass, because the operator moved it from one device to another. Release the previous
    # holder before anything is driven, otherwise both would end up registered on the one
    # pin. The GPIO level is deliberately left as it is -- that is what disconnecting a
    # switch has always done.
    for name, (pin, _, _) in wanted.items():
        for other in [o for o in switches if o != name and switches[o]["switch"].pin == pin]:
            logger.info("Releasing pin {} from {}, {} takes it over".format(pin, other, name))
            del switches[other]
    for name, (pin, init, last) in wanted.items():
        try:
            initSwitch(name, pin, init, last)
        except Exception as e:
            msg = "Error setting up switch {}: {}".format(name, e)
            logger.error(msg)
            triggerEvent("error", msg)

setSwitchStateLock = threading.Lock()
def setSwitchState(name: str, state: switch.State):
    with setSwitchStateLock:
        stateString = switch.State.toString(state)
        logger.info(f"Setting switch {name} to {stateString}")
        try:
            switches[name]["switch"].setState(state)
        except Exception as e:
            logger.error(f"Error setting switch {name} to {stateString}: {e}")
            triggerEvent("switchError", name, str(e))
            return
        s.p(name + "_last", stateString)
        triggerEvent("setSwitchState", name, stateString)

weatherThread = None
# The current weather worker's stop event, and its identity. Both work exactly as
# captureStopEvent/captureGeneration do, and for the same reason: a worker whose join expired
# used to be revived by the next start clearing the shared event, and then two workers wrote
# weatherCache, its timestamp, and drove updateFans() between them.
weatherStopEvent = threading.Event()
weatherGeneration = 0

# On top of the scrape: parsing the payload, and the fan decision the worker makes right
# after it -- which posts to a mailbox and never blocks on the roof, so it is small.
weatherStopGrace = 3

def weatherStopBudget():
    """How long stopWeatherWorker() waits for its worker.

    Derived from apiv1.WEATHER_HTTP_TIMEOUT rather than restating a number: the worker
    spends its pass inside that request, and requests applies its timeout per phase, so a
    station that accepts the connection and then says nothing costs twice it. A flat 5s
    was shorter than a single phase, so the join expired on every settings save whenever
    the station was slow.

    DNS is not covered by the requests timeout at all, so this can still be overrun; that
    is what the generation check is for.
    """
    return 2 * apiv1.WEATHER_HTTP_TIMEOUT + weatherStopGrace

weatherCacheLock = threading.Lock()
weatherCache = None
# time.monotonic(); 0.0 means nothing is cached. See environmentLastData["timestamp"].
weatherCacheTimestamp = 0.0
# time.monotonic() of when the worker last found the station reachable again, or 0.0
# while it is not reachable. Read by weatherWarmingUp().
weatherAvailableSince = 0.0

def weatherWarmingUp():
    """Is the station reachable but yet to produce its first reading?

    Powering the allsky back on does not bring the weather data back with it: the worker
    takes up to a refresh period to notice, and then the fetch takes as long as the
    station needs to answer. Nothing is wrong for that stretch, so the labels should read
    as absent rather than as an error -- the same as while the camera is off.
    """
    if weatherThread is None or not weatherThread.is_alive():
        # Nobody is fetching, so waiting is not going to produce a reading. That is a
        # fault worth showing as one.
        return False
    with weatherCacheLock:
        if weatherCache is not None:
            return False        # a reading has landed; its age decides from here on
        since = weatherAvailableSince
    if since == 0.0:
        return True             # the worker has not looked since the station came back
    return (time.monotonic() - since) <= numericSetting("weather_refresh", 5) * 3

def weatherWorkerLoop(stopEvent, generation):
    """The weather worker. Same worker-identity contract as captureLoop.

    The pass is split into "find out" and "act on it", with the generation checked in
    between, because finding out is the slow half: a scrape can take the whole HTTP timeout,
    which is ample time for this worker to be retired. Acting on a stale identity is the part
    that matters -- the reading itself would be fine, but the timestamp that goes with it is
    what updateFans() and the labels judge freshness by, and a retired worker refreshing it
    makes stale data look current. The fan decision is worse still: it would drive the roof
    on behalf of a worker that no longer exists.
    """
    global weatherCache, weatherCacheTimestamp, weatherAvailableSince
    while not stopEvent.is_set():
        if generation != weatherGeneration:
            logger.warning("Weather worker {} superseded by {}, exiting".format(
                generation, weatherGeneration))
            break
        try:
            reason = weatherUnavailableReason()
            data = None
            if reason is None:
                with weatherCacheLock:
                    if weatherAvailableSince == 0.0:
                        weatherAvailableSince = time.monotonic()
                try:
                    data = getWeather()
                except Exception as e:
                    # Left as None: the cache keeps whatever it had and ages out on its own,
                    # which is how every reader already judges it.
                    logger.warning(f"Error fetching weather data: {e}")
            else:
                # Asking anyway would spend the full HTTP timeout finding out what we
                # already know.
                logger.debug(f"Not fetching weather data: {reason}")

            if generation != weatherGeneration:
                logger.info("Weather worker superseded mid-pass, discarding the result")
                break

            if reason is not None:
                # Drop the cache so every reader -- the UI and the fan decision below --
                # sees the data as gone rather than merely stale.
                with weatherCacheLock:
                    weatherCache = None
                    weatherCacheTimestamp = 0.0
                    weatherAvailableSince = 0.0
            elif data is not None:
                with weatherCacheLock:
                    weatherCache = data
                    weatherCacheTimestamp = time.monotonic()
            # Both roof decisions that turn on the weather are driven from here (rather
            # than from roofLoop) so that the network call above never delays the roof
            # status poll loop.
            #
            # The rain interlock goes first, being the one of the two that can need the roof
            # itself to move. Neither depends on the other having run: both read the state
            # the roof worker published rather than anything the other leaves behind, and
            # the fans are switched off by updateFans() on the strength of a roof that is
            # not shut, whoever it was that started it moving.
            enforceRainInterlock()
            updateFans()
        except Exception as e:
            logger.error(f"Error in weather loop: {e}")
        finally:
            # This worker's own event. Already set for a worker that is on its way out, so
            # the break above is not delayed by a refresh period.
            stopEvent.wait(numericSetting("weather_refresh", 5))

def stopWeatherWorker():
    global weatherThread, weatherGeneration
    # Before the join, for the reason stopCaptureLoop states.
    weatherGeneration += 1
    if weatherThread is not None and weatherThread.is_alive():
        logger.info("Stopping weather thread")
        weatherStopEvent.set()
        budget = weatherStopBudget()
        weatherThread.join(timeout=budget)
        if weatherThread.is_alive():
            logger.warning(
                    "Weather worker did not stop within {:.1f}s and was abandoned. It is "
                    "superseded and will publish nothing more; it exits by itself once the "
                    "scrape it is stuck in times out".format(budget))
        else:
            logger.info("Weather thread stopped")
    # Cleared either way, as in stopCaptureLoop. Note what this costs: weatherWarmingUp()
    # reads weatherThread, so between here and the next start it reports no worker running
    # and the labels read as an error rather than as warming up. That is the honest answer
    # for the moment when nothing is fetching, and the window is a few statements long.
    weatherThread = None

def startWeatherWorker():
    global weatherThread, weatherStopEvent
    stopWeatherWorker()
    logger.info("Starting weather loop")
    # A fresh event per worker rather than clearing a shared one -- see startCaptureLoop.
    workerStopEvent = threading.Event()
    weatherStopEvent = workerStopEvent
    weatherThread = threading.Thread(
            target = weatherWorkerLoop,
            args = (workerStopEvent, weatherGeneration),
            daemon = True,
            name = "Weather worker"
            )
    weatherThread.start()
    logger.info("Weather loop started")

class DeferredLog:
    """Collects log records so they can be emitted after a lock has been released.

    Emitting a record writes synchronously to the handler, so logging while holding
    roofLock lets a slow handler (journald, a busy SD card) extend the hold for as
    long as that write takes -- on top of whatever the lock was actually taken for.
    """
    def __init__(self):
        self._records = []

    def __call__(self, level, msg):
        self._records.append((level, msg))

    def flush(self):
        for level, msg in self._records:
            logger.log(level, msg)
        self._records.clear()

class DeferredEvents:
    """Collects UI events so they can be raised after a lock has been released.

    Same reasoning as DeferredLog: triggerEvent() is cheap but not free, and none of
    it needs to happen while roofLock is held.
    """
    def __init__(self):
        self._events = []

    def __call__(self, *args):
        self._events.append(args)

    def flush(self):
        for args in self._events:
            triggerEvent(*args)
        self._events.clear()

# Written by the roof worker after it actually switches the fans, read by the auto
# mode to rate-limit itself. One writer, one reader, and a float rebind is atomic
# under the GIL, so there is nothing here for a lock to protect.
# time.monotonic(); 0.0 means the fans have not been switched since startup.
lastFanChange = 0.0
def updateFans():
    """Decides whether the fans should be running and asks the worker to change them.

    Touches neither the serial port nor roofLock: the roof state comes from what the
    worker published on its last poll, and every change goes into the command mailbox
    for the worker to carry out. Runs on the weather thread, so it must never block on
    the roof. Both facts it needs -- whether the roof is shut and whether the fans are
    running -- come from the same snapshot, so they cannot disagree.
    """
    if roofUnavailableReason() is not None:
        return
    if s.q("fan_mode", fallback="off") != "auto":
        return
    logger.debug("Fans in auto mode")
    status, stateAge = getRoofState()
    if status is None or stateAge > roofStateMaxAge:
        logger.debug("No recent roof state available, skipping fan update")
        return
    try:
        fansAreOn = roof.Roof.get().fansAreOn(status=status)
        fullyClosed = roof.Roof.get().isFullyClosed(status=status)
    except Exception as e:
        logger.warning(f"Error reading roof state, skipping fan update: {e}")
        return

    if not fullyClosed:
        if fansAreOn:
            logger.info("Roof not closed but fans are on, switching off")
            setFans("off", auto=True)
        return

    # purposfully ignoring the environment lock here. If caught mid update shouldn't be a problem
    dt = time.monotonic() - environmentLastData["timestamp"]
    H = environmentLastData["inside_humidity"]
    T = environmentLastData["inside_temperature"]
    if dt > environmentStateMaxAge:
        if fansAreOn:
            logger.warning("Environment data older than {}s, switching fan off".format(
                environmentStateMaxAge))
            setFans("off", auto=True)
        return
    if H is None or T is None or math.isnan(H) or math.isnan(T):
        return
    logger.debug(f"Environment data available: {environmentLastData}")

    delay = numericSetting("roof_fan_change_delay", 60)
    if time.monotonic() - lastFanChange < delay:
        logger.debug("Last change not too far in the past, skipping this one")
        return

    with weatherCacheLock:
        weather = weatherCache
        weatherAge = time.monotonic() - weatherCacheTimestamp
    weatherMaxAge = numericSetting("weather_refresh", 5) * 3
    if weather is None or weatherAge > weatherMaxAge:
        logger.debug("No recent weather data available, skipping fan update")
        return
    T_outside = asNumber(weather.get("env_temperature"))
    H_outside = asNumber(weather.get("env_humidity"))
    if T_outside is None or H_outside is None:
        # A sensor the station could not read this cycle. Not an OMS fault, and the next
        # poll usually has it back, so the fans simply keep their current state.
        logger.debug("Weather has no usable temperature or humidity, skipping fan update")
        return
    logger.debug(f"Weather data available: {weather}")
    tmin = numericSetting("roof_fan_temp_min", 5)
    humidityBand = numericSetting("roof_fan_humidity_deadband", 5)
    tempBand = numericSetting("roof_fan_temp_deadband", 2)
    # Inside either dead band, that factor does not argue for a state either way -- it
    # keeps whatever the fans are already doing rather than flip on a difference too
    # small to matter. Only a crossing past the band flips it, which is what stops the
    # last bit of flapping right at the threshold.
    humidityDiff = H - H_outside
    if abs(humidityDiff) > humidityBand:
        humidityWantsOn = humidityDiff > 0
    else:
        humidityWantsOn = fansAreOn
    tempDiff = T_outside - tmin
    if abs(tempDiff) > tempBand:
        tempAllowsOn = tempDiff > 0
    else:
        tempAllowsOn = fansAreOn
    fansShouldBeOn = humidityWantsOn and tempAllowsOn
    if fansShouldBeOn == fansAreOn:
        logger.debug("Fan state already as requested")
        return
    mode = "on" if fansShouldBeOn else "off"
    logger.info(f"Switching fans {mode} in auto mode (Humidity {H} vs {H_outside}, temperature {T} vs {T_outside})")
    setFans(mode, auto=True)



def checkRoofPins():
    if not s.has("roof_pins_west_close") or s.q("roof_pins_west_close") == "":
        return False
    if not s.has("roof_pins_west_open") or s.q("roof_pins_west_open") == "":
        return False
    if not s.has("roof_pins_east_close") or s.q("roof_pins_east_close") == "":
        return False
    if not s.has("roof_pins_east_open") or s.q("roof_pins_east_open") == "":
        return False
    if not s.has("roof_port") or s.q("roof_port") == "":
        return False
    return True

def readRoofConfig():
    """Reads and validates the roof settings. Touches no hardware, needs no lock.

    Returns Roof's constructor arguments, or None if the roof is not configured or the
    configuration cannot be used. The parsing is guarded because checkRoofPins() only
    establishes that the settings are present and non-empty, not that the pins are
    numeric -- a hand-edited value has to fail here rather than escaping makeRoof().
    """
    if not checkRoofPins():
        return None
    baud = baudSetting("roof_baud")
    if baud is None:
        if s.q("roof_baud", fallback=None) not in (None, ""):
            # Set to something outside the standard rates. Fatal, and deliberately not
            # fallen back on: a wrong rate does not fail, it returns limit-switch states
            # that were never sent. baudSetting() has already reported which value.
            logger.error("Roof baud rate is not one of the standard rates, roof unusable")
            return None
        # Never set at all, which is a different thing from set wrongly. This has always
        # read as 9600, it is the rate in roof/roof.ino, and it is the only rate this
        # board has ever been spoken to at -- so an installation that never filled the
        # field in keeps its roof rather than losing it to a validation change.
        baud = 9600
    try:
        config = {
                "pinWestOpen": int(s.q("roof_pins_west_open")),
                "pinWestClose": int(s.q("roof_pins_west_close")),
                "pinEastOpen": int(s.q("roof_pins_east_open")),
                "pinEastClose": int(s.q("roof_pins_east_close")),
                "port": s.q("roof_port"),
                "baud": baud,
                # Falls back rather than refusing, unlike the baud above. A roof that
                # answers on a different schedule is still a roof, and rejecting the
                # whole configuration over a timeout would take the dome away -- and,
                # through pinUsedForRoof(), stop protecting the four motion pins as well.
                "timeout": numericSetting("roof_timeout", 0.2),
                }
    except Exception as e:
        logger.error("Roof configuration is not usable: {}".format(e))
        return None
    # A motor pin outside the header's range cannot be driven at all, so this is fatal in
    # the way the timeout is not. It already failed, later and less clearly, when
    # roof.Roof() handed the number to RPi.GPIO.
    #
    # Two of them on one pin is one contactor answering to two commands, and neither
    # protection that exists covers it: initSwitches() refuses a contested pin but only
    # among the device switches, and pinUsedForRoof() asks whether a pin is one of these
    # four, which a duplicate inside the four passes. Nothing downstream notices either --
    # drive()'s interlock is computed from Roof.__driving, which a shared pin desynchronizes
    # from the hardware by construction. Fatal for the same reason the range is: there is no
    # way to guess which relay the operator meant, and refusing is what initSwitches()
    # already does with a pin two switches want.
    floor, ceiling = settingBounds["roof_pins_west_open"]
    seen = {}
    for key in ("pinWestOpen", "pinWestClose", "pinEastOpen", "pinEastClose"):
        if not floor <= config[key] <= ceiling:
            logger.error("Roof {} is {}, outside the usable GPIO range {} to {}".format(
                key, config[key], floor, ceiling))
            return None
        if config[key] in seen:
            logger.error("Roof {} and {} are both pin {}; each motion relay needs its own "
                "pin, roof unusable".format(seen[config[key]], key, config[key]))
            return None
        seen[config[key]] = key
    return config

class OwnerTrackingLock:
    def __init__(self):
        self._lock = threading.Lock()
        self._owner = None

    def acquire(self, timeout=-1):
        if self._owner == threading.current_thread():
            raise RuntimeError("roofLock reentrant acquisition detected on the same thread")
        acquired = self._lock.acquire(timeout=timeout)
        if acquired:
            self._owner = threading.current_thread()
        return acquired

    def release(self):
        self._owner = None
        self._lock.release()

    def __enter__(self):
        # Bounded, and loud when it expires. An unbounded acquire would hang the calling
        # thread for as long as the holder stays wedged, with nothing in the log to say
        # why -- every explicit acquire() call site already passes roofStopBudget() and
        # reports the timeout, so `with roofLock:` must not be the one path that does not.
        if not self.acquire(timeout=roofStopBudget()):
            raise TimeoutError("Timeout acquiring roofLock")
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        self.release()

roofLock = OwnerTrackingLock()
# Only the roof worker and the makeRoof()/stopRoof() lifecycle take this lock now, and
# the lifecycle paths join the worker first, so it is contended only in the window
# where that join timed out.
#
roofStopGrace = 3

# The most serial exchanges one serviceRoofOnce() can make inside a single roofLock hold.
# Named and enumerated rather than written into roofStopBudget() as a literal, so that
# adding a serial call to the tick has one obvious place to be accounted for -- the job
# Roof.WRITE_RETRIES already does for the retry count. It carried the value 2 for a long
# time after it had stopped being true, describing a tick that only ever polled the status
# and switched the fans; the motion machine added the rest and nothing pointed back here.
#
# Where the five come from, in the order serviceRoofOnce() makes them:
#   1  the status poll
#   2  retractRoofRods(), which is one exchange per half and there are two rods
#   1  a fan command taken from the mailbox
#   1  the motion machine's own: extendRod() in OPEN_KICK, or retractRod() in
#      CLOSE_RODCLEAR. Never both -- they are different phases, and the "already there"
#      short-circuit returns before any phase body runs.
#
# The count has to be a fixed number rather than a worst case over branches, which is why
# the rods have exactly one call site per tick: while a stop retracted them and the "rods"
# handler could retract them again, the ceiling was 5 on a good tick and 7 on one where the
# first attempt failed -- and that is precisely the tick where every exchange also costs its
# full timeout, so the number was largest exactly when it was least trustworthy.
roofMaxExchangesPerTick = 5

# The blocking calls one writeCmd() attempt makes, each separately bounded by roof_timeout:
# __transact() writes and then reads, and readRoofConfig() hands the one setting to pyserial
# as both `timeout` and `write_timeout` (roof.py). So an attempt's worst case is twice the
# setting, not once it, and an exchange's is four times.
#
# Named rather than written in as a 2, for exactly the reason roofMaxExchangesPerTick is: it
# was an unwritten 1 for a long time, nothing pointed at the assumption, and the write half
# of every attempt went uncharged.
#
# The expensive path is not the one it looks like. A write that *raises* is the cheap case --
# writeCmd() catches it, disconnects, and the next attempt goes through connect(), whose
# reset_output_buffer() flushes the stuck queue so the retry writes straight through. A write
# that is merely slow and then succeeds leaves a short read instead, which does not
# disconnect, so the retry reuses the same port and pays the same stall a second time.
roofTimeoutsPerAttempt = 2

def roofStopBudget():
    """The longest one roofLock hold can run, and so how long to wait for it.

    Derived rather than hardcoded for the same reason environmentStopBudget() and
    captureStopBudget() are: the flat 5s this used to be was sized against a 0.2s default
    and only had a ~1s margin over the measured 4.00s hold at roof_timeout=2 -- a second
    retry, a higher ceiling, or a real (non-pty) wedged bridge converts that silently into
    abandoned workers and "fans and motion may still be on" at shutdown.

    Being too short does not merely make a wait shorter, it changes the outcome: stopRoof()
    uses this as its worker join timeout and then as its lock timeout, so a budget under the
    real hold abandons a worker that was working fine, reports "the serial port is most
    likely wedged" when it is not, and leaves makeRoof() unable to bring the roof back until
    the next successful save.

    Three terms, and each one had to be found the hard way. How many exchanges a tick makes
    (roofMaxExchangesPerTick, which carried 2 long after the motion machine made it 5), how
    many attempts an exchange makes (Roof.WRITE_RETRIES), and how many timeouts an attempt
    can spend (roofTimeoutsPerAttempt, which was an unwritten 1 while pyserial was being
    handed the setting as both the read and the write bound). Getting any of them wrong is
    the same bug, and it is silent every time: the budget stays plausible and only the
    outcome changes.
    """
    attempts = roof.Roof.WRITE_RETRIES + 1
    return (roofMaxExchangesPerTick * attempts * roofTimeoutsPerAttempt
            * numericSetting("roof_timeout", 0.2) + roofStopGrace)
roofThread = None
# The current roof worker's stop event, and only that. makeRoof() replaces it for each new
# worker rather than clearing it, and the worker itself holds its own reference, so
# signalling one worker can never be undone on behalf of another.
roofStopEvent = threading.Event()
# Bumped by stopRoof() whenever a worker is retired. Each worker carries the value it was
# started with and goes silent as soon as it no longer matches: a worker whose join timed
# out can still be in the middle of a serial read while its replacement is already running,
# and two threads writing lastRoofState is precisely what the published-state design cannot
# survive. Bumped in stopRoof() rather than makeRoof() so that a makeRoof() which then
# fails -- unusable config, a port that will not open -- still leaves the old worker
# superseded instead of publishing for a roof that has been reset. Read without a lock: an
# int read is atomic under the GIL, and the check only has to be eventually right.
roofGeneration = 0
# Workers that outlived their join. Being superseded they can no longer publish or act, but
# they still hold a thread and, for as long as they are stuck in a serial read, roofLock --
# which is exactly why the count is worth reporting. It is the visible symptom of a wedged
# USB bridge, and the reason a rebuilt roof may fail to take the lock.
abandonedRoofThreads = []
lastRoofState = [False] * (max(c.value for c in roof.ResponseState) + 1)
# Intervals are all measured with time.monotonic(): an NTP step on the Pi would
# otherwise make the loop either sleep for hours or fire a burst of catch-up polls.
lastRoofIconUpdate = time.monotonic()
roofIconUpdateInterval = 3
# When the worker last published lastRoofState; 0.0 until the first poll lands, and
# reset back to that whenever the roof goes away, so a state from a previous roof
# instance can never be mistaken for a current one.
lastRoofStateTime = 0.0
# How stale the published state may be before a fan decision refuses to use it.
roofStateMaxAge = 5

# Which way each half is being driven, as last published by the roof worker. Kept beside
# lastRoofState rather than folded into it because it is not in the status word at all:
# the four motion relays are Pi GPIO and the Arduino cannot see them. Read lock-free, the
# same way lastRoofState and roofThread already are.
lastRoofDrive = {half: None for half in roof.RoofHalf}

def getRoofDrive():
    """Which way each half is being driven, as {RoofHalf: Direction | None}.

    A copy, so a caller iterating it cannot see the worker swap it underneath. Reports the
    relays, not the sequence: an arrow lit by this is showing that a contactor is closed,
    which is the thing an operator actually wants to know.
    """
    return dict(lastRoofDrive)

def publishRoofDrive(roofInstance):
    """Republishes the drive state from the relays, firing roofUpdate if it changed.

    serviceRoofOnce() does this at the end of every tick it completes, but the relays can
    be de-energized by paths that never reach that point: the lock-timeout path, and
    requestRoofMotion()'s stop, which goes straight to the relays on the caller's own
    thread and may be the last thing that ever happens if the worker is gone. Leaving the
    published state stale there would keep an arrow pulsing for a roof that has already
    stopped, which is the one thing the arrows must never do.

    The status word goes out unchanged, as the last one actually read: no board was
    consulted here, so nothing is known about it that was not known before.
    """
    global lastRoofDrive
    drive = {half: roofInstance.driving(half) for half in roof.RoofHalf}
    if drive == lastRoofDrive:
        return
    lastRoofDrive = drive
    triggerEvent("roofUpdate", lastRoofState)

def getRoofState():
    """Returns (state, age in seconds) as last published by the roof worker.

    state is None if no poll has succeeded yet. The two values are read separately, so
    the age can be off by up to one poll period -- immaterial against roofStateMaxAge,
    and it keeps readers off the worker's hot path entirely.
    """
    global lastRoofState, lastRoofStateTime
    if lastRoofStateTime == 0.0:
        return None, 0.0
    return lastRoofState, time.monotonic() - lastRoofStateTime

def roofUnavailableReason():
    """Why a roof command cannot be carried out, or None if it can.

    Asks whether anything will *execute* the command, not merely whether a Roof object
    exists. The two come apart on one path: makeRoof() returns False on a roofLock
    timeout before it ever reaches Roof.reset(), so the previous instance survives with
    its worker already joined and its handle cleared by stopRoof(). isInitialized()
    then answers True for a roof nothing is polling, and a command posted into the
    mailbox has no worker left to drain it -- the caller sees nothing wrong and nothing
    happens.

    roofThread is the honest test: roofLoop() is the mailbox's only consumer, and
    stopRoof() clears the handle whether it joined the worker or abandoned it. Read
    without a lock, exactly as weatherWarmingUp() reads weatherThread -- a reference
    read is atomic under the GIL and this only has to be eventually right.
    """
    if not roof.Roof.isInitialized():
        return "Roof not initialized"
    thread = roofThread
    if thread is None or not thread.is_alive():
        return "Roof worker is not running"
    return None

class RoofStatus(Enum):
    """The one word the operator gets for what the roof is doing.

    Six, not five. The five the roof can be in are open, opening, closed, closing and
    fault; disengaged is the sixth because it is not a state of the roof at all but of who
    is minding it, and it has to be distinguishable -- a de-energized roof that OMS has
    handed over looks exactly like a broken one otherwise.

    Anything that is not squarely one of the others is FAULT, which is the operator's own
    rule and a deliberate one: a half stopped between its switches, a roof pushed by hand,
    a board that has stopped answering. Each of those has a different reason and the same
    answer, which is that nothing may be concluded about where the roof is.
    """
    OPEN = "open"
    OPENING = "opening"
    CLOSED = "closed"
    CLOSING = "closing"
    FAULT = "fault"
    DISENGAGED = "disengaged"

# Whether OMS is minding the roof, kept here rather than only on the Roof instance.
#
# The instance is where the interlock lives -- drive() refuses on it, and that is what
# actually keeps a contactor open while somebody is at the roof -- but a Roof does not
# survive a settings save: makeRoof() drops it and builds a fresh one, which starts engaged.
# An operator who disengaged to work on the hardware, and then had the roof silently
# re-armed underneath them because somebody saved a setting, is precisely the accident this
# is for. So the decision is remembered here and re-applied to each new instance.
#
# Not persisted, on purpose and by the operator's own choice: a restart comes back engaged.
# Coming up with the safety checks switched off because of what somebody was doing before
# the last restart is not a state OMS may reach on its own.
roofEngaged = True

# Whether the rain interlock has been switched off by hand.
#
# Not persisted, and for exactly the reason stated just above roofEngaged rather than for a
# new one: an override is somebody's answer to what is happening right now -- a sensor they
# have been out to look at, a close they need to undo to get the roof shut properly -- and
# none of that survives a restart. OMS comes back with the interlock armed, always.
rainOverride = False

# The last time the interlock asked for a close, and how long it waits before asking again.
# time.monotonic(); 0.0 means it has not asked since startup, or that something has since
# made the next ask due immediately. One writer -- the weather worker -- and a rebind is
# atomic under the GIL, exactly as lastFanChange.
lastRainCloseRequest = 0.0

# Long enough that a close which was accepted has had its whole travel to finish: one half's
# travel budget alone starts at 60s, so a re-ask inside that would be made about a roof that
# is still shutting perfectly well. Short enough that a roof which *cannot* close -- latched
# fault, board gone -- goes on saying so about once a minute while it sits open in the rain,
# which is not a thing to report once and then fall silent about.
#
# Not a setting: it is a property of how long the roof takes to move, and that is already
# described by roof_travel_timeout. A second number the operator could set below it would
# only let them ask for a re-ask mid-travel.
rainCloseRetryInterval = 60

# The rain reading that counts as rain until the operator enters a threshold of their own.
# Named because two places need the same number and they must not be able to disagree: the
# guard below reads it as a fallback, and the settings field says it in its label so that an
# empty field still tells the operator what the roof will do.
rainThresholdDefault = 20

def roofDecisiveState():
    """The roof in one word, and the reason if that word is fault.

    Returns (RoofStatus, reason), reason being None whenever the state speaks for itself.
    The reason is not decoration: every fault below is a different problem with a different
    thing to do about it, and a screen that says only "fault" sends an operator to the roof
    to find out which.

    The order of the tests is the design. A running motion is reported before any complaint
    about the reading, because "a contactor is closed right now" outranks "the last status
    word is a few seconds old" -- and it is what the controls key off, so a stale poll must
    not be able to unblock the buttons under a moving roof. Everything after it is a reason
    the position cannot be trusted, in the order of how fundamental it is.
    """
    if not roof.Roof.isInitialized():
        return RoofStatus.FAULT, roofUnavailableReason()
    if not roofEngaged:
        return RoofStatus.DISENGAGED, "the safety checks are off and the relays are de-energized"
    if roofMotion.running:
        return ((RoofStatus.OPENING, None) if roofMotion.action == "open"
                else (RoofStatus.CLOSING, None))
    reason = roofUnavailableReason()
    if reason is not None:
        return RoofStatus.FAULT, reason
    status, age = getRoofState()
    if status is None:
        return RoofStatus.FAULT, "the roof has not been read yet"
    if age > roofStateMaxAge:
        return RoofStatus.FAULT, "the last reading is {}s old".format(int(age))
    instance = roof.Roof.get()
    if not instance.motionReady:
        return RoofStatus.FAULT, instance.motionFaultReason
    if roofMotion.phase is MotionPhase.FAULT:
        return RoofStatus.FAULT, "the last motion failed"
    position = instance.position(status=status)
    if position is roof.RoofState.OPEN:
        return RoofStatus.OPEN, None
    if position is roof.RoofState.CLOSED:
        return RoofStatus.CLOSED, None
    # Between the switches with nothing driving: a stop part-way, a half moved by hand, or
    # one that never arrived. Reported as a fault by the operator's decision -- there is no
    # position to act on, and saying "partially open" would read like a state to leave it in.
    return RoofStatus.FAULT, "neither fully open nor fully closed"

def roofCommandsBlocked():
    """Whether a command other than the emergency stop should be refused right now.

    One rule, in one place, so the buttons and the API cannot disagree about it: while the
    roof is moving, the only thing anybody may ask for is that it stops. Everything else --
    a second motion, clearing the fault out from under a running sequence, handing the roof
    to an operator mid-travel -- is either refused deeper down or is a thing that should be.
    """
    state, _ = roofDecisiveState()
    return state in (RoofStatus.OPENING, RoofStatus.CLOSING)

def rainReading():
    """The station's rain percentage, or None if there is no reading to judge.

    None is every way there can be no answer at once: the station is unreachable, the
    worker has not fetched yet, the cache has aged out, or the payload arrived without a
    usable rain_percentage. They are one answer here because they have one consequence --
    nothing may be concluded about the rain -- and telling them apart would only invite a
    caller to read some of them as "dry", which is the one thing none of them says.

    Judged stale by the same three refresh periods the weather card and updateFans() use,
    rather than by a rule of its own, so that the reading this acts on is the reading the
    operator is looking at on the Weather tab.
    """
    with weatherCacheLock:
        weather = weatherCache
        age = time.monotonic() - weatherCacheTimestamp
    if weather is None or age > numericSetting("weather_refresh", 5) * 3:
        return None
    return asNumber(weather.get("rain_percentage"))

def rainReason():
    """Why the station's reading counts as rain, or None if it does not.

    Ignores the override entirely: this answers what the weather is doing, and an operator
    who has switched the interlock off still has to be able to see what they switched it
    off in the face of. rainInterlockReason() is the one that answers what the roof may do.

    An absent reading is not rain. That asymmetry is the one judgement in here, and it is
    deliberate: this interlock fires on the station *saying* it is raining, and a station
    saying nothing at all is not saying that. The alternative would put the roof under an
    interlock nobody could lift every time the allsky camera the station hangs off is
    switched off -- a normal daytime state, and one weatherUnavailableReason() already
    describes -- and it would do it by treating silence as a measurement. A dead station is
    a thing the operator reads off the Weather tab, where every field goes to N/A.
    """
    rain = rainReading()
    if rain is None:
        return None
    threshold = numericSetting("roof_rain_threshold", rainThresholdDefault)
    if rain < threshold:
        return None
    return "rain is at {:.0f}%, at or above the {:.0f}% threshold".format(rain, threshold)

def rainInterlockReason():
    """Why the roof is being held shut, or None if nothing is holding it.

    The one place the rule lives, so that the Open button, the refusal inside
    requestRoofMotion() and the answer the API gives cannot disagree about it -- the same
    job roofCommandsBlocked() does for the moving-roof rule, and kept beside it for that
    reason.

    This is the only reading of the rain that accounts for the override, which is what
    makes it the one every *decision* goes through.
    """
    if rainOverride:
        return None
    return rainReason()

def rainOverrideActive():
    """Whether the rain interlock has been switched off by hand.

    An accessor rather than the flag itself because the API may only be handed things that
    are never rebound -- see the bind() call at the foot of this file. Every other reader is
    in this module and reads the global directly.
    """
    return rainOverride

def setRainOverride(override: bool):
    """Switches the rain interlock off, or arms it again. Returns whether it changed.

    Nothing is commanded here, in either direction. Arming the interlock does not close the
    roof by itself: the weather worker's next pass finds the rain and asks, which is the
    only path that ever drives the roof on the weather's account, and routing this through
    it too means there is one such path rather than two that could come to differ.

    Overriding likewise stops nothing already in flight. A rain close that is running goes
    on running, and the way to end that is the Stop button, which is the way to end any
    motion. An override that reached into a moving roof would be a second kind of stop, and
    the whole design here is that there is one.
    """
    global rainOverride, lastRainCloseRequest
    if rainOverride == override:
        return False
    rainOverride = override
    if override:
        logger.warning("Rain interlock overridden: OMS will not close the roof on rain, "
                       "and will allow it to be opened in the rain")
    else:
        logger.warning("Rain interlock armed")
        # Dropped so that a roof left open in the rain by the override is closed on the very
        # next weather pass, rather than at the end of a retry interval started before
        # anybody switched the interlock off.
        lastRainCloseRequest = 0.0
    triggerEvent("rainOverride", override)
    return True

def enforceRainInterlock():
    """Closes the roof if the station is reporting rain. Runs on the weather thread.

    The same contract as updateFans(), and for the same reasons: it touches neither the
    serial port nor roofLock, it reads the state the roof worker last published, and
    everything it wants goes into the command mailbox. It runs *before* updateFans() on
    each pass because a roof that has to shut outranks what the fans are doing.

    What it will not do is command a disengaged roof. requestRoofMotion() would refuse it
    anyway -- that is what the interlock is -- but it would also raise a roofMotionError at
    the operator once per weather pass, and somebody who has disengaged to work on the
    hardware has said that OMS is to keep its hands off the roof. Rain does not revoke
    that: a roof with somebody standing at it is not one to drive shut underneath them.
    """
    global lastRainCloseRequest
    if roofUnavailableReason() is not None:
        # Nothing would execute the command, and the state that follows is not worth
        # reasoning about. Deliberately without touching the retry stamp: this says nothing
        # about whether an earlier ask was carried out.
        return
    if not roofEngaged:
        return
    reason = rainInterlockReason()
    state, _ = roofDecisiveState()
    if reason is None or state in (RoofStatus.CLOSED, RoofStatus.CLOSING):
        # Dry, overridden, already shut, or already shutting -- nothing to ask for. The
        # retry stamp goes with it, so a roof that closes and is later opened again is
        # closed the instant rain comes back rather than at whatever happens to be left of
        # an interval that started before it ever opened.
        lastRainCloseRequest = 0.0
        return
    now = time.monotonic()
    if lastRainCloseRequest != 0.0 and now - lastRainCloseRequest < rainCloseRetryInterval:
        return
    lastRainCloseRequest = now
    logger.warning("Closing the roof: {}".format(reason))
    triggerEvent("warning", "Closing the roof: {}".format(reason))
    if state is RoofStatus.OPENING:
        # Stopped first, because executeMotionCommand() refuses a motion while one is
        # running: a close posted on its own here would be turned away and the open would
        # carry on into the rain. The stop and the close travel under separate mailbox keys
        # and the worker takes the stop first -- the Stop-then-Close postRoofStop()
        # documents -- so the open is abandoned and the close is judged against the status
        # of that same tick. The half's REVERSE_DEAD_TIME costs the close its first two
        # seconds, which drive() reports by asking to be called again rather than by
        # failing, and which the close-start budget is far wider than.
        requestRoofMotion("stop")
    # FAULT included, on purpose. It covers a roof that is between its switches, one whose
    # reading has gone stale, and one that has not been read at all -- and in every one of
    # those closing is both the right thing to want and a thing that may well work. The
    # cases where it cannot work, a latched motion fault above all, are refused by
    # executeMotionCommand() with a reason the operator is shown; the retry interval is what
    # keeps that from being said every five seconds.
    requestRoofMotion("close")

# Work for the roof worker to carry out between status polls. The worker owns the
# serial port on its own thread, so nothing else ever has to wait on roofLock to
# change the roof: callers post here and return immediately.
#
# Latest-wins per key, because the roof has exactly one correct state per key -- an
# unexecuted command that a newer one supersedes would only be undone again. Commands
# stay in the mailbox until a poll succeeds, so one posted while the board is
# unreachable is carried out when it comes back instead of being dropped.
# Reentrant, and only for the signal handler's sake. stopRoofForExit() runs inside a signal
# handler, which interrupts the main thread wherever it happens to be -- and the main thread
# is a poster: every UI button reaches postRoofCommand() or postRoofStop() from the event
# loop. A plain Lock would have the handler wait for a lock only the thread it interrupted
# can release, which is a hang at exactly the moment the roof needs stopping.
#
# Reentrancy is safe here rather than merely convenient, because the main thread only ever
# holds this across a single dict store. Interrupting one of those and running another leaves
# both stores done, in some order: postRoofStop() nested inside a postRoofCommand("motion")
# can leave a stop and a motion in the mailbox together, which serviceRoofOnce() already
# handles -- it takes the stop first, and that is the documented Stop-then-Close. What it
# cannot do is lose one. takeRoofCommands() *does* rebind the dict and could lose a store,
# but only the roof worker calls it, and no signal handler runs on that thread.
roofCommandLock = threading.RLock()
roofCommands = {}

def postRoofCommand(key, value):
    with roofCommandLock:
        roofCommands[key] = value

def takeRoofCommands():
    global roofCommands
    with roofCommandLock:
        commands = roofCommands
        roofCommands = {}
    return commands

def clearRoofCommands():
    global roofCommands
    with roofCommandLock:
        roofCommands = {}

def postRoofStop():
    """Posts a stop, and drops any open or close already waiting behind it.

    A stop gets its own key rather than sharing "motion" with the motions it supersedes.
    Latest-wins is the right rule *within* one kind of command and the wrong one *between*
    two: a newer open supersedes an older open, but a newer open must never supersede a
    stop. Sharing the key meant exactly that happened -- an operator who pressed Stop and
    then Close had their stop silently overwritten, takeRoofStop() found a close, the
    sequence was never dropped, and the motion that had just been stopped resumed as soon
    as REVERSE_DEAD_TIME elapsed, while the close was refused as "already in progress".
    requestRoofMotion()'s direct de-energize is untouched by any of this, but on its own it
    only buys those two seconds.

    Clearing "motion" is the other half of the same rule, done here under the one lock so
    nothing can slip in between. An open or close already in the mailbox was asked for
    *before* the stop, so the stop supersedes it; leaving it would have the worker carry out
    the stop and then start, on that very same tick, the motion it was meant to cancel. A
    motion posted *after* the stop is a new instruction and is deliberately kept -- that is
    the Stop-then-Close an operator actually means, and it works on one tick, because
    serviceRoofOnce() runs the stop before the mailbox and stopRoofMotion() has reset the
    sequence by the time executeMotionCommand() looks at it. The interlock is not weakened
    by that: stopMotion() has just stamped both halves' dead time, so drive() refuses for
    REVERSE_DEAD_TIME, and CLOSE_RODCLEAR, which energizes nothing, is where it is spent.
    """
    with roofCommandLock:
        roofCommands.pop("motion", None)
        roofCommands["stop"] = True

def takeRoofStop():
    """Removes a pending stop from the mailbox, leaving everything else in it.

    Separate from takeRoofCommands() because a stop is the one command that must be
    carried out on a tick whose status poll failed. It needs no status -- it drops the
    relays and nothing else -- and that tick is exactly the one on which a half may be
    energized with the board no longer answering. Every other command is judged against a
    fresh reading and waits in the mailbox until there is one, which is a property the
    fans rely on and must not lose.

    Carries no stamp, unlike an open or a close: a stop is never the wrong thing to do,
    however old it is, so there is nothing to expire it against.
    """
    with roofCommandLock:
        return roofCommands.pop("stop", None) is not None

# One poll is a 3-byte exchange at 9600 baud plus up to the 10 ms the board spends in its
# own delay(), so ~13 ms of work. 0.05 dates from when a command had to wait for the next
# poll to be carried out; the command mailbox removed that, and nothing needs roof status
# at 20 Hz -- the icons refresh on roofIconUpdateInterval and the fan decision refuses
# anything older than roofStateMaxAge. Half a second keeps an order of magnitude of
# headroom over the exchange and is still ten times fresher than that limit.
roofPollPeriod = 0.5
# Ceiling on the backoff while the board is failing, as a multiple of the period. Lowered
# with the period so it still works out to ~5 s between attempts, and a board that comes
# back is noticed about as quickly as it was before.
roofPollBackoffMax = 10
# One error record per this many consecutive failures. Fewer polls per minute now, so a
# smaller number keeps a dead board about as visible in the log as it used to be.
roofPollLogEvery = 10

class MotionPhase(Enum):
    IDLE = 0
    # Opening a half: the rod goes out the moment the half starts opening, alongside a
    # short run that pays out belt; everything then holds until the rod has completed its
    # stroke, and only after that does gravity get its run.
    OPEN_KICK = 1
    OPEN_SETTLE = 2
    OPEN_RUN = 3
    # Closing a half: confirm the rod is out of the way, pull the half up, then keep
    # pulling briefly past the switches so it seats tight.
    CLOSE_RODCLEAR = 4
    CLOSE_RUN = 5
    CLOSE_TIGHTEN = 6
    FAULT = 7

# How long to wait for a rod to confirm itself retracted before giving up. Derived from
# the firmware rather than guessed: Motor::isRetracted() only answers true 20 s
# (MAX_EXTENDED) after the last retract command, and extend() auto-retracts 20 s after the
# extend, so the honest worst case is 40 s. This budget deliberately does not come out of
# roof_travel_timeout -- it is a firmware wait, not motion, and nothing is energized during
# it. In practice the roof has been open far longer than that and the phase falls straight
# through.
roofRodClearBudget = 45

def roofOpenPrepBudget():
    """The outer bound on an open before gravity gets its run.

    Everything from picking the half up to entering OPEN_RUN: the dead time drive() may
    refuse for, the kick, and the rod's whole stroke. Derived from the phases it actually
    contains rather than taken out of roof_travel_timeout, because that number means "how
    long a half takes to travel" and a rod stroke is not travel -- the same reasoning
    CLOSE_RODCLEAR already runs on. Sharing the travel budget made roof_rod_timeout
    unreachable: with travel at its 60 floor and the rod at its 60 ceiling the outer
    deadline fires mid-stroke, and the failure blames travel for a rod that was never
    given its time.

    Each phase inside it ends on the first tick *past* its own deadline, so a poll period
    is added for each, plus one more as slack. A budget that expires before the phases it
    contains can finish is the whole bug this exists to remove.

    That slack is thin -- one poll period at the setting floors -- and a poll period is not
    what a tick costs when the port is retrying, so both phases that follow re-base the
    outer deadline onto their own number: OPEN_SETTLE onto the rod's when the kick hands
    over, and OPEN_KICK onto the kick's the moment its relay closes. What is left standing
    here is therefore only the window before anything is energized -- the sequence waiting
    out REVERSE_DEAD_TIME for drive() to be accepted. Being over-generous for that by a
    whole rod stroke is deliberate: it is the one stretch whose length cannot be predicted
    (a tick retrying the port costs up to 8s), and with both relays off there is nothing to
    be urgent about.

    Set rather than left None, unlike CLOSE_RODCLEAR: enforceRoofStopWithoutLock() is armed
    by this deadline being set, and it must already be armed when the kick's relay closes.
    From that instant the re-based value is what bounds the contactor, and this path is the
    only thing that can drop it while the worker is wedged holding roofLock.
    """
    return (roof.Roof.REVERSE_DEAD_TIME
            + numericSetting("roof_kick_time", 2)
            + numericSetting("roof_rod_timeout", 30)
            + 4 * roofPollPeriod)

def roofBlindDriveBudget():
    """How long a contactor may stay closed with no fresh status behind it.

    The run phases are the only two that hold a relay while waiting on a switch, and they
    were the only two that met a failed poll with a bare return -- so the phases with both
    relays off failed fast on a silent board and the phases pulling a motor ran on for
    whatever was left of roof_travel_timeout, which at the run phases is all of it, freshly
    stamped. That is 60-120s of driving blind, and since travel is ~30s the likely half of
    it is a half already on its switches with the motor stalled against its own end stop --
    against a deliberate roof_close_overrun of about 2s. The board going quiet is also not
    independent of the roof being in trouble: one pinched cable on a moving half produces
    both.

    Sized against a poll rather than picked, so a board configured to be slow is not
    punished for it: one term is what a failed poll spends inside its own tick, one is the
    gap to the next, and three of them is three or four consecutive failures -- the same
    debounce depth ABSENCE_STRIKES already applies to deciding a half has gone adrift. That
    is 2.7s at a roof_timeout of 0.2 and 3.3s at its ceiling of 0.3, either of which is a
    different order of thing from a full travel budget.

    Deliberately not multiplied by roofTimeoutsPerAttempt, unlike roofStopBudget(), and the
    difference is intent rather than an oversight. That budget has to bound the worst hold
    that can really happen, so under-counting it abandons healthy workers. This one is a
    debounce on how long a contactor may keep pulling with nothing watching it, so counting
    the write half as well would only make it longer -- 5.1s instead of 3.3s at the ceiling --
    and a relay held blind for longer is the wrong direction to be corrected in. Three
    ordinary failed polls is what it means, and a failed poll that also stalls on its write
    is not the case it is debouncing.

    Deliberately not a re-based roofMotion.deadline either: that one stays on roof_travel_timeout
    because it is also what arms enforceRoofStopWithoutLock(), which is the only thing that
    can drop these relays when the worker is wedged holding roofLock. This bounds the other
    failure -- worker healthy, board gone -- and the two need separate numbers.

    OPEN_KICK does add this to its outer deadline, which is not that contradiction: the kick
    is short enough that its whole relay time is inside the window this describes, so the
    same allowance that lets a run phase keep pulling through a few dead ticks is exactly
    the margin the kick's deadline needs to not fire before the kick's own clock does.
    """
    attempts = roof.Roof.WRITE_RETRIES + 1
    return 3 * (attempts * numericSetting("roof_timeout", 0.2) + roofPollPeriod)

def roofMotionCommandMaxAge():
    """How old a queued open or close may be when the worker finally reaches it.

    A command normally waits one poll period. The honest worst case is a poll that failed
    plus the backoff that follows it (roofPollPeriod * roofPollBackoffMax, ~5 s) plus a
    roofLock hold of up to roofStopBudget() -- and this has to sit comfortably above that
    sum, or a command that was merely waiting its turn is thrown away as stale.

    Twice the sum, floored at the 30 s this was for a long time. It was a flat 30 back when
    the budget could not exceed 11, where 30 was several times the worst wait; that stopped
    being self-evident once the budget started deriving from the real exchange count, so this
    derives too and the relationship holds at every setting rather than at the one it was
    written for.

    Since roof_timeout's ceiling came down to 0.3 the floor is what governs everywhere: the
    budget cannot exceed 9 s, so the sum cannot exceed 14 and twice it is 28. The derivation
    is kept rather than collapsed back into a constant, because it is what makes 30 provably
    enough instead of merely traditional, and it is what would notice if the budget grew
    again. 30 s is short enough that the roof cannot start moving minutes after somebody
    asked it to, which is what a board that went away for a while used to produce, because
    the mailbox holds a command until there is a status to judge it against.

    A function rather than a setting: it is arithmetic on the poll rate and the lock hold,
    not a property of the site. A stop is never expired and never reaches the check -- it
    carries no stamp at all, because a stop is never the wrong thing to do however old it is.
    """
    return max(30.0, 2 * (roofPollPeriod * roofPollBackoffMax + roofStopBudget()))

class RoofMotion:
    """Where the roof sequence has got to. Owned by the roof worker thread.

    Read from other threads only through getRoofDrive(), which reports the relays rather
    than this. Nothing outside the worker writes it.
    """
    def __init__(self):
        self.reset()

    def reset(self):
        self.phase = MotionPhase.IDLE
        self.action = None
        self.half = None
        self.queue = []
        # The outer budget for where the half is now, and the current phase's own. Both are
        # time.monotonic() stamps; None means "not started yet", which is how an
        # energizing phase tells the difference between "waiting for the dead time to
        # elapse" and "running".
        #
        # `deadline` is re-based as the motion changes what it is waiting on, because one
        # number cannot honestly bound a rod stroke and a gravity run at once:
        # roofOpenPrepBudget() up to OPEN_RUN, roof_travel_timeout for the run phases,
        # roof_close_overrun for the tighten, and None only in CLOSE_RODCLEAR, where both
        # relays are off. Whatever it holds, the phase-to-budget mapping is single-valued,
        # which is what lets advanceRoofMotion() name the right one when it expires.
        self.deadline = None
        self.phaseDeadline = None
        # Whether the board has acknowledged this half's extend -- not merely that one was
        # written. It gates the send to once per half, and OPEN_SETTLE reads it to tell a
        # finished rod stroke from one that never started.
        self.rodSent = False
        # Whether "the motor is now running" has been logged for this half. The run phases
        # call drive() every tick, and one line per tick for two minutes would bury the
        # transitions that actually matter.
        self.runLogged = False
        # Whether this half has been seen off its open switches since CLOSE_RUN started
        # pulling it. The start check and the slide-back check are the same reading -- the
        # half is on its open switches with the motor pulling -- so this is the only thing
        # that tells "it never left" from "it left and came back", which are the same
        # hazard but not the same message. Per half, like rodSent and runLogged.
        self.departed = False
        # When the run phases last found themselves without a status, or None when the
        # last one they saw was good. Only the run phases touch it, and they clear it on
        # every tick that has a status, so a poll that fails once and then recovers costs
        # a motion nothing. It is not a deadline: the budget it is measured against is
        # read when it is checked, so a settings change takes effect immediately.
        self.blindSince = None

    @property
    def running(self):
        return self.phase not in (MotionPhase.IDLE, MotionPhase.FAULT)

roofMotion = RoofMotion()

# The order the halves move in, and it is not symmetric. West opens first because the east
# half cannot clear until it has; closing runs the other way for the same reason.
roofMotionOrder = {
        "open": [roof.RoofHalf.WEST, roof.RoofHalf.EAST],
        "close": [roof.RoofHalf.EAST, roof.RoofHalf.WEST],
        }

def retractRoofRods(roofInstance, status, log):
    """Sends a retract to every rod that is still commanded out. Best effort.

    A rod left sticking out of a roof that has stopped is doing no good and is in the way:
    the next close has to wait for it in CLOSE_RODCLEAR before it may pull anything up. So
    every path that stops a motion asks for this.

    Unlike de-energizing, it is not something a stop may depend on. The relays are Pi GPIO
    and come off with four local writes that cannot fail to be attempted; a rod lives on
    the Arduino and needs the serial port, which means the lock, a board that is answering,
    and a worker to do it. This therefore runs only where all three hold, and the firmware
    is the real backstop either way: Motor::update() retracts each rod by itself after
    MAX_EXTENDED (20 s) whatever OMS manages here. This only makes it prompt.

    Only rods whose firmware state is still EXTEND are touched. Retracting one that is
    already on its way back would restart the board's 20 s isRetracted() clock for nothing,
    and the next close would then sit in CLOSE_RODCLEAR waiting the whole of it out -- the
    same reasoning CLOSE_RODCLEAR itself uses before sending one.

    Both halves, not just the one that was moving. A stop de-energizes both, so leaving the
    other half's rod out because it was not the one being driven would be an odd exception
    to make -- and in practice only one is ever out, so the loop costs nothing. The single
    exception is a rod an open is mid-stroke on, which the loop skips; see there for why.

    Returns (ok, status). ok is False if anything could not be sent, so the caller can
    leave it for a tick that can. status is the newest word the board returned, which the
    caller has to carry forward for the rest of the tick: a retract's reply is a status
    like any other, and the reading the tick was working from is stale by one exchange the
    moment the first retract goes out. executeFanCommand() hands its reply back for exactly
    this reason.

    It is not a nicety. Everything after this in a tick judges the roof against `status`,
    and the one that matters is CLOSE_RODCLEAR: reading the pre-retract word it still sees
    REQ set, so it sends a second retract to a rod that has just been told to go back --
    the very double send this function and that phase both take care to avoid. Reachable
    whenever a "rods" key survives a status-less tick and a close arrives before the next
    good one, which puts both in the same tick.

    The loop reads the freshest word it has for each half rather than the one it was
    handed, which is strictly better: a rod the firmware has retracted by itself in the
    meantime is then skipped rather than commanded again.
    """
    ok = True
    for half in roof.RoofHalf:
        if roofMotion.running and half is roofMotion.half and roofMotion.rodSent:
            # The one rod that must not be pulled back. An open put it out on purpose and
            # OPEN_SETTLE is waiting for the firmware to clear its REQ bit at the end of
            # the stroke -- the only completion signal there is, since nothing senses the
            # rod's position. A retract sent here clears that bit exactly as finishing
            # would, and nothing downstream can tell the two apart: the next tick reads a
            # stroke that never happened, finds the seat switches clear (a kick alone can
            # shake a half off them without pushing it clear of its seal) and promotes to
            # OPEN_RUN. The half then runs open on gravity having never been pushed. That
            # is the failure OPEN_SETTLE's rodSent guard exists to prevent, and it cannot
            # catch this one, because here the extend really was acknowledged.
            #
            # rodSent rather than running alone: until the board has acknowledged the
            # extend there is no stroke to spoil, and a rod still out from something
            # earlier should come back like any other. A stop leaves running False before
            # it asks for a retract, so no stop path is affected.
            continue
        try:
            if not roofInstance.rodExtendRequested(half, status=status):
                continue
            log(logging.INFO, "Roof stop: retracting the {} rod".format(half.value.lower()))
            status = roofInstance.retractRod(half)
        except Exception as e:
            log(logging.WARNING, "Could not retract the {} rod: {}".format(
                half.value.lower(), e))
            ok = False
    return ok, status

def retractRoofRodsPolled(roofInstance, log):
    """Sends every extended rod back, reading the board for itself. Runs under roofLock.

    retractRoofRods() works from a status its caller is already holding, because inside a
    tick there always is one -- the poll at the top of serviceRoofOnce(). The teardown paths
    have none: stopRoof() has just joined the worker, and stopRoofForExit() may be running with no
    worker left at all. So the poll belongs here, once, rather than at each of them.

    Returns whether every rod that needed one got its retract. Best effort throughout: a
    board that will not answer costs the promptness and nothing else, because the firmware
    retracts each rod by itself after MAX_EXTENDED (20 s) regardless.
    """
    try:
        status = roofInstance.getStatus()
    except Exception as e:
        log(logging.WARNING,
            "Could not read the roof to see which rods are out: {}".format(e))
        return False
    ok, _ = retractRoofRods(roofInstance, status, log)
    return ok

def requestRodRetract():
    """Leaves a rod retract for the worker, for stop paths that cannot do it themselves.

    requestRoofMotion()'s direct stop and enforceRoofStopWithoutLock() both run without
    roofLock, and failRoofMotion() may have no usable status -- none of them may touch the
    serial port. The relays are already off by the time any of them gets here, so the rod
    is not urgent; it only has to happen, and the mailbox is what guarantees it reaches the
    one thread allowed to talk to the board.
    """
    postRoofCommand("rods", "retract")

def failRoofMotion(roofInstance, reason, log, event):
    """Ends a motion badly: relays off, roof latched, operator told.

    faultMotion() does the de-energizing and logs the reason itself, so this only adds the
    phase the failure happened in -- which is the part that says what was being attempted.
    """
    phase = roofMotion.phase.name
    try:
        roofInstance.faultMotion(reason)
    except Exception as e:
        log(logging.ERROR, "Could not fault roof motion: {}".format(e))
    log(logging.ERROR, "Roof motion failed in {}: {}".format(phase, reason))
    event("roofMotionError", reason)
    roofMotion.reset()
    roofMotion.phase = MotionPhase.FAULT
    # A fault stops a motion as surely as a stop does, and the rod must not be left out
    # because of it. Deferred rather than sent here: this is reached from paths whose
    # status may be stale or absent, and one of them is a serial exchange that just failed.
    requestRodRetract()

def abandonFaultedMotion(roofInstance, log, event):
    """Ends the sequence for a fault the Roof has already latched by itself.

    Distinct from failRoofMotion(), and the difference is who decided. failRoofMotion() is
    for a failure the sequence itself found -- a budget that ran out, a half that will not
    move -- so it composes a reason and latches it. This one is for a fault a consistency
    check inside Roof latched first, where the reason already exists and everything is
    already de-energized; all that is left is to stop the sequence and say which phase it
    was in. Reporting it through failRoofMotion() instead would wrap the Roof's own reason
    in a second one of ours and name the wrong cause.
    """
    log(logging.ERROR, "Roof motion abandoned in {}: {}".format(
        roofMotion.phase.name, roofInstance.motionFaultReason))
    event("roofMotionError", roofInstance.motionFaultReason)
    roofMotion.reset()
    roofMotion.phase = MotionPhase.FAULT
    # The same rule failRoofMotion() ends on, and for the same reason: who composed the
    # reason has no bearing on where the rod is. A consistency check can latch during
    # OPEN_SETTLE, which is precisely the phase that sits for as long as a stroke takes with
    # a rod out, so this is the one that ends most often with something still extended.
    #
    # Not urgent, and the firmware is the real backstop -- Motor::update() pulls each rod
    # back at MAX_EXTENDED whatever happens here, and nothing may move again until an
    # operator clears the latch anyway. What it buys is the margin: left to the firmware the
    # rod does not confirm retracted until 20 s after that, so a close commanded straight
    # after the fault is cleared reaches CLOSE_RODCLEAR with a few seconds of
    # roofRodClearBudget to spare instead of most of it.
    #
    # Safe to ask for unconditionally. The reset above leaves running False, so the skip in
    # retractRoofRods() for a rod an open is mid-stroke on does not apply -- there is no
    # stroke left to spoil -- and that function only touches rods the board still reports as
    # extended, so one the firmware has already taken back costs nothing.
    requestRodRetract()

def blindRunTooLong(roofInstance, now, half, log, event):
    """Whether a run phase has held its contactor blind for longer than it may.

    Called by OPEN_RUN and CLOSE_RUN in place of the bare `return` they used to meet a
    failed poll with. Shared rather than written out twice because the two phases have
    drifted apart before -- CLOSE_RUN grew roof_close_start_timeout and OPEN_RUN did not --
    and this is the one bound that has to mean the same thing on both, since what it
    protects (a motor pulling with nothing watching it) is identical.

    Returns True once it has failed the motion, so the caller returns either way; the
    difference is only whether the relay is still up. The first blind tick just starts the
    clock: one failed poll in the middle of a two-minute travel is ordinary, and aborting
    on it would trade a rare hazard for a common nuisance -- one that latches, since
    failRoofMotion() faults and nothing yet clears that.
    """
    if roofMotion.blindSince is None:
        roofMotion.blindSince = now
        log(logging.WARNING, "Roof {} [{}]: no status while running, still driving".format(
            roofMotion.action, half.value.lower()))
        return False
    budget = roofBlindDriveBudget()
    if now - roofMotion.blindSince <= budget:
        return False
    failRoofMotion(roofInstance,
            "no status for {:.1f}s while the {} half was running".format(
                budget, half.value.lower()), log, event)
    return True

def enterMotionPhase(phase, log, detail):
    """Moves to the next phase and says so. Every transition goes through here.

    Roof motion is the one thing in OMS that can wreck the hardware, and it runs unattended
    over minutes -- so the log has to be enough to reconstruct exactly what happened
    afterwards, without a debug level being turned on first. INFO for that reason, and
    through the deferred collector so the write still happens outside roofLock.
    """
    log(logging.INFO, "Roof {} [{}]: {} -> {} ({})".format(
        roofMotion.action, roofMotion.half.value.lower(),
        roofMotion.phase.name, phase.name, detail))
    roofMotion.phase = phase

def startRoofMotionHalf(now, log, event):
    """Begins the next half's sequence, or ends the motion if there is none left."""
    if not roofMotion.queue:
        log(logging.INFO, "Roof {} complete".format(roofMotion.action))
        action = roofMotion.action
        roofMotion.reset()
        event("roofMotionDone", action)
        return action
    roofMotion.half = roofMotion.queue.pop(0)
    roofMotion.phaseDeadline = None
    # Per half, not per motion: the second half gets its own rod push, and its own
    # "now running" line.
    roofMotion.rodSent = False
    roofMotion.runLogged = False
    roofMotion.departed = False
    if roofMotion.action == "open":
        # Always through the kick. There is no skip-the-kick path any more: roof_kick_time
        # has a floor of 1.5 s precisely because a rod pushing a half that is still hard on
        # its seat breaks off, so "open without kicking first" is not a thing to offer.
        roofMotion.phase = MotionPhase.OPEN_KICK
        # Neither the kick nor the rod stroke is travel, so neither is charged to the
        # travel budget; that starts when OPEN_RUN does. They get a budget sized against
        # themselves instead, so roof_rod_timeout is reachable at every setting.
        roofMotion.deadline = now + roofOpenPrepBudget()
    else:
        roofMotion.phase = MotionPhase.CLOSE_RODCLEAR
        # The rod wait is not motion, so it runs outside the travel budget. The budget is
        # restarted when CLOSE_RUN actually energizes the relay.
        roofMotion.deadline = None
        roofMotion.phaseDeadline = now + roofRodClearBudget
    log(logging.INFO, "Roof {}: starting {} half".format(
        roofMotion.action, roofMotion.half.value.lower()))
    return None

def advanceRoofMotion(roofInstance, status, log, event):
    """One step of the roof sequence. Runs on the worker thread with roofLock held.

    Called on every tick, including one whose status poll failed -- timers still have to
    fire and relays still have to come off when the board goes away. `status` is None on
    such a tick, and the rule that follows from it is absolute: **a tick with no fresh
    status may only stop relays or fault, never energize one.** Phases waiting on a switch
    simply cannot progress, so they run to their deadline and fail, which is the right
    answer for "the board vanished mid-travel".

    Every phase has a bound it fails on when blind, and the bound is the phase's own, not
    the outer budget. That distinction is the whole of it: the rule above is about the
    write, and a relay already closed keeps pulling through a tick that writes nothing at
    all -- so the two phases that hold a contactor are exactly the two where "run to the
    deadline" had to mean something shorter than roof_travel_timeout. They get
    roofBlindDriveBudget(); see blindRunTooLong().

    Never blocks and never sleeps. Each call does at most one relay write and one serial
    command -- which is the whole reason the sequence is a state machine rather than a
    function that drives the roof and waits for it, and it is the last of the five terms
    roofMaxExchangesPerTick counts. The lock hold is not milliseconds, though: it is this
    one exchange plus the rest of the tick's, and roofStopBudget() is derived from all of
    them together rather than from this line alone.
    """
    if not roofMotion.running:
        return
    if not roofInstance.engaged:
        # Disengaged underneath a running sequence. Ended here rather than left to fail on
        # its next relay write: drive() refuses now, so the phase machine would reach one,
        # raise, and be latched as a motion fault by serviceRoofOnce() -- reporting a defect
        # for something the operator asked for. Nothing is energized by this point either
        # way; disengage() de-energized on the caller's own thread before the flag was even
        # readable here.
        log(logging.WARNING, "Roof {} abandoned in {}: the roof was disengaged".format(
            roofMotion.action, roofMotion.phase.name))
        roofMotion.reset()
        event("roofMotionStopped")
        return
    if not roofInstance.motionReady:
        # Faulted underneath us, almost certainly by a consistency check inside the
        # getStatus() a few lines up the call stack. Everything is already de-energized.
        abandonFaultedMotion(roofInstance, log, event)
        return

    now = time.monotonic()
    half = roofMotion.half
    # Checked before any phase: a phase that cannot make progress -- a board that stopped
    # answering, a half that is not moving -- has to end here rather than run on.
    if roofMotion.deadline is not None and now > roofMotion.deadline:
        # Which budget just ran out depends on the phase, and each phase belongs to exactly
        # one: an open before OPEN_RUN is on roofOpenPrepBudget(), a tighten is on its own
        # re-based one, and only the run phases are on roof_travel_timeout. Naming the wrong
        # number here is how this hid -- an open faulting mid-rod-stroke reported "did not
        # finish its open within 60s" and read like a roof that would not move.
        if roofMotion.phase is MotionPhase.OPEN_KICK:
            # Two different failures share this phase, and they are on different budgets
            # since the kick re-bases this deadline the moment its relay closes. No phase
            # deadline means the relay never closed at all -- drive() refused for the whole
            # window, or no tick got a status to try on -- and nothing was ever energized.
            # One set means it closed and the kick did not end on time, which only happens
            # when the worker stopped running the phase, and that is the case where this
            # deadline is the thing dropping the contactor. Neither is "the half did not get
            # off its seat": whether it left is decided in OPEN_SETTLE, by the switches.
            if roofMotion.phaseDeadline is None:
                reason = "{} half never started its kick within {:.0f}s".format(
                        half.value.lower(), roofOpenPrepBudget())
            else:
                reason = "{} kick relay stayed up {:.1f}s past its {:.1f}s kick".format(
                        half.value.lower(), roofBlindDriveBudget(),
                        numericSetting("roof_kick_time", 2))
        elif roofMotion.phase is MotionPhase.OPEN_SETTLE:
            # Re-based on entry, so this is the rod's number and not the prep sum. Reaching
            # it at all means the phase's own deadline -- two poll periods shorter -- did not
            # get a tick to fire on, so the honest reading is a starved worker rather than a
            # slow rod; naming the rod's budget still points at the right stretch of time.
            reason = "{} rod did not finish its stroke within {:.0f}s".format(
                    half.value.lower(),
                    numericSetting("roof_rod_timeout", 30) + 2 * roofPollPeriod)
        elif roofMotion.phase is MotionPhase.CLOSE_TIGHTEN:
            # The overrun plus the margin CLOSE_RUN adds when it re-bases, not the setting on
            # its own: the setting is what the phase pulls for, this is what the deadline
            # being reported was actually set to. Unlike OPEN_SETTLE above, arriving here is
            # not merely a starved worker reported under a different name -- the tighten's
            # own deadline expiring is how a close *succeeds*, so this branch is the one
            # failure in the machine that can fire on a half already seated. See the re-base
            # for what keeps that out of reach.
            reason = "{} half did not finish seating within {:.1f}s".format(
                    half.value.lower(),
                    numericSetting("roof_close_overrun", 2) + roofBlindDriveBudget())
        else:
            reason = "{} half did not finish its {} within {:.0f}s".format(
                    half.value.lower(), roofMotion.action,
                    numericSetting("roof_travel_timeout", 90))
        failRoofMotion(roofInstance, reason, log, event)
        return

    phase = roofMotion.phase

    # A half that is already where it is being sent needs nothing done to it. Reachable
    # whenever the roof was found part-way -- one half open, the other shut -- and without
    # this an "open" would kick, rod and run an already-open half before noticing. Guarded
    # on driving() so it only ever short-circuits a half nothing has energized yet.
    if (status is not None
            and phase in (MotionPhase.OPEN_KICK, MotionPhase.OPEN_SETTLE,
                          MotionPhase.CLOSE_RODCLEAR)
            and roofInstance.driving(half) is None):
        target = (roof.RoofState.OPEN if roofMotion.action == "open"
                  else roof.RoofState.CLOSED)
        if roofInstance.halfPosition(half, status=status) is target:
            log(logging.INFO, "Roof {}: {} half is already there".format(
                roofMotion.action, half.value.lower()))
            startRoofMotionHalf(now, log, event)
            return

    # The rod goes out as early as it safely can, and no earlier.
    #
    # As early as possible, because the belt paying out lets the half start to fall, and a
    # half dropping onto its belt loads the whole building. The rod is there to take that
    # descent, not only to shove a stuck half -- so it has to be pushing while the slack
    # appears, not after. It is also what makes the open honest: a half can stick a little
    # way *past* its closed switches, far enough for them to report clear and not far
    # enough for gravity to take over, so "the switches went clear" is not proof the half
    # is free. Pushing from the start and holding until the stroke completes is.
    #
    # And no earlier, because "the phase says OPEN_KICK" is not the same as "the motor is
    # turning". drive() refuses for REVERSE_DEAD_TIME after any stop -- a stop then an
    # immediate re-open, a motion within 2 s of startup, anything after a fault -- and in
    # that window the phase is OPEN_KICK with both relays off and the belt still taut. A
    # rod driven against a half held rigid by a taut belt is what snaps it off, and that is
    # the same failure roof_kick_time's 1.5 s floor exists to prevent but cannot catch,
    # because this is an ordering problem rather than a duration one. Gating on driving()
    # makes "the belt was already paying out" a guarantee instead of the usual case.
    #
    # OPEN_KICK only, not OPEN_SETTLE: driving() also answers OPEN during OPEN_RUN, and a
    # rod whose send failed for the whole kick must not fire midway through the gravity
    # run. The retry window is the kick, and a send that never lands leaves OPEN_SETTLE
    # waiting on a stroke that is not happening, which is the right way for it to fail.
    if (roofMotion.action == "open" and not roofMotion.rodSent
            and phase is MotionPhase.OPEN_KICK and status is not None
            and roofInstance.driving(half) is roof.Direction.OPEN):
        # The reply is the acknowledgement, so it is read rather than discarded. The
        # firmware sets m_state = EXTEND inside extend() and only then builds the status,
        # so an accepted extend always answers with this half's REQ bit set. Anything else
        # -- a corrupted reply word, a board that took the bytes without acting -- leaves
        # rodSent False and the next tick tries again, still inside the kick. rodSent has
        # to mean "the board acknowledged", not "we wrote bytes", because OPEN_SETTLE
        # below refuses to wait on a stroke that was never accepted. A rejected command
        # does not arrive here at all: writeCmd() retries it and then raises, which
        # serviceRoofOnce() turns into a fault.
        #
        # Nothing in this block returns, so a rod that will not go out never stalls the
        # phase machine: the kick still ends on its own deadline, with its relay coming
        # off on time, and OPEN_SETTLE is where the failure is decided. The one way out is
        # the fault guard below, which is not this block's business.
        replied = roofInstance.extendRod(half)
        if roofInstance.rodExtendRequested(half, status=replied):
            roofMotion.rodSent = True
            log(logging.INFO, "Roof open: pushing the {} half off its seat".format(
                half.value.lower()))
        else:
            log(logging.WARNING, "The {} rod did not take its extend command".format(
                half.value.lower()))

    # Re-checked, because the send above is the second place a fault can land inside one
    # tick. That reply is a status word like any other and __decodeAndCheck() runs the
    # consistency checks over it, so a broken switch can latch a fault here, after the guard
    # at the top of this function has already passed.
    #
    # Without it the tick carried straight on into the phase body and ran a step of the
    # sequence -- ending the kick, dropping the relay, entering OPEN_SETTLE -- on a roof whose
    # motion was already latched faulted, and nothing said so until the next tick's guard
    # noticed. Nothing was at risk either way: faultMotion() de-energizes before it returns,
    # so the relay was already off, and every phase that could energize one refuses on a
    # faulted roof. What this buys is that the sequence stops at the fault instead of one step
    # past it, and the operator is told inside the same tick, naming the phase it was really
    # in rather than the one it had already moved on to.
    if not roofInstance.motionReady:
        abandonFaultedMotion(roofInstance, log, event)
        return

    if phase is MotionPhase.OPEN_KICK:
        if roofMotion.phaseDeadline is None:
            # Not running yet. drive() answers False while the half is still inside its
            # dead time; the kick clock only starts once the relay is genuinely energized,
            # so a kick is always its full length rather than however much of it was left
            # after the dead time.
            if status is not None and roofInstance.drive(half, roof.Direction.OPEN):
                kick = numericSetting("roof_kick_time", 2)
                roofMotion.phaseDeadline = now + kick
                # The relay is up as of the line above, and from here until stopHalf() this
                # deadline is the only thing that can drop it: it is what arms
                # enforceRoofStopWithoutLock(), and a worker wedged in a serial read runs
                # none of the timers below. What it carried in from startRoofMotionHalf()
                # was roofOpenPrepBudget(), which includes the whole rod stroke -- a stroke
                # that happens in OPEN_SETTLE with both relays off. That left the one phase
                # holding a contactor bounded at ~30s when the kick is over in ~2, long
                # enough to run the half fully open and stall it on its end stop.
                #
                # Re-based here rather than on entry because only here is what remains known
                # exactly: the kick, then one tick to notice it expired. Before the relay
                # closes it is however many ticks REVERSE_DEAD_TIME takes, and a tick that
                # has to retry the port is not a poll period -- it is up to 1.2s at
                # roof_timeout's ceiling. Guessing that window is how OPEN_SETTLE's budget
                # came to fire mid-stroke on a healthy open, and there is no need to guess
                # it: nothing is energized until this line, so the generous entry budget
                # bounds the right thing there.
                #
                # The kick plus roofBlindDriveBudget(), not the two poll periods the other
                # re-bases use, because this deadline is checked before the phase body and
                # would otherwise pre-empt it. A tick that has to retry the port arrives
                # seconds late; it then finds the kick clock expired and calls stopHalf() in
                # that same tick, so the relay comes off at the same instant either way --
                # the only difference a tighter bound makes is that the motion latches a
                # fault instead of going on to the rod. That is a spurious latch bought for
                # nothing, and at roof_timeout's ceiling one slow tick is 1.2s against the
                # 1.0s two poll periods would allow, so it would still happen rather than
                # being an edge case. roofBlindDriveBudget() is
                # already the answer to "how long may a contactor stay closed while ticks
                # and status are not landing" -- the run phases hold their relays on it --
                # and it is derived from the poll, so a site configured slow is not punished.
                # 4.2s at the setting floors, on a tick that lands. A lock held by somebody
                # else adds up to roofStopBudget() on top -- ~7s at the same values -- because
                # enforceRoofStopWithoutLock() is reached only once serviceRoofOnce()'s
                # acquire has given up, so the wedged worker named above really costs ~11s.
                # One acquire timeout and not a repeating one: the tick that fails to take
                # the lock stops the roof from there. Said out loud because this is the line
                # a reader takes a number from, and the mechanism above is what makes the
                # number bigger than it looks. The budget this replaced carried the same
                # term, so it was ~37.5s rather than 30.5s and the re-base still cuts the
                # worst case by better than 3x.
                roofMotion.deadline = now + kick + roofBlindDriveBudget()
                log(logging.INFO, "Roof open [{}]: driving OPEN for a {:.1f}s kick".format(
                    half.value.lower(), kick))
            return
        if now < roofMotion.phaseDeadline:
            return
        roofInstance.stopHalf(half)
        # From here the phase is bounded by the rod, not by the dead time. drive() enforces
        # REVERSE_DEAD_TIME by itself when OPEN_RUN comes to energize the relay again, and
        # a rod stroke is an order of magnitude longer than it anyway.
        rodTimeout = numericSetting("roof_rod_timeout", 30)
        roofMotion.phaseDeadline = now + rodTimeout
        # Re-based on what is left to do, exactly as CLOSE_TIGHTEN is and for the same
        # reason. roofOpenPrepBudget() is a sum of everything before OPEN_RUN with one poll
        # period of margin, and a poll period is not what a tick costs: a tick that has to
        # retry the port spends 2 * (WRITE_RETRIES + 1) * roof_timeout inside itself, which
        # is 0.8s at roof_timeout 0.2 and 1.2s at its ceiling. Two of those and the prep budget
        # runs out mid-stroke, on a rod still well inside its own deadline, and the fault
        # blames the half for not getting off its seat. Nothing unsafe -- both relays are off
        # here -- but a flaky board turning a working open into a latched fault is the same
        # kind of wrong answer that made the prep budget necessary in the first place.
        #
        # Set rather than cleared: it is what arms enforceRoofStopWithoutLock(), which is the
        # only thing that can end this sequence while the worker is wedged holding roofLock.
        # Two poll periods, so the phase's own deadline above is always the one that fires on
        # a healthy worker and the accurate message is the one the operator sees.
        roofMotion.deadline = now + rodTimeout + 2 * roofPollPeriod
        enterMotionPhase(MotionPhase.OPEN_SETTLE, log,
                         "kick done, relays off, holding for the rod stroke")
        return

    if phase is MotionPhase.OPEN_SETTLE:
        if not roofMotion.rodSent:
            # The kick ran its full length and no tick in it got the extend acknowledged,
            # so there is no stroke to wait for. Without this the phase would sit out
            # roof_rod_timeout and then blame the rod for not finishing something it never
            # started -- or worse, find REQ clear (it was never set) and the closed
            # switches clear (the kick alone can shake them off a half that is stuck a
            # little past them) and promote to OPEN_RUN, running the half open on gravity
            # having never pushed it. Failing costs nothing here: the kick already ended
            # with stopHalf(), so both relays are off.
            failRoofMotion(roofInstance,
                    "the {} rod never accepted its extend command".format(
                        half.value.lower()), log, event)
            return
        if roofMotion.phaseDeadline is None:
            # Only reachable if the phase was entered without going through the kick, which
            # nothing does now that roof_kick_time has a floor. Bounded anyway.
            roofMotion.phaseDeadline = now + numericSetting("roof_rod_timeout", 30)
            return
        if status is None:
            if now > roofMotion.phaseDeadline:
                failRoofMotion(roofInstance,
                        "no status while waiting for the {} rod to finish its stroke".format(
                            half.value.lower()), log, event)
            return
        if roofInstance.rodExtendRequested(half, status=status):
            # Still driving out. The firmware clears this bit when it auto-retracts at the
            # end of the stroke (Motor::update(), MAX_EXTENDED), and that transition is the
            # only "fully extended" signal the board offers -- there is no position sensor
            # on the rod. Waiting for it is what distinguishes a half that has been properly
            # shoved from one that merely twitched off its switches.
            if now > roofMotion.phaseDeadline:
                failRoofMotion(roofInstance,
                        "{} rod did not finish its stroke within {:.0f}s".format(
                            half.value.lower(), numericSetting("roof_rod_timeout", 30)),
                        log, event)
            return
        # Stroke complete, and the rod is already on its way back under its own timer -- no
        # retract is sent, since one now would only restart the firmware's 20 s
        # confirmation clock for nothing.
        if any(status[sw.bit] for sw in half.closedSwitches):
            # The rod has pushed as hard as it is ever going to and the half is still on
            # its seat. This is the "something is terribly wrong" case.
            failRoofMotion(roofInstance,
                    "{} half still reports closed after a full rod stroke".format(
                        half.value.lower()), log, event)
            return
        # Gravity's run gets the whole travel budget, exactly as CLOSE_RUN does. Everything
        # up to here was on the prep budget, so how long the kick and the stroke took
        # cannot shorten the run -- which it silently did, leaving as little as half of
        # roof_travel_timeout for the only phase that is actually travel.
        roofMotion.deadline = now + numericSetting("roof_travel_timeout", 90)
        roofMotion.phaseDeadline = None
        enterMotionPhase(MotionPhase.OPEN_RUN, log,
                         "rod stroke complete and the half is off its seat, "
                         "travel budget starts")
        return

    if phase is MotionPhase.OPEN_RUN:
        if status is None:
            blindRunTooLong(roofInstance, now, half, log, event)
            return
        roofMotion.blindSince = None
        if roofInstance.halfPosition(half, status=status) is roof.RoofState.OPEN:
            roofInstance.stopHalf(half)
            log(logging.INFO, "Roof open [{}]: fully open, relays off".format(
                half.value.lower()))
            startRoofMotionHalf(now, log, event)
            return
        if roofMotion.phaseDeadline is not None and now > roofMotion.phaseDeadline and any(
                status[sw.bit] for sw in half.closedSwitches):
            # Back on its seat. OPEN_SETTLE proved this half off its closed switches before
            # promoting, so a switch reading engaged again means the drive has let go and
            # gravity has taken the half home. There is no counterpart to CLOSE_RUN's start
            # check here -- departure is a precondition of this phase, so a copy of it would
            # find the seat switches already clear on the first tick and have nothing to
            # test -- but the hazard the check below covers is the same one CLOSE_RUN's
            # deadline covers on its side: a motor energized for the rest of
            # roof_travel_timeout against a half going nowhere. Both are one deadline read
            # as "you are back where you started, with the motor pulling"; the two phases
            # differ only in which end that is and in whether the start of the phase already
            # counts as being there.
            failRoofMotion(roofInstance,
                    "{} half is back on its closed switches during the open run".format(
                        half.value.lower()), log, event)
            return
        started = roofInstance.drive(half, roof.Direction.OPEN)
        if started and not roofMotion.runLogged:
            roofMotion.runLogged = True
            # Grace before the check above arms. Right after the rod stroke the half is
            # barely clear of its seat, and a switch flickering back as it settles must not
            # fail a working open. roof_close_start_timeout is borrowed rather than given a
            # sibling setting: it already means "how long a half may take to be visibly
            # under way", which is the same question. Unlike CLOSE_RUN's use of it, this
            # deadline is never retired -- sliding back is what happens *after* the half
            # was moving.
            roofMotion.phaseDeadline = now + numericSetting("roof_close_start_timeout", 10)
            log(logging.INFO, "Roof open [{}]: driving OPEN, gravity has it".format(
                half.value.lower()))
        return

    if phase is MotionPhase.CLOSE_RODCLEAR:
        if status is None:
            if now > roofMotion.phaseDeadline:
                failRoofMotion(roofInstance,
                        "no status while waiting for the {} rod to retract".format(
                            half.value.lower()), log, event)
            return
        if roofInstance.rodRetracted(half, status=status):
            roofMotion.deadline = now + numericSetting("roof_travel_timeout", 90)
            roofMotion.phaseDeadline = None
            enterMotionPhase(MotionPhase.CLOSE_RUN, log,
                             "rod confirmed retracted, travel budget starts")
            return
        if not roofInstance.rodExtendRequested(half, status=status):
            # Already on its way back; the firmware just has not confirmed it yet. Sending
            # another retract would restart its 20 s confirmation timer for nothing.
            if now > roofMotion.phaseDeadline:
                failRoofMotion(roofInstance,
                        "{} rod did not confirm retracted within {:.0f}s".format(
                            half.value.lower(), roofRodClearBudget), log, event)
            return
        log(logging.INFO, "Roof close [{}]: retracting the rod before closing".format(
            half.value.lower()))
        roofInstance.retractRod(half)
        return

    if phase is MotionPhase.CLOSE_RUN:
        if status is None:
            blindRunTooLong(roofInstance, now, half, log, event)
            return
        roofMotion.blindSince = None
        if roofInstance.halfPosition(half, status=status) is roof.RoofState.CLOSED:
            # Keep pulling. The board's switches are informational and the motor has its
            # own internal end stop, so overrunning them is what seats the half tight.
            overrun = numericSetting("roof_close_overrun", 2)
            roofMotion.phaseDeadline = now + overrun
            # Re-based on what is left to do rather than on whatever remained of the travel
            # budget. A close that spent nearly all of it getting here would otherwise be
            # failed for a deliberate two-second overrun -- a fault reporting a close that
            # worked, on a half already on its switches, and the reset means the second half
            # never runs at all. It cannot extend an expired budget: the check above runs
            # first, so this transition is only reached on a tick that had time left.
            #
            # roofBlindDriveBudget() for the margin, exactly as OPEN_KICK's re-base uses it
            # and for the identical reason -- these are the two phases whose own deadline
            # expiring is how they *succeed*, and the outer one is checked before the phase
            # body, so a margin thinner than a slow tick turns a finished close into a
            # latched fault. Two poll periods is 1.0s and one failed exchange is
            # (WRITE_RETRIES + 1) * roofTimeoutsPerAttempt * roof_timeout, which is 0.8s at
            # the shipped 0.2 and 1.2s at the ceiling, before any scheduling delay: at the
            # ceiling a single failed poll landing on the tick that should have seated the
            # half was enough, and the fault bought no relay time, because that same tick
            # goes on to call stopHalf() anyway. What it cost instead was the rest of the
            # motion -- failRoofMotion() resets the sequence, so the first half seats, the
            # second never starts, and the roof is left half-shut and latched.
            #
            # OPEN_SETTLE keeps its two poll periods on purpose: reaching its outer deadline
            # is a failure whichever of the two fires, so pre-empting it only picks a
            # slightly different message.
            roofMotion.deadline = now + overrun + roofBlindDriveBudget()
            enterMotionPhase(MotionPhase.CLOSE_TIGHTEN, log,
                             "closed switches engaged, pulling {:.1f}s past them".format(
                                 overrun))
            return
        onOpen = any(status[sw.bit] for sw in half.openSwitches)
        if roofMotion.phaseDeadline is not None and now > roofMotion.phaseDeadline and onOpen:
            # The half is sitting on its open switches with the motor pulling: the belt is
            # slipping, the motor is not turning, or the drive is disconnected. Running it
            # for the rest of the travel budget against a half that is not moving is exactly
            # what must not happen, so this ends now rather than at the outer deadline.
            #
            # Gated on onOpen, and that gate is what makes this the mirror of OPEN_RUN's
            # back-on-its-seat check rather than only a start check. The deadline used to be
            # retired to None the moment the half was confirmed off its switches, so
            # everything after that point was on roof_travel_timeout alone -- a half that got
            # under way and then slid back down onto its open switches was driven for up to
            # the whole 90s with nothing looking at it. That is the same hazard OPEN_RUN
            # names on the other side, and the same reading is available here; retiring the
            # deadline was what threw it away. Left standing instead, it costs nothing while
            # the half is off its switches and fires the moment one engages again.
            #
            # No fresh grace on the way back, exactly as OPEN_RUN gives none: settling
            # flicker happens in the seconds right after departure, which are inside the
            # grace this deadline already carries, and a switch engaging long afterwards is
            # not flicker.
            if roofMotion.departed:
                reason = "{} half is back on its open switches during the close run".format(
                        half.value.lower())
            else:
                reason = "{} half still reports open {:.0f}s after closing started".format(
                        half.value.lower(), numericSetting("roof_close_start_timeout", 10))
            failRoofMotion(roofInstance, reason, log, event)
            return
        started = roofInstance.drive(half, roof.Direction.CLOSE)
        if started and onOpen and roofMotion.phaseDeadline is None:
            # Armed whenever the half is on its open switches with the contactor closed, not
            # only on the first tick of the phase. A half that started part-way arms nothing
            # below, so without this a slide back down to fully open would land with no
            # deadline to fire -- the one case the gate above could not otherwise cover.
            roofMotion.phaseDeadline = now + numericSetting("roof_close_start_timeout", 10)
            if roofMotion.runLogged:
                log(logging.WARNING, "Roof close [{}]: on its open switches with the motor "
                    "pulling, {:.0f}s to leave them".format(
                        half.value.lower(), numericSetting("roof_close_start_timeout", 10)))
            else:
                roofMotion.runLogged = True
                log(logging.INFO, "Roof close [{}]: driving CLOSE, pulling the half up".format(
                    half.value.lower()))
        elif started and not roofMotion.runLogged:
            roofMotion.runLogged = True
            # Nothing to depart from, so no check to arm yet. The whole of it is "you are on
            # your open switches, leave them within N seconds"; a half that starts this phase
            # between switches has no such reading, and arming anyway meant the retirement
            # fired in the same tick off the same clear switches -- the check never existed,
            # and the log claimed a departure nothing watched.
            #
            # Reachable for any half that is not fully open when a close starts: a roof
            # picked up part-way, one moved by hand, or one a teardown left mid-travel --
            # which every settings save can produce, since makeRoof() stops a running motion
            # whatever it was doing.
            #
            # Nothing better is available for the stretch it is actually in. With only end
            # switches, no reading distinguishes a mid-travel half being pulled from one
            # hanging still, which is exactly what OPEN_RUN says above. So the run is on
            # roof_travel_timeout alone until the half reaches an end position, and that is
            # said out loud rather than left to be inferred.
            log(logging.INFO, "Roof close [{}]: driving CLOSE from part-way; no departure "
                "to confirm, the travel budget is the only bound".format(
                    half.value.lower()))
        elif started and not onOpen and roofMotion.phaseDeadline is not None and (
                not roofMotion.departed):
            # Confirmed moving. The deadline is deliberately *not* retired -- see the gate
            # above for what retiring it used to cost -- so this flag is what keeps the line
            # to one per half instead of one per tick for the rest of the travel.
            #
            # elif, so this can only be reached on a tick after the one that armed it. Both
            # were plain ifs once, and the second read the phaseDeadline the first had just
            # set. The onOpen gate on the arming is what makes it honest; this is what makes
            # a confirmation impossible to issue before there has been anything to confirm.
            roofMotion.departed = True
            log(logging.INFO, "Roof close [{}]: confirmed off its open switches".format(
                half.value.lower()))
        return

    if phase is MotionPhase.CLOSE_TIGHTEN:
        if now < roofMotion.phaseDeadline:
            return
        roofInstance.stopHalf(half)
        log(logging.INFO, "Roof close [{}]: seated and relays off".format(half.value.lower()))
        startRoofMotionHalf(now, log, event)
        return

def stopRoofMotion(roofInstance, log, event):
    """Drops every motion relay and abandons the sequence. Needs no status, and no port.

    Which is why it is a function of its own rather than a branch of
    executeMotionCommand(): it has to work on a tick whose poll failed, and that is
    precisely the tick on which a half may be energized with nothing left to notice.

    The de-energize is unconditional. A stop is a panic button, not a phase transition, so
    it does not first ask what the sequence thinks it is doing -- stopMotion() drives all
    four relays off whatever the answer, and a sequence that believes itself idle while a
    contactor is closed is exactly the state a stop exists to end. Only the bookkeeping is
    conditional: a FAULT phase is left standing as the record of how the last motion
    ended, because clearing that is Roof.clearMotionFault() and an operator's decision.

    The rods used to be retracted from here and are now serviceRoofOnce()'s, which is the
    only thing that knows whether the "rods" mailbox key is also asking for them. Two call
    sites in one tick meant the same rod was retracted twice -- and, when the first attempt
    failed, the re-post was consumed by the very tick that made it. One site per tick makes
    the count of serial exchanges in a lock hold a fixed number rather than one that depends
    on which branch failed, which is what roofMaxExchangesPerTick has to be able to state.
    Nothing is lost here: the relays are the part of a stop that must not wait, and they
    come off above with four local GPIO writes that need neither the board nor the port.
    """
    running = roofMotion.running
    if running:
        log(logging.WARNING, "Roof motion stopped on request during {}".format(
            roofMotion.phase.name))
    else:
        log(logging.INFO, "Roof stop requested with no motion running; de-energizing anyway")
    roofInstance.stopMotion()
    if running:
        roofMotion.reset()
        event("roofMotionStopped")

def executeMotionCommand(roofInstance, status, action, postedAt, log, event):
    """Starts a roof motion. Runs with roofLock held on the worker thread.

    Opens and closes only. A stop cannot arrive here at all: it lives under its own mailbox
    key, which takeRoofCommands() does not hand out, and stopRoofMotion() carries it out
    from takeRoofStop() before the status is even examined.
    """
    age = time.monotonic() - postedAt
    if age > roofMotionCommandMaxAge():
        # Queued while the board was not answering: the mailbox holds a command until
        # there is a status to judge it against, and that wait is unbounded. The roof may
        # have been moved by hand since, and one that starts moving a minute after it was
        # asked to is worse than one that refuses. Said out loud rather than dropped
        # quietly, so the operator learns their command went nowhere.
        log(logging.WARNING,
            "Dropping the roof {} asked for {:.0f}s ago, too old to act on".format(action, age))
        event("roofMotionError", "Roof {} was dropped, it was {:.0f}s old".format(action, age))
        return
    if not roofInstance.motionReady:
        # The latch on the Roof is the authority here, not the phase: an operator can
        # clear it, and this must then let a motion through.
        log(logging.ERROR, "Refusing to {} the roof: motion is faulted ({})".format(
            action, roofInstance.motionFaultReason))
        event("roofMotionError", roofInstance.motionFaultReason)
        return
    if roofMotion.phase is MotionPhase.FAULT:
        # Cleared on the Roof but the sequence still remembers how it ended. Drop it, so
        # the refusal above is the only thing that ever blocks a motion.
        roofMotion.reset()
    if roofMotion.running:
        log(logging.WARNING, "Refusing to {} the roof: a {} is already in progress".format(
            action, roofMotion.action))
        event("roofMotionError", "A roof motion is already in progress")
        return
    target = roof.RoofState.OPEN if action == "open" else roof.RoofState.CLOSED
    if roofInstance.position(status=status) is target:
        # Named from the state that was just compared, not from the action: "close" is a
        # verb and reads as "Roof is already close".
        log(logging.INFO, "Roof is already {}".format(target.name.lower()))
        event("roofMotionDone", action)
        return
    roofMotion.reset()
    roofMotion.action = action
    roofMotion.queue = list(roofMotionOrder[action])
    log(logging.INFO, "Roof {} requested".format(action))
    startRoofMotionHalf(time.monotonic(), log, event)

def requestRoofMotion(action):
    """Asks the roof to open or close, or stops it outright. Returns whether it was taken.

    The return value is for callers that have to answer somebody: the API says 503 or 409
    rather than 202 on the strength of it. The UI ignores it and waits for the events, which
    is still the only way to learn what actually happened -- an open that is accepted here
    can still be refused a tick later by a status this thread has not seen.

    Open and close are fire and forget, exactly like setFans(): the worker owns the serial
    port and the relays, judges the command against a status it has just read, and reports
    back through events. All three callers go through here -- the operator controls, the
    API and the rain interlock's automatic close -- which is what makes this the place the
    rain refusal below can be enforced once rather than in each of them.

    **A stop is not fire and forget, on purpose.** It needs no worker, no serial port, no
    status and no lock, because de-energizing is four local GPIO writes -- and every
    situation where a stop matters most is one where the mailbox does not work: a board
    that has stopped answering, a worker wedged in a serial read, a worker that has died
    outright. So a stop goes straight to the relays here, on the caller's thread, and is
    posted as well so the worker abandons its sequence when it next runs. If it never runs
    again, the roof is still stopped.
    """
    if action not in ("open", "close", "stop"):
        logger.error("Ignoring unknown roof motion {}".format(action))
        triggerEvent("roofMotionError", "Unknown roof motion")
        return False
    if action == "stop":
        # Fetched once, into a local, rather than asked for at each of the three points
        # below. isInitialized() followed by get() is a check then a use, and what runs in
        # between is makeRoof() on the settings thread: Roof.reset() clears _instance
        # *first* (deliberately -- see there) and only then closes the port and builds a
        # replacement, so the window is a serial close and a serial open wide. Landing in
        # it used to make get() raise "No roof instance initialized" inside the try, which
        # the handler below reported as a relay that would not come off -- it had, reset()
        # de-energizes on its way out -- and then re-raised out of the stop button from the
        # except itself, where nothing catches it. The one control that has to work when
        # everything else is broken must not be the one that crashes.
        try:
            roofInstance = roof.Roof.get()
        except Exception as e:
            # Nothing to de-energize: Roof.reset() drives all four pins off as it drops
            # the instance, so there is no roof left holding a relay closed. True both for
            # a roof that was never configured and for one being replaced right now.
            logger.warning("Roof stop requested with no roof initialized ({}), "
                           "nothing to de-energize".format(e))
            triggerEvent("roofMotionError", "Roof not initialized")
            return
        try:
            # Deliberately without roofLock. roofLock serializes the board and the relays,
            # but a motion relay left energized is a roof still moving with nothing left to
            # stop it, and this call cannot hang and only ever drives pins to OFF -- the
            # worst a race with the worker can do is stop the roof twice. The same
            # reasoning stopRoof() already uses on its own lock-timeout path. That covers
            # the losing side of the race above too: if this is an instance reset() has
            # already discarded, every write here is a pin driven to OFF a second time.
            roofInstance.stopMotion()
            logger.warning("Roof stopped on request, motion relays de-energized")
        except Exception as e:
            # Every relay was attempted before this raised; stopMotion() collects the
            # failures rather than giving up on the first. A relay that would not come off
            # must refuse further motion, so this latches as well as reporting.
            logger.error("Error de-energizing the roof on a stop request: {}".format(e))
            roofInstance.faultMotion("could not de-energize on a stop request: {}".format(e))
            triggerEvent("roofMotionError", "Could not de-energize the roof: {}".format(e))
        # The arrows come from the relays, and the worker may never run again to publish
        # this itself -- a wedged or dead worker is exactly why a stop comes through here.
        publishRoofDrive(roofInstance)
        # The rods are the other half of stopping, and they are the part this thread may
        # not do: they live on the board, behind the port, behind the lock. Left for the
        # worker. If it never runs again the firmware retracts them on its own timer.
        requestRodRetract()
        # Posted regardless, so the worker drops whatever sequence it is running. Without
        # it the machine would keep ticking and OPEN_RUN would energize the half again on
        # its next pass -- though not immediately, because stopMotion() has just stamped
        # the dead time and drive() refuses for REVERSE_DEAD_TIME, which is four poll
        # periods. takeRoofStop() runs before the machine on every tick, so the stop is
        # always taken first and the half never comes back on.
        #
        # Through postRoofStop() rather than the "motion" key this used to share with an
        # open or a close: sharing it let a motion requested a moment later overwrite the
        # stop outright, and the half came back on when the dead time ran out. See there.
        postRoofStop()
        return True
    if not roofEngaged:
        # Refused here as well as in drive(), which is the interlock. This one exists so the
        # operator is told why rather than watching the command disappear into a mailbox and
        # come back a tick later as a latched fault from a relay write that raised.
        logger.warning("Not requesting roof {}: the roof is disengaged".format(action))
        triggerEvent("roofMotionError", "The roof is disengaged")
        return False
    reason = roofUnavailableReason()
    if reason is not None:
        # Posting anyway would drop the command into a mailbox with no worker to drain it,
        # and the caller would see nothing wrong while nothing happened.
        logger.warning("Not requesting roof {}: {}".format(action, reason))
        triggerEvent("roofMotionError", reason)
        return False
    if action == "open":
        held = rainInterlockReason()
        if held is not None:
            # The second half of the interlock, and the half that is actually load bearing.
            # Closing the roof on rain is worth little if anything can open it again a
            # second later, and this is where "anything" is held to the rule: the buttons
            # and the API both arrive here, so neither can be more permissive than the
            # other, and a page that has not repainted since it started raining still has a
            # live Open button on it. Exactly the reasoning processRoofCommand() re-tests
            # the moving-roof block for rather than trusting a disabled button.
            #
            # Last of the refusals, so that the reason given is the most specific one that
            # applies: a roof that is disengaged or has no worker is not going to open for
            # reasons that outrank the weather, and saying "rain" there would send an
            # operator to look at a sensor when the problem is elsewhere.
            logger.warning("Not opening the roof: {}".format(held))
            triggerEvent("roofMotionError", "Cannot open the roof: {}".format(held))
            return False
    logger.info("Requesting roof {}".format(action))
    # Stamped, so a command that sat in the mailbox through a board outage is dropped by
    # executeMotionCommand() instead of starting a motion long after it was asked for.
    postRoofCommand("motion", (action, time.monotonic()))
    return True

def requestRoofEngaged(engaged: bool):
    """Hands the roof to the operator, or takes it back. Returns whether it happened.

    Disengaging is a stop plus a latch, and it is done on the caller's own thread for the
    same reason a stop is: what has to happen is that four contactors open, that is four
    local GPIO writes, and none of it may be made to wait on a serial port, a lock, or a
    worker that may be wedged. Somebody is about to put their hands on the roof.

    Engaging is only the flag and the strike counter. Nothing is energized by engaging --
    the roof sits where it is until it is commanded -- so there is nothing here that has to
    happen promptly, and the checks come back on with the next poll.
    """
    global roofEngaged
    if not roof.Roof.isInitialized():
        # Nothing to hand over. The flag is still set, because a roof built later must come
        # up in the state the operator last asked for rather than in the default one.
        roofEngaged = engaged
        logger.warning("Roof {} requested with no roof initialized".format(
            "engaged" if engaged else "disengaged"))
        triggerEvent("roofMotionError", "Roof not initialized")
        return False
    try:
        roofInstance = roof.Roof.get()
    except Exception as e:
        roofEngaged = engaged
        logger.warning("Roof {} requested while the roof was being replaced ({})".format(
            "engaged" if engaged else "disengaged", e))
        return False
    # Set before the relays are touched, not after: from this instant every path that could
    # energize one has to find the roof disengaged, and drive() reads the instance's own
    # copy which disengage() sets first for the same reason.
    roofEngaged = engaged
    if engaged:
        roofInstance.engage()
        logger.warning("Roof re-engaged: the safety checks and motion handling are back on")
        triggerEvent("roofEngaged", True)
        return True
    ok = True
    try:
        roofInstance.disengage()
        logger.warning("Roof disengaged: motion relays de-energized and the safety checks "
                       "are off until it is engaged again")
    except Exception as e:
        # Every relay was attempted before this raised -- stopMotion() collects failures
        # rather than stopping at the first -- and the refusal to drive is already in force.
        # Still reported as a failure, because a contactor that would not open is the one
        # thing an operator about to touch the roof must not be told went fine.
        ok = False
        logger.error("Error de-energizing the roof while disengaging it: {}".format(e))
        triggerEvent("roofMotionError",
                     "Disengaged, but a motion relay would not de-energize: {}".format(e))
    # The arrows come off the relays, and the worker may not run again to publish it.
    publishRoofDrive(roofInstance)
    # The rods are the part that needs the board, so they go through the mailbox exactly as
    # a stop's do; and the stop itself, so a sequence still running is abandoned rather than
    # left to discover on its next tick that drive() has started refusing.
    requestRodRetract()
    postRoofStop()
    triggerEvent("roofEngaged", False)
    return ok

def requestClearRoofFault():
    """Asks the worker to clear the motion fault latch. Returns whether it was posted.

    Through the mailbox rather than straight at the Roof, unlike a stop. Clearing a fault is
    not urgent -- nothing is energized and nothing is waiting on it -- and it has to happen
    beside the sequence's own FAULT phase, which only the worker may touch: it reads the
    sequence for a whole tick under roofLock, so clearing it from another thread is the
    unsynchronized write that stopRoof() had to be fixed for.
    """
    reason = roofUnavailableReason()
    if reason is not None:
        # Nothing would drain the mailbox, and the operator would be looking at a fault that
        # stayed put with no sign that their button did anything.
        logger.warning("Not clearing the roof fault: {}".format(reason))
        triggerEvent("roofMotionError", reason)
        return False
    if not roofEngaged:
        logger.warning("Not clearing the roof fault: the roof is disengaged")
        triggerEvent("roofMotionError", "The roof is disengaged")
        return False
    logger.info("Requesting a roof fault clear")
    postRoofCommand("clearfault", True)
    return True

def executeFanCommand(roofInstance, status, mode, auto, log, event):
    """Switches the fans unless the just-polled status says they are already there.

    Runs on the roof worker thread with roofLock held, hence the deferred log/event
    collectors. Returns the status the board reported after the command, or None if
    nothing was sent.

    Acts on the roofInstance the caller was given, for the same reason serviceRoofOnce
    does: a worker that outlived its stopRoof() must not switch the fans on a roof that
    has since replaced the one it was started for.
    """
    global lastFanChange
    fansAreOn = roofInstance.fansAreOn(status=status)
    wantOn = mode == "on"
    if wantOn == fansAreOn:
        log(logging.DEBUG, "Fan state already as requested")
        return None
    if wantOn and auto and not roofInstance.isFullyClosed(status=status):
        # Auto mode decided from a snapshot up to roofStateMaxAge old; this status is
        # current. Re-checking is free here and closes the window in which the roof
        # started opening between the decision and the command. Manual commands are
        # not second-guessed -- switching the fans on with the roof open has always
        # been the operator's call to make.
        log(logging.WARNING, "Refusing to switch fans on in auto mode, roof is not fully closed")
        event("fanError", mode, "Roof is not fully closed")
        return None
    log(logging.INFO, f"Switching fans {mode}")
    newStatus = roofInstance.fansOn() if wantOn else roofInstance.fansOff()
    lastFanChange = time.monotonic()
    event("fanUpdate", mode, auto)
    return newStatus

def enforceRoofStopWithoutLock(roofInstance):
    """Stops the roof from serviceRoofOnce()'s lock-timeout path, where nothing else can.

    Two things have to happen even when roofLock cannot be taken, because both are about a
    half that is energized right now and neither of them needs the board:

    * A stop waiting in the mailbox. requestRoofMotion() has already de-energized the
      relays on the caller's thread, but the sequence is worker state and only the worker
      may drop it -- and while it stands, the first tick that does get the lock would
      drive the half again.
    * A travel budget that has run out. Every deadline in the sequence is enforced by
      advanceRoofMotion(), which runs under the lock, so while the lock is held by
      something else -- an abandoned worker wedged in a serial read is the case that
      actually happens -- a half stays energized with nothing checking how long it has
      been there. That one latches a motion fault as well as stopping, for the reasons
      given where it does it.

    Deliberately without the lock, on the reasoning stopRoof() already uses for its own
    timeout path: roofLock serializes the board and the relays, but stopMotion() is a local
    GPIO write that cannot hang and only ever drives pins to OFF, so the worst a race with
    whoever holds the lock can do is stop the roof twice.

    Runs on the worker thread with no lock held, so it logs and fires events directly
    rather than through the deferred collectors.
    """
    stopped = takeRoofStop()
    # A phase with no outer budget has both relays off -- CLOSE_RODCLEAR waiting on the rod
    # is still the only one -- so there is nothing there to time out. The open path holds a
    # budget throughout for exactly this reason: OPEN_KICK energizes a relay, and this is
    # the only thing that can drop it while the lock is held elsewhere.
    expired = (roofMotion.running and roofMotion.deadline is not None
               and time.monotonic() > roofMotion.deadline)
    if not stopped and not expired:
        return
    if stopped:
        logger.warning("Roof stop carried out without the roof lock")
    try:
        roofInstance.stopMotion()
    except Exception as e:
        # A relay that would not come off has to refuse further motion, exactly as it does
        # on the in-lock path. faultMotion() tries every relay again and never raises.
        logger.error("Error de-energizing the roof without the lock: {}".format(e))
        roofInstance.faultMotion("could not de-energize the roof without the lock: {}".format(e))
    if expired and not stopped:
        # Latched, not merely stopped. advanceRoofMotion() puts this same condition through
        # failRoofMotion() and refuses further motion afterwards; this path used to end in a
        # plain reset, so the *milder* failure -- worker healthy, budget blown -- latched
        # while the worse one did not. A budget running out here means a half stayed
        # energized for its whole travel while the lock was held by something else (an
        # abandoned worker wedged in a serial read is the case that happens), so the roof's
        # position is not known and the board is not answering: precisely the state that
        # must not take another command. Unlatched it could re-arm indefinitely, each pass
        # costing another full travel budget of pulling on a half that may already be sat
        # on its end stop, with nothing but drive()'s REVERSE_DEAD_TIME in between.
        #
        # Only when no stop is pending. A stop has already de-energized the relays on the
        # caller's thread, and it cannot clear this deadline from there -- the sequence is
        # worker state -- so a stop landing just after the budget lapsed would otherwise
        # fault a roof the operator had correctly stopped. The stop is the better account
        # of that tick, and it is the one that keeps the roof usable.
        #
        # failRoofMotion() resets the sequence, requests the rod retract and raises the
        # event itself; it only wants collectors that fire now rather than after a lock
        # release, and logger.log and triggerEvent take exactly what the deferred ones do.
        failRoofMotion(roofInstance, "{} half did not finish its {}: the budget ran out "
                       "while the roof lock was unavailable".format(
                           roofMotion.half.value.lower(), roofMotion.action),
                       logger.log, triggerEvent)
        # Published from here too: this path returns before serviceRoofOnce() gets to do it.
        publishRoofDrive(roofInstance)
        return
    # Dropped here rather than left for a tick that may never come. The relays are off;
    # leaving the sequence standing would only let it energize them again.
    if roofMotion.running:
        roofMotion.reset()
    publishRoofDrive(roofInstance)
    # No lock here either, so the rods go back on the mailbox rather than to the port.
    requestRodRetract()
    triggerEvent("roofMotionStopped")

def serviceRoofOnce(roofInstance, generation):
    """One status poll plus whatever commands are pending, in a single lock hold.

    The status the poll just returned is what the commands are judged against, so a
    command costs at most one extra serial exchange and never needs a status read of
    its own. Only this thread talks to the board, so the lock is all but uncontended;
    it is still taken because a makeRoof()/stopRoof() whose thread join timed out can
    reach the port while this thread is still running.

    Works on the roofInstance its caller was given rather than on roof.Roof.get(): the
    singleton can be replaced under a worker that outlived its stopRoof(), and such a
    worker must not end up driving the roof that replaced it.

    Returns False when the lock could not be taken and this worker is still the live one,
    True otherwise -- including a superseded worker that could not take it. That return is
    what lets roofLoop() count a timeout as a failure: it used to return None here and the
    loop read that as success, reset its failure count and never backed off -- so an
    abandoned worker holding the lock cost a blocking acquire and a log record every
    roofStopBudget() seconds, indefinitely. Being superseded returns True on purpose: the
    loop's own generation check ends it on the next pass, and inflating the backoff of a
    worker that is leaving would only delay its exit.
    """
    global lastRoofState, lastRoofStateTime, lastRoofIconUpdate, lastRoofDrive
    log = DeferredLog()
    event = DeferredEvents()
    if not roofLock.acquire(timeout=roofStopBudget()):
        if generation != roofGeneration:
            # Superseded, and this is the one action in a tick that was not gated on that.
            # Everything below it is -- the mailbox, the machine, the publish -- and this
            # needs it for the same reason and one more.
            #
            # The same reason: roofInstance is the Roof *this* worker was started for, and
            # a superseded worker is one stopRoof() has already retired. Its stopMotion()
            # therefore drives four pins that may no longer be the roof's at all.
            # Roof.reset() calls releaseMotionRelays(), which clears the on-destroy intent
            # but leaves the Switch objects able to write, so a save that moved a motion pin
            # to a device switch leaves this path de-energizing that device instead. That is
            # precisely the failure releaseMotionRelays() exists to prevent at collection
            # time, and this was a live path around it.
            #
            # The one more: takeRoofStop() *consumes*. A stop taken here is a stop the live
            # worker never sees, carried out against a roof that no longer exists -- and the
            # expired branch below is worse still, latching a fault on the retired instance
            # while resetting the sequence the live one is running. Leaving the stop in the
            # mailbox costs it nothing: requestRoofMotion() de-energized on the caller's own
            # thread before ever posting, so the relays are already off, and the mailbox
            # holds a stop until a worker that can act on it does.
            return True
        # A pending stop and an expired travel budget both have to be acted on even here,
        # where the machine cannot run at all. Without the lock, deliberately -- see there.
        # Only the live worker gets this far, which is the only one it can be right for.
        enforceRoofStopWithoutLock(roofInstance)
        # Reported by the caller, not here: this is the failure that repeats every poll
        # for as long as the lock is held, and it has to go through the same rate limit
        # as the exceptions rather than emitting a blocking log write each time.
        return False
    drive = None
    pollError = None
    try:
        try:
            status = roofInstance.getStatus()
        except Exception as e:
            # Caught rather than allowed to propagate, so that the motion machine below
            # still runs on this tick. Its timers have to keep firing and its relays have
            # to keep coming off when the board goes away -- that is precisely the moment
            # a half must not be left driving. Re-raised after the lock is released, so
            # the caller still counts and rate-limits the failure exactly as before.
            status = None
            pollError = e
        if generation != roofGeneration:
            # Superseded while this read was in flight. The mailbox is deliberately left
            # untouched: takeRoofCommands() removes what it hands out, so taking commands
            # here would either drop them or run them against a roof that is being
            # replaced. The worker that replaced this one carries them out instead.
            log(logging.INFO, "Roof worker superseded mid-poll, discarding the result")
            return True
        # Taken before the status is even looked at, and before the machine is advanced.
        # Before the status, because a stop needs none and the tick whose poll just failed
        # is the one an operator most wants it to work on. Before the machine, because
        # otherwise a phase could energize a half on the very tick the stop arrived.
        stopped = takeRoofStop()
        if stopped:
            try:
                stopRoofMotion(roofInstance, log, event)
            except Exception as e:
                # A relay write failed while stopping. That is the one failure that has to
                # latch: faultMotion() tries every relay again and refuses further motion
                # until an operator has looked at it.
                failRoofMotion(roofInstance, f"could not stop roof motion: {e}", log, event)
        if stopped and status is None:
            # The relays are off, but the rods live on the board and this tick has no
            # reading to say which of them are out. Left for one that has: the firmware
            # retracts each by itself after MAX_EXTENDED regardless, so this only makes it
            # prompt. Posted here rather than below because the mailbox is not taken at all
            # on a tick without a status.
            requestRodRetract()
        # Taken after the poll, so that a command posted while it was in flight is
        # picked up now, and so a failed poll leaves the mailbox untouched for the
        # next attempt. A command that fails once it has been taken is reported and
        # dropped rather than retried, matching what the old blocking setFans() did.
        #
        # Only with a status in hand: every command is judged against the reading the
        # poll just returned, and a motion started blind is a motion started against an
        # unknown roof.
        if status is not None:
            commands = takeRoofCommands()
            if stopped or "rods" in commands:
                # The one place rods are retracted, whether this tick's stop wants it or a
                # "rods" key left by a path that could not reach the board itself --
                # requestRoofMotion()'s stop posts both, so the two used to fire in the same
                # tick and retract every rod twice, the second time off a status read before
                # the first had gone out.
                #
                # A failure re-posts rather than retrying here, and it matters that this sits
                # *after* takeRoofCommands(): posting before it would have the same tick
                # consume the request it had just made, which is the immediate retry the
                # "left for a tick that can" rule exists to avoid. It is still attempted only
                # once per tick and never chased forever -- the firmware retracts each rod by
                # itself after MAX_EXTENDED, so this only ever makes it prompt.
                #
                # The status comes back because the retracts have just invalidated the one
                # this tick polled, and the phase machine below reads it. See there.
                ok, status = retractRoofRods(roofInstance, status, log)
                if not ok:
                    requestRodRetract()
            if "clearfault" in commands:
                # Both halves of "an operator has been and looked": the latch on the Roof,
                # which is what refuses motion, and the sequence's own FAULT phase, which is
                # only the record of how the last one ended. executeMotionCommand() already
                # drops that phase when it finds it, so this is not what lets the next
                # motion start -- it is what stops the status reading fault until one does.
                #
                # Before the motion below, so a clear and an open pressed in quick
                # succession still work when they land in the same tick. That does not let
                # a motion past a live fault: the poll at the top of this tick has already
                # re-run the consistency checks, and a condition that is still there has
                # already re-latched by the time this line runs.
                try:
                    roofInstance.clearMotionFault()
                    if roofMotion.phase is MotionPhase.FAULT:
                        roofMotion.reset()
                    event("roofFaultCleared")
                except Exception as e:
                    log(logging.ERROR, "Error clearing the roof motion fault: {}".format(e))
                    event("roofMotionError", "Could not clear the fault: {}".format(e))
            if "fans" in commands:
                mode, auto = commands["fans"]
                try:
                    newStatus = executeFanCommand(roofInstance, status, mode, auto, log, event)
                    if newStatus is not None:
                        status = newStatus
                except Exception as e:
                    log(logging.ERROR, f"Error switching fans {mode}: {e}")
                    event("fanError", mode, str(e))
            if "motion" in commands:
                # Only ever an open or a close: a stop is posted under its own key, so this
                # one cannot hold one however the two were interleaved.
                action, postedAt = commands["motion"]
                try:
                    executeMotionCommand(roofInstance, status, action, postedAt, log, event)
                except Exception as e:
                    failRoofMotion(roofInstance, f"could not start roof {action}: {e}",
                                   log, event)
        try:
            advanceRoofMotion(roofInstance, status, log, event)
        except Exception as e:
            # A relay write that raised, most likely. The roof is mid-motion with at
            # least one contactor possibly still energized, so this cannot be logged and
            # shrugged off: fault it, which de-energizes everything and refuses any
            # further motion until an operator has looked.
            failRoofMotion(roofInstance, f"error during roof motion: {e}", log, event)
        drive = {half: roofInstance.driving(half) for half in roof.RoofHalf}
    finally:
        roofLock.release()
        log.flush()
        event.flush()
    if pollError is not None:
        # The drive state is published even so. It comes from the relays, not from the
        # board, so a board that stopped answering says nothing about it -- and this is
        # precisely the path on which the motion machine has just de-energized a half.
        # Leaving it stale would keep an arrow pulsing for a roof that has already
        # stopped, which is the one thing the arrows must never do.
        #
        # The status goes out as the last one actually read, which is what the indicators
        # are already showing. lastRoofStateTime is deliberately not touched, so
        # updateRoofStaleness() still reports the reading as exactly as old as it is.
        if drive != lastRoofDrive:
            lastRoofDrive = drive
            triggerEvent("roofUpdate", lastRoofState)
        # The poll is still a failed poll. Raised out here, with the lock released and the
        # deferred log and events already flushed, so the caller's counter and rate limit
        # see it exactly as they did before the motion machine existed.
        raise pollError
    if generation != roofGeneration:
        # Checked once more: a command can take a second or two, and being replaced during
        # one must not let this thread publish over what its replacement has written.
        logger.info("Roof worker superseded, not publishing its last poll")
        return True
    # The drive state is part of what changed, not just the status word. Which way a half
    # is being driven is a Pi relay, invisible to the board, so a motion starting or
    # stopping moves no status bit at all -- and without this an arrow could take up to
    # roofIconUpdateInterval to appear, or worse, to go away once a half has stopped.
    changed = status != lastRoofState or drive != lastRoofDrive
    lastRoofState = status
    lastRoofDrive = drive
    lastRoofStateTime = time.monotonic()
    now = time.monotonic()
    if changed or now - lastRoofIconUpdate > roofIconUpdateInterval:
        triggerEvent("roofUpdate", status)
        lastRoofIconUpdate = now
    return True

def roofLoop(stopEvent, roofInstance, generation):
    """The roof worker. Everything it needs is an argument, nothing is looked up.

    stopEvent is this worker's own, so a worker that stopRoof() signalled stays signalled
    no matter what the next one does. roofInstance is the Roof it was started for, so
    makeRoof()'s Roof.reset() cannot leave it operating on a roof other than the one it was
    given. generation is what makes a worker that could not be joined harmless: it stops
    polling as soon as it no longer matches roofGeneration.

    A worker whose join timed out normally leaves through the stop event, which stays set.
    The generation check is what covers the window that event cannot: the poll already in
    flight when the replacement was built.
    """
    # Paced on a deadline rather than by sleeping a fixed gap after each poll: the
    # period then stays constant regardless of how long a poll takes, instead of
    # being (gap + poll). Waiting on the stop event rather than time.sleep() also
    # makes shutdown immediate instead of up to one period late.
    #
    # Commands are picked up by the next iteration, so a posted command waits one poll
    # period -- or, while the board is failing and the backoff has grown, up to
    # roofPollPeriod * roofPollBackoffMax. Waiting out the backoff is the right
    # behaviour anyway: the board is not answering, and hammering it would not help.
    nextPoll = time.monotonic() + roofPollPeriod
    failures = 0
    while True:
        if stopEvent.wait(max(0.0, nextPoll - time.monotonic())):
            break
        if generation != roofGeneration:
            logger.warning(
                    "Roof worker {} superseded by {}, exiting".format(generation, roofGeneration))
            break
        try:
            # Logging is a blocking write, so a board that is down must not be
            # allowed to emit one record per poll: that would stall this loop on the
            # log handler on top of whatever is already wrong with the serial port.
            # Both kinds of failure go through the one counter and the one rate limit --
            # a lock the poll could not take is as much a failed poll as an exception,
            # and it is the kind that repeats for as long as the trouble lasts.
            if serviceRoofOnce(roofInstance, generation):
                failures = 0
            else:
                failures += 1
                if failures == 1 or failures % roofPollLogEvery == 0:
                    logger.warning(
                            "Timeout acquiring roof lock for status poll "
                            "({} in a row)".format(failures))
        except Exception as e:
            failures += 1
            if failures == 1 or failures % roofPollLogEvery == 0:
                logger.error("Error in roof thread ({} in a row): {}".format(failures, e))
        now = time.monotonic()
        if roofMotion.running:
            # Never back off with the roof in motion. The backoff exists so a dead board
            # is not hammered, but the motion machine's phases are timed off this tick:
            # at roofPollBackoffMax the interval reaches ~5 s, and a 2 s kick evaluated on
            # a 5 s tick is a 5 s kick. A half that is moving gets the full poll rate
            # whatever the board is doing.
            nextPoll += roofPollPeriod
            if nextPoll <= now:
                nextPoll = now + roofPollPeriod
            continue
        # Back off while the board is unhappy, so a dead port is polled every few
        # seconds rather than continuously.
        # The exponent is capped as well as the result. failures climbs for as long as the
        # board is down -- a day of it is ~170k consecutive failures -- and 2 ** that is a
        # 17,000-bit integer built from scratch every pass only to be thrown away by the
        # min(). 16 is already far past roofPollBackoffMax, so no value this can return
        # changes.
        nextPoll += roofPollPeriod * min(2 ** min(failures, 16), roofPollBackoffMax)
        if nextPoll <= now:
            # Fell behind: a poll overran its slot. Resync so catch-up polls cannot
            # run back to back and starve other threads of roofLock.
            nextPoll = now + roofPollPeriod

def reapAbandonedRoofThreads():
    """Drops abandoned workers that have since exited, and reports that they did.

    An abandoned worker is not necessarily lost: one stuck in a serial read leaves as soon
    as that read returns, because its stop event is still set and its generation is stale.
    Saying so matters as much as reporting the abandonment -- otherwise the log only ever
    shows the roof getting worse.
    """
    global abandonedRoofThreads
    if not abandonedRoofThreads:
        return
    alive = [thread for thread in abandonedRoofThreads if thread.is_alive()]
    gone = len(abandonedRoofThreads) - len(alive)
    if gone > 0:
        logger.info("{} abandoned roof worker(s) have exited, {} still running".format(
            gone, len(alive)))
    abandonedRoofThreads = alive

def stopRoof():
    global roofThread, roofStopEvent, roofGeneration, roofLock, lastRoofStateTime, lastRoofDrive
    # Anything still pending was meant for the roof that is going away, and the fans
    # are about to be switched off regardless.
    clearRoofCommands()
    # Before the join, not after: from here on any worker still running is superseded,
    # whether it manages to stop or not, and must not publish or execute anything more.
    roofGeneration += 1
    reapAbandonedRoofThreads()
    if roofThread is not None and roofThread.is_alive():
        logger.info("Stopping roof thread")
        # This worker's own event, and it stays set: makeRoof() gives the next worker a
        # fresh one instead of clearing this, so a worker that could not be joined below
        # cannot be woken up again by the next initialization.
        roofStopEvent.set()
        budget = roofStopBudget()
        roofThread.join(timeout=budget)
        if roofThread.is_alive():
            # Kept, not forgotten. It is superseded and cannot act, but it is still a
            # thread and it is probably holding roofLock inside a serial read, which is
            # why the next makeRoof() may not get the lock. Counting them turns a wedged
            # bridge from something invisible into something the log states outright.
            abandonedRoofThreads.append(roofThread)
            logger.error(
                    "Roof worker did not stop within {:.1f}s and was abandoned "
                    "({} abandoned in total). The serial port is most likely wedged; "
                    "the roof may not come back before OMS is restarted".format(
                        budget, len(abandonedRoofThreads)))
        else:
            logger.info("Roof stopped")
        # Either way this name no longer refers to a worker anything should join or
        # signal: a successful stop leaves none, and an abandoned one is tracked above.
        roofThread = None
    # After the join, not before. A worker that is mid-tick has already passed its last
    # generation check -- serviceRoofOnce()'s, a few lines above its publish -- and goes on
    # to write lastRoofState, lastRoofDrive and a fresh timestamp whatever this function
    # does to them in the meantime, so clearing them ahead of the join clears nothing. Here
    # neither kind of worker can: a joined one no longer exists, and an abandoned one is
    # already retired by the generation bump above. The window this closes is widest exactly
    # when it matters, because a tick can spend a whole roofStopBudget() in serial retries,
    # and it is the reason getRoofState() has a timestamp to gate on at all -- a client
    # connecting after the roof went away must not be handed convincing limit-switch icons
    # and a pulsing drive arrow for a roof that is not there.
    #
    # The roofUpdate(None) at the end of this function still fires after these, so a client
    # repainting off that event reads the cleared state rather than the one being cleared.
    lastRoofStateTime = 0.0
    lastRoofDrive = {half: None for half in roof.RoofHalf}
    # Read here for the same reason the two clears above are, and it is the same window:
    # advanceRoofMotion() runs before serviceRoofOnce()'s last generation check, so a worker
    # that was mid-tick when the bump landed can still move the sequence on afterwards. Read
    # before the join and this would be a phase the roof has already left. The residue that
    # leaves is immaterial to what it is for -- the worst an abandoned worker can cost is a
    # message naming the phase the motion was in one tick ago, and it is reported either way.
    #
    # Only what is needed to describe the motion, not the RoofMotion itself, which the reset
    # below is about to empty.
    abortedMotion = (roofMotion.action, roofMotion.phase) if roofMotion.running else None
    log = DeferredLog()
    if roofLock.acquire(timeout=roofStopBudget()):
        try:
            # The sequence belonged to the roof that is going away, and it is dropped here
            # rather than at the top of this function, where it used to be written with no
            # lock at all. The worker reads the sequence for its whole tick inside this same
            # lock -- deadline, then phase, then that phase's own deadline -- so an
            # unsynchronized reset could land between two of those reads and leave it
            # comparing a time against None. makeRoof() resets it again before it starts a
            # worker, which is what covers the branch below where this lock was not granted.
            roofMotion.reset()
            if roof.Roof.isInitialized():
                # Motion first: it is a local GPIO write that cannot hang, while
                # fansOff() talks to a board that may be wedged. Guarded separately so
                # that neither failure can stop the other from being attempted -- and
                # so that a dead board cannot make stopRoof() raise, which used to
                # propagate out of makeRoof() and block re-initialization entirely.
                try:
                    roof.Roof.get().stopMotion()
                except Exception as e:
                    log(logging.ERROR, f"Error stopping roof motion: {e}")
                # The other half of stopping a motion, and the half every other stop path
                # already asks for -- through the mailbox, because none of them may touch
                # the port. This one has just joined the worker, so there is nobody left to
                # drain a mailbox and the retract has to be sent from here or not at all.
                #
                # After the relays and before the fans: the relays are local GPIO writes
                # that cannot hang, so they go first whatever else fails, while these two
                # both talk to a board that may be wedged. Rods before fans because a rod
                # left out is in the way of the next close -- CLOSE_RODCLEAR waits the
                # firmware's whole 20 s clock out for it -- whereas fans left on are
                # switched off by the next poll of a roof that comes back.
                #
                # The reset above means roofMotion.running is False, so retractRoofRods()
                # applies no exception here and every extended rod comes back, which is
                # what a teardown wants: the open this might have interrupted is over.
                try:
                    retractRoofRodsPolled(roof.Roof.get(), log)
                except Exception as e:
                    log(logging.WARNING, f"Error retracting the roof rods while stopping: {e}")
                try:
                    roof.Roof.get().fansOff()
                except Exception as e:
                    log(logging.WARNING, f"Error switching fans off while stopping roof: {e}")
        finally:
            roofLock.release()
            log.flush()
    else:
        logger.error(
                "Timeout acquiring roof lock while stopping roof; de-energizing the motion "
                "relays without it, the fans may still be on")
        # Deliberately outside the lock. roofLock serializes access to the board and the
        # relays, but a motion relay left energized is a roof still moving with nothing
        # left to stop it, and this is the path where the worker could not be joined --
        # so it is very likely still driving. stopMotion() is a local GPIO write that
        # cannot hang and only ever drives pins to OFF, so the worst a race with the
        # abandoned worker can do is stop the roof twice. fansOff() stays inside the
        # lock, because it talks to a board that may be wedged.
        if roof.Roof.isInitialized():
            try:
                roof.Roof.get().stopMotion()
            except Exception as e:
                logger.error("Error stopping roof motion without the lock: {}".format(e))
    triggerEvent("roofUpdate", None)
    if abortedMotion is not None:
        # This was the one way a motion could end having raised no event at all.
        # stopRoofMotion() fires roofMotionStopped, failRoofMotion() and
        # abandonFaultedMotion() fire roofMotionError, startRoofMotionHalf() fires
        # roofMotionDone -- but a roof torn down under a running sequence simply went quiet.
        # Every settings save does exactly this, whether or not the roof was moving, and
        # makeRoof() gives no sign either: the operator saw "Applying settings ...", then a
        # green "Settings applied", with a half stopped mid-travel. Nothing survived it,
        # because the reset leaves the sequence IDLE rather than FAULT, so not even a latch
        # remained to be found afterwards.
        #
        # Fired from here rather than beside the reset, because the reset is in two places:
        # the lock branch does it, and the lock-timeout branch deliberately leaves it to
        # makeRoof(). The motion is over on both -- the worker is retired by the generation
        # bump above and the relays are de-energized on either branch -- so the report
        # belongs where it is true of both, which is here.
        #
        # roofMotionError rather than roofMotionStopped because only that one carries a
        # payload, and the phase is the whole of what makes this readable after the fact. A
        # negative notification is the right weight too: nothing is unsafe, the relays are
        # off, but the roof has been left somewhere nobody asked for it to be.
        #
        # Worded without a cause. stopRoof() has two callers -- makeRoof() on a settings save
        # and shutdown() -- and naming the wrong one is worse than naming neither.
        action, phase = abortedMotion
        logger.warning("Roof {} aborted in {}: the roof was taken down while it was "
                       "running; a half may be left part-way".format(action, phase.name))
        triggerEvent("roofMotionError",
                     "the {} was stopped in {} because the roof was taken down; a half may "
                     "be left part-way".format(action, phase.name))


# Held for the length of one stopRoofForExit(). Taken without blocking, so a second signal
# arriving while the first is still being handled goes straight on to the exit rather than
# waiting behind a serial exchange -- a second Ctrl-C means "stop asking", and by then the
# relays are already off anyway.
roofExitStopLock = threading.Lock()

def stopRoofForExit(reason):
    """Stops the roof and sends its rods back, on the way out. Moves nothing.

    Named for what it does after the first name for it -- parkRoof -- turned out to read,
    in a shutdown log at seven in the morning, as though OMS were about to drive the roof
    to a park position. It is not: there is exactly one motion call in here and it is the
    stop. Nothing below opens or closes anything, and the roof is left precisely where the
    signal found it, with every contactor open. The only thing that travels is a push rod
    returning home, and only if one was still out.

    Two things, and the order is the whole design. The motion relays come off first,
    because RPi.GPIO leaves pin state exactly as it found it when the process dies: a half
    that is being driven when OMS is killed keeps being driven, with nothing left running to
    stop it at the far switch. Then the rods go back, which is a matter of not leaving the
    next close to wait the firmware's clock out rather than a matter of safety.

    Runs on whatever thread signalled -- the main one, inside a signal handler -- so nothing
    here may block on a lock another thread holds indefinitely, and nothing may raise.
    requestRoofMotion("stop") is already built to exactly that standard: it de-energizes
    with four local GPIO writes on the caller's own thread, takes no lock to do it, and
    posts the stop so a worker that is still alive abandons its sequence instead of
    re-energizing the half on its next tick. This is the situation that path was written
    for, so it is used rather than reimplemented.

    The rods are the part that needs the port, and therefore the lock and a board that
    answers. Bounded, and skipped when the lock cannot be had: this must not become the
    thing that stops the process exiting. requestRoofMotion() has already left a mailbox
    request, so a live worker retracts them anyway, and the firmware retracts them after 20 s
    whatever anybody manages here. This only makes it prompt in the case where no worker is
    left, which is most of them.
    """
    if not roofExitStopLock.acquire(blocking=False):
        logger.warning("Already stopping the roof for exit, ignoring: {}".format(reason))
        return
    try:
        logger.warning("Stopping the roof for exit: {}".format(reason))
        try:
            requestRoofMotion("stop")
        except Exception as e:
            # requestRoofMotion() is written not to raise on its stop path, precisely
            # because it is the control that has to work when everything else is broken.
            # Guarded anyway: this one is called from a signal handler, where an exception
            # would propagate into whatever the main thread was doing.
            logger.error("Error stopping the roof on the way out: {}".format(e))
        if not roof.Roof.isInitialized():
            return
        try:
            roofInstance = roof.Roof.get()
        except Exception as e:
            # The same check-then-use window requestRoofMotion() documents: makeRoof() can
            # clear the singleton in between. Nothing is left holding a relay if so --
            # Roof.reset() de-energizes on its way out -- so there is nothing left to stop.
            logger.warning("No roof to retract the rods of on the way out ({})".format(e))
            return
        budget = roofStopBudget()
        try:
            acquired = roofLock.acquire(timeout=budget)
        except Exception as e:
            # OwnerTrackingLock raises on a reentrant acquire. The main thread does not take
            # roofLock -- the worker and the makeRoof()/stopRoof() lifecycle do, and the
            # lifecycle runs in a thread -- so this is unreachable rather than merely
            # unlikely, and it is caught because a signal handler is the wrong place to
            # find out it was reachable after all.
            logger.error("Could not take the roof lock to retract the rods: {}".format(e))
            return
        if not acquired:
            logger.error(
                    "Timeout ({:.1f}s) taking the roof lock on the way out; the rods were "
                    "not retracted from here. A running worker still has the request, and "
                    "the firmware retracts them on its own timer".format(budget))
            return
        log = DeferredLog()
        try:
            retractRoofRodsPolled(roofInstance, log)
        except Exception as e:
            log(logging.ERROR, "Error retracting the rods on the way out: {}".format(e))
        finally:
            roofLock.release()
            log.flush()
    finally:
        roofExitStopLock.release()

# The signals that mean the process is going away, in the order of how likely they are to
# be the one that arrives. SIGHUP is the reason this list is not just the two uvicorn
# already handles: nothing installs a handler for it, so its default action terminates the
# process outright -- no graceful shutdown, no on_shutdown, no teardown of any kind, and a
# half left driving. getattr because SIGHUP does not exist everywhere, even though this
# only ever runs on a Pi.
exitSignals = tuple(sig for sig in (
        getattr(signal, "SIGTERM", None),
        getattr(signal, "SIGINT", None),
        getattr(signal, "SIGHUP", None),
        ) if sig is not None)

def installExitSignalHandlers():
    """Stops the roof on the way out, whatever the way out turns out to be.

    Chained rather than replacing: uvicorn installs its own SIGINT and SIGTERM handlers
    when it starts serving, and they are how a graceful shutdown begins at all. Ours runs
    first, stops the roof, and then hands the signal to whatever was there before, so the
    normal teardown -- shutdown(), which stops the workers and closes the ports -- happens
    exactly as it did.

    Which means this is not the only thing that stops the roof, and it is not meant to be.
    stopRoof() does the same job on the graceful path and does it better, with the worker
    joined first. This exists for the paths where that never runs: a SIGHUP, a second Ctrl-C
    that sets uvicorn's force_exit, a graceful shutdown that wedges on something else. The
    cost of it being redundant is one status poll; the cost of it being absent is a roof
    left moving.

    Installed from on_startup, which is late enough to see uvicorn's handlers and early
    enough that the roof exists. signal.signal() only works on the main thread, which is
    where on_startup runs.
    """
    for sig in exitSignals:
        try:
            previous = signal.getsignal(sig)
            signal.signal(sig, makeExitSignalHandler(sig, previous))
        except (ValueError, OSError) as e:
            # Not fatal. A signal that cannot be hooked leaves the roof exactly as
            # unprotected as it was before this function existed, and saying so in the log
            # is worth more than refusing to start over it.
            logger.error("Could not install a handler for {}: {}".format(
                signal.Signals(sig).name, e))

def makeExitSignalHandler(sig, previous):
    def handler(signum, frame):
        stopRoofForExit("received {}".format(signal.Signals(signum).name))
        if callable(previous):
            # uvicorn's handle_exit, or Python's default SIGINT handler, which raises
            # KeyboardInterrupt from here. Either way the normal shutdown carries on.
            previous(signum, frame)
            return
        if previous == signal.SIG_IGN:
            # Somebody deliberately wanted this signal ignored. Stopping the roof anyway is
            # the safe reading of a signal that arrived; terminating over it is not.
            return
        # SIG_DFL, which for all three of these means terminate. Put it back and re-raise
        # against ourselves, so the process dies the way it would have without this handler
        # -- including the exit status, which a sys.exit() here would get wrong.
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
    return handler


def makeRoof():
    global roofThread, roofStopEvent, lastRoofState, lastRoofStateTime
    stopRoof()
    # Read and validate the settings before taking the lock: roofLock is there to
    # serialize access to the board and the relays, and none of this touches either.
    config = readRoofConfig()
    log = DeferredLog()
    event = DeferredEvents()
    if not roofLock.acquire(timeout=roofStopBudget()):
        # The old Roof instance survives this return -- reset() is a few lines below,
        # inside the lock this call could not get -- so isInitialized() alone would
        # still read True here. roofUnavailableReason() covers exactly this: roofThread
        # is already None from stopRoof() above, so a fan command posted after this
        # point is refused rather than silently dropped into a mailbox nothing drains.
        msg = ("Timeout acquiring roof lock while (re-)initializing roof; the roof stays "
               "unusable until the next successful save")
        logger.error(msg)
        triggerEvent("error", msg)
        triggerEvent("roofUpdate", None)
        return False
    try:
        # The old roof goes away even when the new configuration turns out to be
        # unusable: stopRoof() has already joined the worker, so keeping the instance
        # would leave a roof that reports itself initialized with nothing polling it.
        roof.Roof.reset()
        # Belt and braces for stopRoof()'s lock-timeout branch, which skips its own reset:
        # a worker wedged in a serial read can still write the sequence after that branch
        # gives up, and this is the last moment before a new worker exists to read it.
        roofMotion.reset()
        if config is None:
            event("roofUpdate", None)
            return False
        try:
            roof.Roof(**config)
            instance = roof.Roof.get()
            if not roofEngaged:
                # A Roof is born engaged, and this is the only place one is born. Without
                # this line a settings save re-arms the motion relays of a roof an operator
                # has deliberately handed themselves -- silently, while they are working on
                # it, and with nothing on screen changing to say so. Applied before the
                # first status is read, so the consistency checks below stay quiet too:
                # a roof somebody is moving by hand is exactly what they assert against.
                instance.disengage()
                log(logging.WARNING,
                    "Roof rebuilt while disengaged; it stays disengaged and nothing will "
                    "drive it until it is engaged again")
            # Publish the first status here rather than leaving the state unknown
            # until the worker's first poll: the auto mode can then act right away.
            #
            # This read is also where the roof is picked up as it was found. Its
            # consistency checks run inside getStatus(), so a roof that comes up with a
            # broken switch or in an impossible position latches the motion fault before
            # anything has a chance to command a motion -- no extra code needed here.
            lastRoofState = instance.getStatus()
            lastRoofStateTime = time.monotonic()
            found = instance.position(status=lastRoofState)
            if found is roof.RoofState.UNKN:
                # Neither fully open nor fully closed. Nothing is assumed and nothing is
                # commanded: an operator decides what to do with a roof found part-way.
                log(logging.WARNING,
                    "Roof is neither fully open nor fully closed; no motion will be "
                    "offered until an operator resolves it")
            else:
                log(logging.INFO, "Roof picked up {}".format(found.name.lower()))
            # Said plainly, every startup. Starting OMS observes the roof and drives
            # nothing: the sequence begins IDLE, the four relays were de-energized as they
            # were constructed a few lines above, and no motion exists that could resume --
            # a motion lives only in this process, so a restart cannot inherit one.
            log(logging.INFO,
                "Roof motion is idle at startup, nothing is being driven; motion is {}".format(
                    "ready" if instance.motionReady
                    else "REFUSED: " + str(instance.motionFaultReason)))
            event("roofUpdate", lastRoofState)
            # Started while the lock is held, deliberately: roofLoop() waits a poll
            # period before its first acquire and the lock is released a few
            # instructions from here, so the new worker cannot actually contend for it.
            log(logging.INFO, "Starting roof thread")
            # A fresh event per worker, handed to the worker as an argument, rather than
            # clearing a shared one. A previous worker that stopRoof() signalled but could
            # not join is still waiting on *its* event: clearing that same object here used
            # to un-signal it, so the orphan resumed polling and two workers then drove one
            # board. The module-level name is only ever "the current worker's event", for
            # stopRoof() to signal.
            workerStopEvent = threading.Event()
            roofStopEvent = workerStopEvent
            # stopRoof() bumped the generation at the top of this call, so this worker
            # takes the current value and every older one is already superseded.
            roofThread = threading.Thread(
                    target=roofLoop,
                    args=(workerStopEvent, instance, roofGeneration),
                    name="OMS roof worker",
                    daemon=True
                    )
            roofThread.start()
            log(logging.INFO, "Roof thread started")
        except Exception as e:
            log(logging.ERROR, "Could not initialize roof: {}".format(e))
            roofThread = None
            roof.Roof.reset()
            # The status read above may already have published a state and a fresh
            # timestamp before this failed. Zero it, exactly as stopRoof does, so
            # getRoofState() cannot hand out a current-looking reading for a roof that
            # does not exist.
            lastRoofStateTime = 0.0
            event("roofUpdate", None)
            return False
    finally:
        roofLock.release()
        log.flush()
        event.flush()

    fans = s.q("fan_mode", fallback=None)
    if fans is not None:
        applyFanMode(fans)
    return True


def setFans(mode, auto=False):
    """Asks the roof worker to switch the fans. Returns without touching the roof.

    Fire and forget: the worker reports the outcome through the fanUpdate/fanError and
    roofUpdate events, the same ones a status poll already raises, so there is nothing
    for callers to wait on.
    """
    if mode not in ("on", "off"):
        # fan_mode comes out of persisted settings, so a hand-edited or stale value can
        # get here. The worker reads anything that is not "on" as off, which is not a
        # decision to make on a typo.
        logger.error(f"Ignoring unknown fan mode {mode}")
        triggerEvent("fanError", mode, "Unknown fan mode")
        return
    reason = roofUnavailableReason()
    if reason is not None:
        # Posting anyway would drop the command silently -- roofUnavailableReason()
        # covers the roof-worker-not-running case getRoofState() cannot: isInitialized()
        # alone would still be true for a Roof left behind by a makeRoof() that timed out
        # taking roofLock, and the mailbox would then have no worker left to drain it.
        logger.debug(f"Not requesting fans {mode}: {reason}")
        triggerEvent("fanError", mode, reason)
        return
    logger.info(f"Requesting fans {mode}")
    postRoofCommand("fans", (mode, auto))


def applyFanMode(mode):
    """Applies a fan mode. Returns immediately and never touches the roof itself: the
    auto path decides from the worker's published state, the manual path posts a
    command, so this is safe to call from the event loop and from a worker thread.

    Deliberately does not persist the mode: a settings write triggers NiceGUI's
    persistent-storage backup, which schedules the file write with
    core.loop.create_task(). Off the event loop that is not thread safe -- it raises
    nothing, it just queues the write on the loop without waking it, so the file lands
    whenever the loop next happens to wake for unrelated reasons (checked against
    nicegui 3.15.0: a write from a worker thread was still missing from disk half a
    second later). makeRoof() calls this from a worker thread, so callers persist the
    mode themselves, on the event loop, beforehand.
    """
    logger.info(f"Switching fan mode to {mode}")
    if mode == "auto":
        updateFans()
        return
    setFans(mode)



