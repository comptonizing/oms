    async def update(thing: list):
        logger.debug("Processing event: {}".format(thing))
        if thing[0] == "setSwitchState":
            ui.notify(f"Switch {thing[1]} was turned {thing[2]}")
            updateButtons()
            return
        if thing[0] == "updateSettings":
            processSettingsUpdate()
            return
        if thing[0] == "roofUpdate":
            updateRoofIcons(thing[1])
            return
        if thing[0] == "fanUpdate":
            print("FAN UPDATE")
            ui.notify(f"Fans set to {thing[1]} ({"auto" if thing[2] else "manual"})")
            return
        logger.error(f"Unknown update event, ignoring: {thing}")

    updateCallbacks[ui.context.client.id] = update

    tabs.set_value("Status")

