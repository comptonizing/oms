    async def _updatePlots(api):
        r = weather_range_select.value
        w = weather_ranges[r]
        # Zero, not 0.3. These sit after queries, and awaiting a query already hands the
        # loop to everything else; fifteen of them cost 4.5s of a pass that is otherwise
        # dominated by five figure pushes. Kept as explicit yield points rather than
        # deleted, because that is what they are for -- see pushPlot for the real pause.
        sleepTime = 0

        plot = weather_plots["Temperature"]
        fig = plot.figure
        fig.update_yaxes(title_text="Temperature (°C)")
        fig.data = []
        t, v = await queryWeather(api, "env_temperature", r, w)
        await asyncio.sleep(sleepTime)
        logger.debug("Plotting Temperature Air")
        fig.add_scatter(x=t, y=v, mode="lines", name="Air", line={"color": "green"})
        logger.debug("Done")
        t, v = await queryWeather(api, "env_dewpoint", r, w)
        await asyncio.sleep(sleepTime)
        logger.debug("Plotting Temperature Dewpoint")
        fig.add_scatter(x=t, y=v, mode="lines", name="Dewpoint", line={"color": "orange"})
        logger.debug("Done")
        t, v = await queryWeather(api, "inside_temperature", r, w)
        await asyncio.sleep(sleepTime)
        logger.debug("Plotting Temperature Inside")
        fig.add_scatter(x=t, y=v, mode="lines", name="Inside", line={"color": "blue"})
        logger.debug("Done")
        await pushPlot(plot)

        plot = weather_plots["Sky"]
        fig = plot.figure
        fig.update_yaxes(title_text="Temperature (°C)")
        fig.data = []
        t, v = await queryWeather(api, "ir_sky", r, w)
        await asyncio.sleep(sleepTime)
        logger.debug("Plotting Sky Sky")
