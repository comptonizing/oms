    def runRoofCommand(action: str):
        """Carries out one roof command. Everything that asks has already asked."""
        if action == "stop":
            requestRoofMotion("stop")
            return
        if action in ("open", "close"):
            requestRoofMotion(action)
            return
        if action == "reset":
            requestClearRoofFault()
            return
        if action in ("engage", "disengage"):
            requestRoofEngaged(action == "engage")
            return
        if action in ("rain-override", "rain-arm"):
            setRainOverride(action == "rain-override")
            return
        logger.error("Ignoring unknown roof command from the UI: {}".format(action))

    def processRoofCommand(action: str):
        """One click on one roof button.

        The block is re-tested here rather than left to the disabled state of the button.
        Disabling is what tells the operator; this is what enforces it. A page that has not
        repainted since the roof started moving still has live buttons on it, and the whole
        rule is that nothing but a stop may be asked for while a contactor is closed.
        """
        if action != "stop" and roofCommandsBlocked():
            ui.notify("The roof is moving. Stop it first.", type="warning")
            return
        if action == "stop":
            # Straight through, no dialog. See roofCommandPrompts.
            runRoofCommand(action)
            return
        title, question = roofCommandPrompts[action]
        with ui.dialog() as dialog, ui.card():
            ui.label(title).classes('text-lg font-bold')
            ui.label(question).classes('max-w-sm')
            with ui.row().classes('w-full gap-2'):
                ui.button("No", on_click=dialog.close).classes("flex-1")
                def accept():
                    dialog.close()
                    # Tested again on the way out of the dialog: a confirmation is a
                    # question and the operator may have taken a moment over it, and the
                    # roof can have started moving in the meantime.
                    if roofCommandsBlocked():
                        ui.notify("The roof started moving. Stop it first.", type="warning")
                        return
                    runRoofCommand(action)
                ui.button("Yes", on_click=accept).classes("flex-1")
        dialog.open()

