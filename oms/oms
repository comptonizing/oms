    def updateWeather():
        labelSize = "text-3xl"
        try:
            data = apiv1.weather()
            if data.status_code != 200:
                raise Exception("Error getting weather: Status code 200: {}".format(data.body))
            try:
                d = json.loads(data.body)
            except Exception as e:
                raise Exception("Error parsing json: {}".format(e))
        except Exception as e:
            logger.warning("Error getting weather data: {}".format(e))
            for thing in weather_labels.values():
                thing.set_text("Error")
                thing.classes(labelSize + " text-red-500")
            return
        try:
            temperature = d["env_temperature"]
            colstr = ""
            if temperature < -20:
                colstr = "text-red-500"
            elif temperature < -10:
                colstr = "text-orange-500"
            elif temperature < 25:
                colstr = "text-green-500"
            elif temperature < 35:
                colstr = "text-orange-500"
            else:
                colstr = "text-red-500"
            weather_labels["env_temperature"].set_text("{:.1f} °C".format(temperature))
            weather_labels["env_temperature"].classes(labelSize + " " + colstr)

            humidity = d["env_humidity"]
            if humidity < 10:
                colstr = "text-red-500"
            elif humidity < 20:
                colstr = "text-orange-500"
            elif humidity < 80:
                colstr = "text-green-500"
            elif humidity < 90:
                colstr = "text-orange-500"
            else:
                colstr = "text-red-500"
            weather_labels["env_humidity"].set_text("{:.1f} %".format(humidity))
            weather_labels["env_humidity"].classes(labelSize + " " + colstr)

            dewpoint = d["env_dewpoint"]
            weather_labels["env_dewpoint"].set_text("{:.1f} °C".format(dewpoint))
            weather_labels["env_dewpoint"].classes(labelSize)

            rain = d["rain_percentage"]
            if rain < 5:
                colstr = "text-green-500"
            elif rain < 10:
                colstr = "text-orange-500"
            else:
                colstr = "text-red-500"
            weather_labels["rain_percentage"].set_text("{:.0f} %".format(rain))
            weather_labels["rain_percentage"].classes(labelSize + " " + colstr)

            elevation = s.q("weather_elevation")
            pressure = d["env_pressure"] + ((d["env_pressure"] * 9.80665 * elevation)/(287 * (273 + temperature + (elevation/400))))
            weather_labels["env_pressure"].set_text("{:.0f} hPa".format(pressure))
            weather_labels["env_pressure"].classes(labelSize)

            sqm = d["sqm_mpsas"]
            if sqm < 18:
                colstr = "text-red-500"
            elif sqm < 20:
                colstr = "text-orange-500"
            else:
                colstr = "text-green-500"

            weather_labels["sqm_mpsas"].set_text("{:.1f}".format(sqm))
            weather_labels["sqm_mpsas"].classes(labelSize + " " + colstr)

            ir_sky = d["ir_sky"]
            weather_labels["ir_sky"].set_text("{:.1f} °C".format(ir_sky))
            weather_labels["ir_sky"].classes(labelSize)

            ir_diff = d["ir_diff"]
            if ir_diff < 15:
                colstr = "text-red-500"
            elif ir_diff < 20:
                colstr = "text-orange-500"
            else:
                colstr = "text-green-500"
            weather_labels["ir_diff"].set_text("{:.1f} °C".format(ir_diff))
            weather_labels["ir_diff"].classes(labelSize + " " + colstr)

            wind_speed = d["wind_speed"]
            if wind_speed < 15:
                colstr = "text-green-500"
            elif wind_speed < 20:
                colstr = "text-orange-500"
            else:
                colstr = "text-red-500"
            weather_labels["wind_speed"].set_text("{:.1f} km/h".format(wind_speed))
            weather_labels["wind_speed"].classes(labelSize + " " + colstr)

            wind_gust = d["wind_gust"]
            if wind_gust < 30:
                colstr = "text-green-500"
            elif wind_gust < 40:
                colstr = "text-orange-500"
            else:
                colstr = "text-red-500"
            weather_labels["wind_gust"].set_text("{:.1f} km/h".format(wind_gust))
            weather_labels["wind_gust"].classes(labelSize + " " + colstr)
        except Exception as e:
            logger.error("Error updating weather plots: {}".format(e))



