# How many lines the Log tab keeps. A ring buffer, not a setting: nothing about the
# operator's installation makes one number right and another wrong, and the cost is not
# theirs to tune blind -- ui.log holds one DOM element per line, per connected client, so
# this is a memory bound rather than a preference.
logBufferSize = 500

class LogBuffer(logging.Handler):
    """The last logBufferSize records, kept so the Log tab can show them.

    Attached to the root logger, so it collects every message that clears the --loglevel
    threshold, from this file and from anything else that logs through the standard
    hierarchy -- the same set of lines that reaches stderr.

    Records arrive from every worker thread. Each one is numbered, so a client that has
    already drawn part of the buffer asks for what is new by serial rather than being
    re-sent the history; and the numbers survive the deque dropping its oldest lines,
    which a length or an index would not.

    Deliberately not wired to triggerEvent(). updateWorker() logs a line for every event
    it dispatches, so an event raised per record would raise a record per event -- at
    --loglevel DEBUG that is a feedback loop that never quiets down. The Log tab polls
    since() on a timer instead.
    """

    def __init__(self, capacity: int):
        super().__init__()
        self.records = deque(maxlen=capacity)
        self.nextSerial = 0

    def emit(self, record):
        # logging.Handler.handle() holds self.lock across this call, which is the lock
        # since() takes below -- so the deque is never read while it is being appended to,
        # and iterating it there cannot raise "deque mutated during iteration".
        try:
            text = self.format(record)
        except Exception:
            self.handleError(record)
            return
        self.records.append((self.nextSerial, record.levelno, text))
        self.nextSerial += 1

    def since(self, serial: int):
        """The buffered lines numbered `serial` or above, and the serial to ask for next.

        Returning the next serial rather than letting the caller derive it from the lines
        matters when nothing new has arrived: an empty result still has to move the
        caller's cursor past records that were dropped, or a quiet client would keep
        asking for a serial that no longer exists.
        """
        self.acquire()
        try:
            return [entry for entry in self.records if entry[0] >= serial], self.nextSerial
        finally:
            self.release()

logBuffer = LogBuffer(logBufferSize)
logBuffer.setFormatter(logging.Formatter(logFormat))
logging.getLogger().addHandler(logBuffer)

