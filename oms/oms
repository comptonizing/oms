    def updateButtons():
        for name in switch_names:
            state = getSwitchState(name)
            if state == switch.State.ON:
                color = indicator_colors["on"]
            elif state == switch.State.OFF:
                color = indicator_colors["off"]
            else:
                color = indicator_colors["unkn"]
            status_indicators[name].style(f'background-color: {color}')

    # One colour per decisive state. Green for the two the roof is allowed to sit in, blue
    # for the two it is passing through, red for the one that wants an operator, orange for
    # the one an operator asked for.
    roof_state_colors = {
            RoofStatus.OPEN: "text-green-500",
            RoofStatus.CLOSED: "text-green-500",
            RoofStatus.OPENING: "text-blue-400",
            RoofStatus.CLOSING: "text-blue-400",
            RoofStatus.FAULT: "text-red-500",
            RoofStatus.DISENGAGED: "text-orange-400",
            }
    # Every colour the label can be given, taken off on each write. Two mutually exclusive
    # text colours on one element resolve by stylesheet order rather than by which was set
    # last, so leaving the old one on is how a label gets stuck red.
    roof_state_color_classes = " ".join(sorted(set(roof_state_colors.values())))
    # Both colours the rain line can carry, taken off on each write for the same reason the
    # state label's are: two text colours on one element resolve by stylesheet order rather
    # than by which was set last, so an orange left standing under a red wins by accident.
    roof_rain_label_colors = "text-orange-400 text-red-500"

    def updateRoofControls():
        """Repaints the decisive status and decides which buttons may be pressed.

        Both from one call, because they are two readings of the same answer and must not
        be able to disagree: a screen that says CLOSING with an enabled Open button is worse
        than either half of it being wrong on its own.
        """
        state, reason = roofDecisiveState()
        roof_state_label.set_text(state.value.upper())
        roof_state_label.classes("text-3xl font-bold " + roof_state_colors[state],
                                 remove=roof_state_color_classes)
        roof_state_reason.set_text(reason or "")
        roof_state_reason.set_visibility(bool(reason))

        # Disengaged disables the same buttons as a running motion, for a different reason:
        # there, the roof must not be interrupted; here, OMS has been told to keep its hands
        # off it. Both leave the stop alone, which is never disabled at all -- a button that
        # de-energizes four relays has no state in which it is the wrong thing to press.
        #
        # Open is set separately just below rather than in this loop only because it answers
        # to one condition more; the two above it are the ones with nothing else to say.
        blocked = state in (RoofStatus.OPENING, RoofStatus.CLOSING)
        for button in (roof_close_button, roof_reset_button):
            button.set_enabled(not blocked and roofEngaged)
        # Open answers to one thing the other two do not. The rain interlock shuts the roof
        # and then keeps it shut, and a button left live while every press of it is refused
        # deeper down is a control that lies about what it will do -- the refusal in
        # requestRoofMotion() is what enforces the rule, this is what tells the operator.
        rainHeld = rainInterlockReason()
        roof_open_button.set_enabled(not blocked and roofEngaged and rainHeld is None)
        roof_engage_button.set_enabled(not blocked)
        # Disabled while a motion runs, exactly as the engage button is. Overriding the
        # interlock mid-close would not stop that close in any case -- setRainOverride()
        # commands nothing, deliberately -- and the control for a roof that is moving and
        # should not be is the Stop above.
        roof_rain_button.set_enabled(not blocked)
        if rainOverride:
            roof_rain_label.set_text("Rain interlock overridden -- {}".format(
                rainReason() or "no rain reported"))
            roof_rain_label.classes("text-sm text-center text-orange-400",
                                    remove=roof_rain_label_colors)
            roof_rain_label.set_visibility(True)
        elif rainHeld is not None:
            roof_rain_label.set_text("Held closed: {}".format(rainHeld))
            roof_rain_label.classes("text-sm text-center text-red-500",
                                    remove=roof_rain_label_colors)
            roof_rain_label.set_visibility(True)
        else:
            roof_rain_label.set_visibility(False)
        # Text and props only, for the reason given below about the engage button: the
        # handler is bound once and reads rainOverride when it runs.
        roof_rain_button.set_text("Arm rain interlock" if rainOverride
                                  else "Override rain interlock")
        roof_rain_button.props("icon=umbrella color={}".format(
            "green" if rainOverride else "orange"))
        # Text and props only. The handler is bound once, at construction, and decides which
        # way it is going when it runs: ui.button.on_click() *adds* a handler rather than
        # replacing one, so rebinding here would fire the command once per repaint since
        # the page loaded.
        if roofEngaged:
            roof_engage_button.set_text("Disengage")
            roof_engage_button.props("icon=link_off color=orange")
        else:
            roof_engage_button.set_text("Engage")
            roof_engage_button.props("icon=link color=green")

    def updateRoofIcons(status: roof.ResponseState | None):
        # The icons and the one-word status are two views of the same poll, so they are
        # repainted together rather than left to drift by up to a timer period. Every
        # roofUpdate event and onConnect come through here.
        updateRoofControls()
        if status is None:
            # The limit switch indicators are keyed by the lower-cased RoofSwitch name,
            # so the set stays in step with roof.py by construction.
            for sw in roof.RoofSwitch:
                status_indicators[sw.name.lower()].props("color=gray")
            for thing in ["west_push_north", "west_push_south", "east_push_north", "east_push_south"]:
                status_indicators[thing].style("background-color: transparent")
            for thing in ["west_open", "west_close", "east_open", "east_close"]:
                status_indicators[thing].set_visibility(False)
            for thing in status_indicators["fans"]:
                thing.classes(add="animate-none", remove="animate-spin")
            return

        colors = ["red", "green"]
        # Iterating the enum rather than asking Roof for switchStates(): this runs on
        # every roof update, including ones that arrive with no roof configured, and it
        # must not depend on the singleton being there.
        for sw in roof.RoofSwitch:
            status_indicators[sw.name.lower()].props(f"color={colors[status[sw.bit]]}")

        colors = ["background-color: transparent", "background-color: gray"]
        status_indicators["west_push_north"].style(colors[status[roof.ResponseState.WEST_STATE.value]])
        status_indicators["west_push_south"].style(colors[status[roof.ResponseState.WEST_STATE.value]])
        status_indicators["east_push_north"].style(colors[status[roof.ResponseState.EAST_STATE.value]])
        status_indicators["east_push_south"].style(colors[status[roof.ResponseState.EAST_STATE.value]])

        animateAdd = ["animate-none", "animate-spin"][status[roof.ResponseState.FANS.value]]
        animateRemove = ["animate-spin", "animate-none"][status[roof.ResponseState.FANS.value]]
        for thing in status_indicators["fans"]:
            thing.classes(add=animateAdd, remove=animateRemove)

        # The arrows already carry animate-pulse from where they were built, so lighting
        # one is purely a matter of visibility. Which way a half is being driven is not in
        # `status` at all -- the four motion relays are Pi GPIO and the board cannot see
        # them -- so it comes from the worker's separate publish. Read through
        # getRoofDrive() rather than roof.Roof.get(): this runs with a non-None status even
        # when no roof exists (onConnect passes an all-False list), and the singleton would
        # raise ValueError there and take out the connect handler.
        #
        # The two arrows on a side are mutually exclusive by construction, because
        # driving() answers with one direction or None.
        drive = getRoofDrive()
        for half in roof.RoofHalf:
            side = half.value.lower()
            status_indicators[side + "_open"].set_visibility(
                    drive.get(half) is roof.Direction.OPEN)
            status_indicators[side + "_close"].set_visibility(
                    drive.get(half) is roof.Direction.CLOSE)

    def updateRoofStaleness():
        """Shows/hides the "last updated" label under the roof diagram.

        Ticks on its own timer rather than off the roofUpdate event: a worker that has
        gone silent -- the one case this exists to catch -- never fires that event again,
        so nothing event-driven would ever notice. getRoofState() is read straight from
        the worker's own publish, independent of whatever this client last happened to be
        shown.
        """
        # The decisive status turns on the age of the reading as much as on its content --
        # a poll that stops arriving makes it a fault with nobody publishing an event to
        # say so -- so it is recomputed on this timer for the same reason this label is.
        updateRoofControls()
        status, age = getRoofState()
        if status is None:
            # Nothing published yet, or the roof was torn down -- updateRoofIcons()
            # already grays the whole diagram out for this, and there is no real
            # last-known age to report alongside it.
            status_roof_stale.set_visibility(False)
            return
        if age > roofStateMaxAge:
            status_roof_stale.set_text("last updated {}s ago".format(int(age)))
            status_roof_stale.set_visibility(True)
        else:
            status_roof_stale.set_visibility(False)

    # Line colour by level. INFO gets none: it is the bulk of the log, and colouring the
    # majority tells the eye nothing. DEBUG is dimmed rather than coloured, so that
    # running at --loglevel DEBUG does not bury the handful of lines worth finding.
    logLevelClasses = {
            logging.DEBUG: "text-gray-500",
            logging.WARNING: "text-amber-400",
            logging.ERROR: "text-red-400",
            logging.CRITICAL: "text-red-500 font-bold",
            }

    # The serial this client has already drawn up to. Per client, not global: two browsers
    # on the same OMS each hold their own position in the same buffer.
    log_cursor = Container(0)

    def updateLog():
        """Draws whatever has been logged since the last tick into the Log tab.

        Polled rather than pushed -- see LogBuffer for why a log record must not raise an
        update event. One second is the cadence updateRoofStaleness() ticks on and for the
        same reason: there is no configured interval to key off, and the work when nothing
        has been logged is one comparison against an empty list.

        The cursor is moved to what since() reports rather than to the last line drawn, so
        a client that was quiet while the ring wrapped resumes from what is left rather
        than asking forever for a serial that has been dropped.
        """
        lines, nextSerial = logBuffer.since(log_cursor.get())
        log_cursor.set(nextSerial)
        for _, level, text in lines:
            # classes=None leaves the line at the card's own colour, which is what INFO
            # and anything at a non-standard level should get.
            log_view.push(text, classes=logLevelClasses.get(level))

    def updateStream():
        reason = cctvUnavailableReason()
        frameTime = None
        if reason is None:
            with last_stream_image_lock:
                frame = last_stream_image
                frameTime = last_stream_image_time
            if frame is None:
                # The worker has not come back with anything yet -- either it has just
                # started, or the camera was only just switched on and is still booting.
                reason = "Waiting for the stream ..."
            else:
                status_stream_image.set_source(frame)
        showUnavailable(status_stream_image, status_stream_message, reason)
        # Only judged while the image itself is on screen: showUnavailable() already
        # explains an unconfigured or not-yet-arrived stream, and a second label saying
        # the same thing in different words would only be noise.
        if reason is None and frameTime:
            age = time.monotonic() - frameTime
            if age > numericSetting("stream_refresh", 5) * 3:
                status_stream_stale.set_text("last updated {}s ago".format(int(age)))
                status_stream_stale.set_visibility(True)
            else:
                status_stream_stale.set_visibility(False)
        else:
            status_stream_stale.set_visibility(False)

    def updateAllskyImages():
