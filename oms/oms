    # The plot pass currently in flight for this client, if any, and the lock that makes
    # replacing it one indivisible step.
    plotRun = Container()
    plotLock = asyncio.Lock()
    # time.monotonic() of the last successful plot draw, or 0.0 if there has never been
    # one. Separate from plotRun, which tracks the pass in flight rather than the last
    # one to finish.
    lastPlotDraw = Container(0.0)

    def updatePlotStaleness():
        ts = lastPlotDraw.get()
        if not ts:
            weather_plot_stale_label.set_visibility(False)
            return
        age = time.monotonic() - ts
        maxAge = numericSetting("weather_plot_refresh", 60) * 3
        if age > maxAge:
            weather_plot_stale_label.set_text("last updated {}s ago".format(int(age)))
            weather_plot_stale_label.set_visibility(True)
        else:
            weather_plot_stale_label.set_visibility(False)

    async def updatePlots(*, supersede=True):
        """Redraws the plots. Latest wins, unless the caller asks not to.

        Both the refresh timer and the time-range selector land here, and a pass takes
        long enough that they overlap: a range change during a timer run left two
        coroutines mutating the same figures, one doing fig.data = [] part-way through the
        other's add_scatter.

        The pass in flight is cancelled rather than queued behind, or dropped. Every
        figure is rebuilt from scratch, so a half-finished pass has nothing worth keeping,
        and cancelling is what makes the range selector feel immediate -- dropping the new
        request would ignore the click, and queueing it would answer it seconds late.

        Cancelling suspends, so the swap has to happen under a lock or it reintroduces
        exactly what it exists to prevent: two callers arriving together both read the
        same pass, both find it not done -- a cancel is not delivered until the task next
        runs -- both await it, and both then spawn a replacement. Two passes on the same
        figures again, and plotRun holding only the second, so cancelPlots() could never
        reach the first and it would run on into the closed client it was querying.

        The lock covers the swap only, never the pass itself: a caller waiting for it
        goes on to supersede whatever it finds, which is still latest-wins and not a
        queue. Cancelling a pass that has already been cancelled is harmless, so the
        worst the wait costs is one replacement that is thrown away unstarted.

        supersede=False is the refresh timer's mode, and the difference is deliberate.
        A range-selector click or a save is a user gesture: it asks for something other
        than what is being drawn, so cancelling the pass in flight is the only answer
        that is not either late or wrong. A timer tick asks for exactly what the pass in
        flight is already computing, so cancelling it would mean a pass that takes longer
        than one refresh interval never finishes -- the plots would be permanently
        half-drawn on any database slow enough to matter. It drops itself instead, and
        the pass it found finishes and paints.
        """
        async with plotLock:
            running = plotRun.get()
            if running is not None and not running.done():
                if not supersede:
                    logger.debug("Plot refresh skipped: the previous pass is still running")
                    return
                running.cancel()
                try:
                    await running
                except asyncio.CancelledError:
                    pass
                except Exception as e:
                    logger.debug("Superseded plot pass ended with {}".format(e))
            task = spawn(_drawPlots())
            plotRun.set(task)
        try:
            await task
        except asyncio.CancelledError:
            # Superseded by a newer pass, which owns the figures now.
            pass

    def refreshPlots():
        """The refresh timer's entry point: start a pass, do not wait it out.

        ui.timer sleeps `interval - dt`, where dt is how long its callback took
        (nicegui/timer.py:97). updatePlots awaits the pass to completion, so pointing the
        timer straight at it made dt the length of the whole pass -- and a pass longer
        than the interval made that sleep negative, which returns at once. The result was
        plot passes running back to back forever instead of one per interval: fifteen
        queries, twenty add_scatter calls and five figure pushes, continuously, on the
        event loop that also serves the rest of the GUI.

        It does not take a sick database to get there. A pass over a 24h range is a few
        seconds of work on the Pi, so a "Plot refresh (s)" of 5 is enough -- and that
        field takes any number the operator types (see the interval validation still
        outstanding). Spawning and returning keeps dt at zero, so the ticks are spaced by
        the interval that was actually configured, whatever the database is doing.

        Returning without the result also means the tick cannot report a failure, which
        costs nothing here: _drawPlots answers a database error by painting it onto the
        figures rather than raising. Anything that does escape it lands in asyncio's
        handler, the same way it already does for the two spawn(updatePlots()) callers
        below.
        """
        spawn(updatePlots(supersede=False))

    def cancelPlots():
        """Stop an in-flight pass because the client it is querying is about to close.

        A pass holds one query API across all fifteen of its queries, so closing the
        client underneath it fails the rest of them with "Connector is closed."  Cancelling
        first means the pass stops at its current await instead of running into that.
        """
        running = plotRun.get()
        if running is not None and not running.done():
            running.cancel()
        plotRun.clear()

    async def blankPlots(message):
        """Replace every figure with one centred line of text.

        The axes are hidden along with the data: an empty grid with a note floating over
        it reads as a plot that failed to draw, rather than as one with nothing to draw.
        Pushed through pushPlot() like any other pass, so blanking eight figures does not
        stall the page any more than filling them does.
        """
        for plot in weather_plots.values():
            plot.figure.data = []
            plot.figure.update_layout(
                    annotations=[dict(
                        text=message,
                        xref='paper', yref='paper',
                        x=0.5, y=0.5,
                        xanchor='center', yanchor='middle',
                        showarrow=False,
                        font=dict(size=16, color='gray'),
                    )],
                    xaxis=dict(visible=False),
                    yaxis=dict(visible=False),
                )
            await pushPlot(plot)

    async def _drawPlots():
        # One API for the whole pass, so the fifteen queries below are answered by one
        # client and cannot straddle two. Which client it was matters in the handler.
        api = query_api.get()
        try:
            if api is None:
                # No database configured at all. Silently blank plots look like a fault
                # that swallowed its own error, so say what is missing and where to fix it.
                await blankPlots('No database configured (see Settings)')
                return
            for plot in weather_plots.values():
                plot.figure.layout.annotations = []
                plot.figure.update_xaxes(visible=True)
                plot.figure.update_yaxes(visible=True)
            await _updatePlots(api)
            lastPlotDraw.set(time.monotonic())
        except Exception as e:
            if query_api.get() is not api:
                # Not a database fault: the client this pass was querying was closed
                # underneath it -- a settings save or a disconnect -- so its remaining
                # queries failed with "Connector is closed." Whoever replaced the client
                # draws next; painting an error over the figures would only flash.
                logger.debug("Plot pass dropped: its database client was replaced ({})".format(e))
                return
            logger.error(f"Error updating weather plots: {e}")
            await blankPlots('No data available (check logs)')
        finally:
            # Runs on every path, including cancellation: whether this pass drew, failed,
            # or was superseded, the label must reflect the true age of the last drawing
            # that actually finished, not the outcome of this particular attempt.
            updatePlotStaleness()

    # Tailwind's text colours are mutually exclusive, so a new one has to take the old
    # one off the element: which of two present classes wins is decided by stylesheet
    # order, not by the order they were added in.
    weather_label_colors = "text-red-500 text-orange-500 text-green-500 text-gray-500"

    weatherLabelSize = "text-3xl"

    def setPanelLabel(labels, name, text, color=""):
        """Write one value into the weather panel, taking off the colour it had before.

        Every writer has to go through here: a label keeps the colour it was last given,
        so the red left behind by an "Error" pass would otherwise outlive the good reading
        that replaced it.

        Takes the table to write into rather than closing over one, because there are two
        of them now -- the station's readings and the environment board's -- and they are
        written by different functions on different schedules against different notions of
        "too old". The rule about the colour is the one thing they must share.
        """
        thing = labels[name]
        thing.set_text(text)
        thing.classes((weatherLabelSize + " " + color).strip(), remove=weather_label_colors)

    def temperatureColor(value):
        """Green through orange to red, out from the range nothing needs worrying about.

        Shared by the outside reading and the inside one. The ladder was written for the
        station and it transfers: what it marks is a temperature far enough from ordinary
        to be worth a second look, and that is the same question in a dome as outside it.
        """
        if value < -20 or value >= 35:
            return "text-red-500"
        if value < -10 or value >= 25:
            return "text-orange-500"
        return "text-green-500"

    def humidityColor(value):
        """The same shape as temperatureColor(), around the band that is unremarkable.

        The top end is the one that means something inside: it is what the fans are for,
        and a reading in the reds is dew on the optics rather than a number out of range.
        """
        if value < 10 or value >= 90:
            return "text-red-500"
        if value < 20 or value >= 80:
            return "text-orange-500"
        return "text-green-500"

    # What each inside reading is called on screen, and how to draw it. Kept beside the
    # function that uses it rather than up with environment_items, which says what the
    # cards are; this says what goes in them.
    environment_formats = {
            "inside_temperature": ("{:.1f} °C", temperatureColor),
            "inside_humidity": ("{:.1f} %", humidityColor),
            }

    def updateEnvironment():
        """Fills the two readings that come from the environment board, not the station.

        Called from updateWeather() so that it rides the same timer and the same four
        callers, and called from its very first line so that it runs *before* any of that
        function's early returns. Those returns are all about the weather station -- an
        allsky camera that is switched off, a scrape that has not come back -- and none of
        them says anything about a board on a serial port inside the building. Sharing the
        tick is convenient; sharing the verdict would mean the inside temperature went
        blank whenever the outside one did.
        """
        data, age = getEnvironment()
        if age is None:
            # Never read: no board configured, or one that has not answered since OMS
            # started. Not an error -- an unconfigured board is a supported state under the
            # no-defaults contract -- and there is no last-known age to caption it with.
            for name in environment_labels:
                setPanelLabel(environment_labels, name, "N/A", "text-gray-500")
            environment_stale_label.set_visibility(False)
            return
        if age > environmentStateMaxAge:
            # The same threshold the fans refuse to run on. Saying "Error" while the fan
            # logic has already switched them off for the same reading is the point: the
            # two must not be able to disagree about what current means.
            for name in environment_labels:
                setPanelLabel(environment_labels, name, "Error", "text-red-500")
            environment_stale_label.set_text(
                    "inside readings last updated {}s ago".format(int(age)))
            environment_stale_label.set_visibility(True)
            return
        environment_stale_label.set_visibility(False)
        for name, (fmt, color) in environment_formats.items():
            value = asNumber(data.get(name))
            if value is None or math.isnan(value):
                # The board answered, but not with this. NaN is worth testing for
                # separately from None: a sensor that has dropped off the bus reports one
                # rather than nothing at all, and it would format as "nan °C" and colour
                # itself green, since every comparison against NaN is False.
                setPanelLabel(environment_labels, name, "N/A", "text-gray-500")
                continue
            setPanelLabel(environment_labels, name, fmt.format(value), color(value))

    def updateWeather():
        # First, and deliberately above every early return below: see updateEnvironment().
        updateEnvironment()
        labelSize = weatherLabelSize

        def setLabel(name, text, color=""):
            setPanelLabel(weather_labels, name, text, color)

        reason = weatherUnavailableReason()
        if reason is None and weatherWarmingUp():
            reason = "the station has not answered since it came back yet"
        if reason is not None:
            # Not an error: either the station is unreachable because the allsky camera it
            # hangs off is not running -- which the allsky card next to this already
            # spells out -- or it is reachable but still warming up.
            logger.debug("No weather data expected: {}".format(reason))
            for thing in weather_labels.values():
                thing.set_text("N/A")
                thing.classes(labelSize + " text-gray-500", remove=weather_label_colors)
            weather_stale_label.set_visibility(False)
            return
        with weatherCacheLock:
            d = weatherCache
            cacheTimestamp = weatherCacheTimestamp
        weatherAge = time.monotonic() - cacheTimestamp
        weatherMaxAge = numericSetting("weather_refresh", 5) * 3
        if d is None or weatherAge > weatherMaxAge:
            logger.warning("No recent weather data available")
            for thing in weather_labels.values():
                thing.set_text("Error")
                thing.classes(labelSize + " text-red-500", remove=weather_label_colors)
            # 0.0 means the cache has never held anything at all, so there is no real
            # last-known age to report -- "Error" above already says all there is to say.
            if cacheTimestamp > 0.0:
                weather_stale_label.set_text("last updated {}s ago".format(int(weatherAge)))
                weather_stale_label.set_visibility(True)
            else:
                weather_stale_label.set_visibility(False)
            return
        weather_stale_label.set_visibility(False)
        # Coerced up front, and every block below tests for None: a field the station
        # left out or sent as null shows as absent on its own label. Comparing it against
        # a threshold raises, and one raise used to cost every field after it its update
        # -- the labels then held old readings while looking current.
        numbers = {name: asNumber(d.get(name)) for name in weather_labels}
        absent = sorted(name for name, value in numbers.items() if value is None)
        if absent:
            logger.debug("Weather fields not usable: {}".format(", ".join(absent)))
        for name in absent:
            setLabel(name, "N/A", "text-gray-500")

        try:
            temperature = numbers["env_temperature"]
            if temperature is not None:
                setLabel("env_temperature", "{:.1f} °C".format(temperature),
                         temperatureColor(temperature))

            humidity = numbers["env_humidity"]
            if humidity is not None:
                setLabel("env_humidity", "{:.1f} %".format(humidity),
                         humidityColor(humidity))

            dewpoint = numbers["env_dewpoint"]
            if dewpoint is not None:
                setLabel("env_dewpoint", "{:.1f} °C".format(dewpoint))

            rain = numbers["rain_percentage"]
            if rain is not None:
                if rain < 5:
                    colstr = "text-green-500"
                elif rain < 10:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("rain_percentage", "{:.0f} %".format(rain), colstr)

            # No elevation entered means no sea-level correction, which is what an
            # elevation of zero computes anyway -- not a default, an identity.
            elevation = numericSetting("weather_elevation", 0)
            pressure = numbers["env_pressure"]
            if pressure is not None and elevation and temperature is None:
                # The correction needs the temperature. Without it the raw reading would
                # be wrong by more than it is worth showing, so leave the N/A standing.
                logger.debug("No temperature, so no sea-level correction for the pressure")
            elif pressure is not None:
                if elevation:
                    pressure += (pressure * 9.80665 * elevation)/(287 * (273 + temperature + (elevation/400)))
                setLabel("env_pressure", "{:.0f} hPa".format(pressure))

            sqm = numbers["sqm_mpsas"]
            if sqm is not None:
                if sqm < 18:
                    colstr = "text-red-500"
                elif sqm < 20:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-green-500"
                setLabel("sqm_mpsas", "{:.1f}".format(sqm), colstr)

            ir_sky = numbers["ir_sky"]
            if ir_sky is not None:
                setLabel("ir_sky", "{:.1f} °C".format(ir_sky))

            ir_diff = numbers["ir_diff"]
            if ir_diff is not None:
                if ir_diff < 15:
                    colstr = "text-red-500"
                elif ir_diff < 20:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-green-500"
                setLabel("ir_diff", "{:.1f} °C".format(ir_diff), colstr)

            wind_speed = numbers["wind_speed"]
            if wind_speed is not None:
                if wind_speed < 15:
                    colstr = "text-green-500"
                elif wind_speed < 20:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("wind_speed", "{:.1f} km/h".format(wind_speed), colstr)

            wind_gust = numbers["wind_gust"]
            if wind_gust is not None:
                if wind_gust < 30:
                    colstr = "text-green-500"
                elif wind_gust < 40:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("wind_gust", "{:.1f} km/h".format(wind_gust), colstr)
        except Exception as e:
            logger.error("Error updating weather labels: {}".format(e))



    # Run once against the freshly built page, so what the client first renders is
    # already right: the timers below only fire a refresh period later.
    updateWeather()
    updateStream()
    updateAllskyImages()
    # The whole buffer, since this client's cursor starts at zero: a page opened after
    # something went wrong shows the lines that say so, rather than starting blank and
    # only filling with whatever happens next.
    updateLog()
    # So the first render carries a real state and correctly enabled buttons rather than
    # the placeholder, which onConnect would otherwise only replace once the websocket is
    # up. It also means a page loaded while the roof is moving has Open and Close already
    # disabled on arrival.
    updateRoofControls()

    weather_range_select.on_value_change(updatePlots)

    timers = {}

    influx_client = Container()
    query_api = Container()

    def clearTimers():
        """Retires this client's refresh timers, for good.

        delete(), not cancel(). cancel() only sets Timer._is_canceled, and nicegui's
        Timer._should_stop() (elements/timer.py) reads that *last*:

            self.is_deleted or self.client.id not in Client.instances or super()...

        so it dereferences the client weakref before it ever looks at the flag. A
        cancelled timer is still parked in its asyncio.sleep and only re-tests that
        condition once the sleep expires -- so if nicegui collects the client in
        between, the middle term raises "The client this element belongs to has been
        deleted", which escapes the loop and takes Timer._cleanup()'s parent_slot
        assertion with it. That is the traceback cancelling these was meant to remove,
        and cancelling does not remove it. The window is one interval wide, and
        stream_refresh and weather_plot_refresh both go up to 600s.

        delete() sets _deleted, which _should_stop() tests *first* and short-circuits
        on without touching the client, which _cleanup() also tests before touching
        parent_slot, and which nicegui reaches through _handle_delete ->
        cancel(with_current_invocation=True). It also detaches the element: a cancelled
        timer stayed in the page (and as a timer.js component in the browser) until its
        sleep ran out, so every settings save left up to five of them behind per client.

        Guarded per timer, so that one failure cannot leave the rest attached.
        """
        for name, timer in timers.items():
            try:
                timer.delete()
            except Exception as e:
                logger.warning("Error deleting the {} timer: {}".format(name, e))
        timers.clear()

    def initTimers():
        """(Re-)creates the refresh timers, skipping the ones with no interval set.

        There is no default refresh interval -- an unconfigured one means the operator
        has not said how often to refresh, so nothing refreshes periodically until they
        do. ui.timer(None) would raise and take the whole settings-update handler with
        it. processSettingsUpdate() calls this again on every save, so a timer appears as
        soon as its interval is entered.

        The timers are created with immediate=False. ui.timer defaults to firing its
        callback at once, and both callers below already call all four callbacks
        themselves -- so every save and every connect ran the whole refresh twice per
        client, two plot passes included, precisely while the process is re-opening
        serial ports and restarting three workers. The explicit calls are the half that
        stays: a timer whose interval is unset is never created, so leaving the first
        paint to the timers would mean an unconfigured refresh interval paints nothing
        at all rather than painting once.
        """
        clearTimers()
        # (setting, callback, fallback). Only the plots carry a fallback, and it is a
        # local one at the single place that reads it, not a defaults table coming back:
        # a plot pass costs fifteen queries, so leaving it unset must not mean "as often
        # as the labels refresh". Sixty seconds is the operator's choice of a floor.
        intervals = {
                "update_allsky_images": ("weather_refresh", updateAllskyImages, None),
                "update_weather": ("weather_refresh", updateWeather, None),
                # refreshPlots, not updatePlots: the timer must not await the pass it
                # starts, or a slow pass compresses its own interval away.
                "update_plots": ("weather_plot_refresh", refreshPlots, 60),
                "update_stream": ("stream_refresh", updateStream, None),
                }
        for name, (setting, callback, fallback) in intervals.items():
            # The type and range check that used to be written out here lives in
            # numericSetting now, along with the same check for every other numeric
            # setting -- this was the only one that ever had it.
            interval = numericSetting(setting, fallback)
            if interval is None:
                logger.warning("No usable {} set, {} will not refresh".format(setting, name))
                continue
            timers[name] = ui.timer(interval, callback, immediate=False)
        # Roof staleness has no configured interval to key off -- roofStateMaxAge is a
        # fixed 5s threshold, not a setting -- so it is not in the table above and ticks
        # on its own short, fixed cadence instead.
        timers["update_roof_staleness"] = ui.timer(1.0, updateRoofStaleness, immediate=False)
        # Same story for the log: how often lines arrive is not something the operator
        # configures, so there is no setting to read and the cadence is fixed here.
        timers["update_log"] = ui.timer(1.0, updateLog, immediate=False)

    def makeInfluxClient():
        oldClient = influx_client.get()
        if oldClient is not None:
            cancelPlots()
            spawn(oldClient.close())
            influx_client.clear()
            query_api.clear()
        _db_url = s.q("weather_db_url", fallback=None)
        _db_token = s.q("weather_db_token", fallback=None)
        _db_org = s.q("weather_db_org", fallback=None)
        if _db_url not in [None, ""] and _db_token not in [None, ""] and _db_org not in [None, ""]:
            client = InfluxDBClientAsync(
                    url = _db_url,
                    token = _db_token,
                    org = _db_org
                    )
            influx_client.set(client)
            query_api.set(client.query_api())

    def processSettingsUpdate():
        makeInfluxClient()
        initTimers()
        updateButtons()
        # A saved URL or switch pin can have made either camera available or taken it
        # away; the timers would not notice until their next tick.
        updateStream()
        updateAllskyImages()
        updateWeather()
        updateRoofStaleness()
        # A database entered (or cleared) just now changes what the plots should say, and
        # they would otherwise keep the old message until their next tick a minute away.
        spawn(updatePlots())


    def onConnect():
        makeInfluxClient()
        initTimers()
        updateButtons()
        updateStream()
        updateAllskyImages()
        # The one callback this handler did not use to call for itself: the immediate
        # first tick of the weather timer was doing it, and that tick is gone. The page
        # body paints the labels once as it is built, but a client can connect a moment
        # later than that, and the alternative is labels a whole refresh interval stale.
        updateWeather()
        # getRoofState(), not the raw lastRoofState: stopRoof() zeroes the timestamp but
        # leaves the last real reading in place, so a client connecting after the roof
        # failed used to be shown convincing red/green limit-switch icons for a roof that
        # is not there. Clients already connected grey out on the roofUpdate None event;
        # this is the path that had no such event to receive. getRoofState() returns None
        # once the timestamp is zeroed, and updateRoofIcons handles None.
        updateRoofIcons(getRoofState()[0])
        updateRoofStaleness()
        # Drawn once here rather than left blank until the first timer tick, which is a
        # whole plot interval away -- a minute of empty plots on a page that has just
        # loaded looks like a fault. Cheap to do: a pass this early is the only one
        # running, and a range change moments later simply cancels it.
        spawn(updatePlots())
        updateCallbacks[ui.context.client.id] = update
    ui.context.client.on_connect(onConnect)

    def onDisconnect():
        updateCallbacks.pop(ui.context.client.id, None)
        # Left running, these keep looping after the client is gone, and once NiceGUI
        # garbage-collects it the next tick dereferences a dead weakref and raises the
        # "client ... has been deleted" traceback instead of stopping quietly. See
        # clearTimers() for why that needs delete() and why cancel() does not do it.
        clearTimers()
        oldClient = influx_client.get()
        if oldClient is not None:
            cancelPlots()
            spawn(oldClient.close())
            influx_client.clear()
            query_api.clear()
    ui.context.client.on_disconnect(onDisconnect)

    async def update(thing: list):
        logger.debug("Processing event: {}".format(thing))
        if thing[0] == "setSwitchState":
            ui.notify(f"Switch {thing[1]} was turned {thing[2]}")
            updateButtons()
            if thing[1] == "cctv":
                updateStream()
            elif thing[1] == "allsky":
                # Powering the allsky decides both its image and the weather data.
                updateAllskyImages()
                updateWeather()
            return
        if thing[0] == "updateSettings":
            processSettingsUpdate()
            return
        if thing[0] == "roofUpdate":
            updateRoofIcons(thing[1])
            return
        if thing[0] == "roofMotionDone":
            ui.notify(f"Roof {thing[1]} complete", type="positive")
            updateRoofControls()
            return
        if thing[0] == "roofMotionError":
            # The only place a motion failure reaches the operator. failRoofMotion() composes
            # the reason and stamps it on motionFaultReason, but nothing on the page shows
            # that field, so without this a latched roof looks exactly like an idle one --
            # the icons simply stop moving.
            ui.notify(f"Roof motion failed: {thing[1]}", type="negative")
            updateRoofControls()
            return
        if thing[0] == "roofMotionStopped":
            # Fired with no payload, unlike the two above, so do not index thing[1].
            ui.notify("Roof stopped", type="warning")
            updateRoofControls()
            return
        if thing[0] == "roofEngaged":
            ui.notify("Roof engaged" if thing[1] else
                      "Roof disengaged: relays de-energized, safety checks off",
                      type="positive" if thing[1] else "warning")
            updateRoofControls()
            return
        if thing[0] == "rainOverride":
            ui.notify("Rain interlock overridden: OMS will not close the roof on rain"
                      if thing[1] else
                      "Rain interlock armed: OMS will close the roof on rain",
                      type="warning" if thing[1] else "positive")
            updateRoofControls()
            return
        if thing[0] == "roofFaultCleared":
            ui.notify("Roof fault cleared", type="positive")
            updateRoofControls()
            return
        if thing[0] == "fanUpdate":
            ui.notify(f"Fans set to {thing[1]} ({"auto" if thing[2] else "manual"})")
            return
        if thing[0] == "fanError":
            ui.notify(f"Error setting fans to {thing[1]}: {thing[2]}", type="negative")
            return
        if thing[0] == "switchError":
            ui.notify(f"Error setting switch {thing[1]}: {thing[2]}", type="negative")
            return
        if thing[0] == "warning":
            ui.notify(f"Warning: {thing[1]}", type="warning")
            return
        if thing[0] == "error":
            ui.notify(f"Error: {thing[1]}", type="negative")
            return
        logger.error(f"Unknown update event, ignoring: {thing}")

    updateCallbacks[ui.context.client.id] = update

    tabs.set_value("Status")

    ui.run_javascript('''
        Promise.race([
            document.fonts.ready,
            new Promise(resolve => setTimeout(resolve, 3000))
        ]).then(() => {
            const el = document.getElementById('loading-overlay');
            if (el) {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }
        });
    ''')

# --- state archive ------------------------------------------------------------------

# The readings have always been archived; what the equipment was doing while they were
# taken has not. That is the half of a night that answers "was the roof even open for
# this", and no amount of weather data says it.
#
# Its own measurement, "oms", in the same bucket rather than more fields on "weather":
# the station owns that measurement's namespace -- it writes env_*, ir_*, rain_*, sqm_*
# and wind_* into it itself -- and what the roof was doing is not a reading of the sky.
#
# Its own InfluxDB client too, rather than the environment worker's. That one is built by
# setupEnvironmentWorker() and lives and dies with the serial port behind the inside
# sensor, and whether the roof state is recorded must not depend on a board that is
# unplugged.

stateInfluxClient = None
stateWriteApi = None
stateThread = None
# The current worker's stop event, and only that -- the rule the capture, environment and
# roof workers all keep, for the same reason: signalling one worker must not be undoable
# on behalf of another.
stateStopEvent = threading.Event()
# Bumped by stopStateWorker(), so a worker whose join expired stops writing as soon as it
# notices it is no longer the current one.
stateGeneration = 0

stateWriteOptions = WriteOptions(
        # One point per request, against the environment worker's twenty. This writes on a
        # change and then not again for a minute, so batching would hold a roof transition
        # back until either the flush interval or the nineteen points after it -- and on a
        # quiet night the nineteenth point is an hour away.
        batch_size = 1,
        flush_interval = 2000,
        jitter_interval = 0,
        retry_interval = 5000,
        max_retry_time = 600000,
        max_retries = 100,
        max_retry_delay = 60000,
        # As on the environment write API, and for the same reason: this bounds what
        # closeStateDatabase() may spend flushing to a database that has gone away.
        max_close_wait = 5000,
        exponential_base = 2
        )

# How often the worker looks. Not how often it writes: a pass that finds nothing changed
# writes nothing until the heartbeat below comes due. A second is twice the roof's own
# poll period, so a transition reaches the database about a second after the board reports
# it, and the cost of a pass that writes nothing is a handful of dictionary reads.
statePollPeriod = 1.0

# A point goes in at least this often even when nothing has changed. Without it a panel
# showing the last hour of a quiet night is empty rather than flat, and every reader has
# to be told to fill from the last value before its range. Sixty seconds is ~1.4k points a
# day; a point per roof poll would be ~170k for the same information.
stateHeartbeat = 60.0

# The loop waits at most statePollPeriod between checks and a pass costs one write, which
# the batching API hands off rather than waiting out. Five seconds on top is the same
# headroom environmentStopGrace gives, and closeStateDatabase()'s flush is bounded
# separately by max_close_wait above.
stateStopBudget = statePollPeriod + 5

# The six states as the integers that go into the database. Written out rather than taken
# from the enum's own order, because that order is a matter of how RoofStatus reads and
# these numbers are years of history: a state inserted in the middle of that class would
# silently renumber all of it.
roofStateCodes = {
        RoofStatus.OPEN: 0,
        RoofStatus.OPENING: 1,
        RoofStatus.CLOSED: 2,
        RoofStatus.CLOSING: 3,
        RoofStatus.FAULT: 4,
        RoofStatus.DISENGAGED: 5,
        }

# Where a half or the roof itself is. Deliberately the same numbering roofStateCodes uses
# above, so one value mapping in a dashboard covers roof_state and all three position
# fields rather than two legends that disagree about what 0 means. RoofState's own values
# are not reused for that reason: they are 0 for CLOSED, which is 2 here.
#
# UNKN gets a code rather than being left out, unlike the absent readings elsewhere in
# here. "Between its switches" is a real answer about a half that is present and reporting
# -- it is the most interesting one there is -- and it must not look like a half nobody
# has heard from. It is 6 rather than 4 or 5, which roofStateCodes has already spent.
positionCodes = {
        roof.RoofState.OPEN: 0,
        roof.RoofState.OPENING: 1,
        roof.RoofState.CLOSED: 2,
        roof.RoofState.CLOSING: 3,
        roof.RoofState.UNKN: 6,
        }

# Same for the fan mode, which is what OMS was told to do. What the fans are actually
# doing under it is fans_running, read from the board -- the two disagree by design in
# "auto", which is the whole reason both are recorded.
fanModeCodes = {"off": 0, "on": 1, "auto": 2}


def stateFields():
    """What the equipment is doing, as the fields of one InfluxDB point.

    Every read here is of state a worker has already published -- roofDecisiveState() and
    the limit switches off the last status word, getSwitchState() off the switch objects,
    the fan mode out of settings. Nothing here touches a serial port or takes a lock,
    which is what makes it safe to call on the cadence above rather than only when
    something asks.

    A value that is not known is left out rather than written as a placeholder. A switch
    with no pin configured reads UNKN, and no boolean means that: false would be a lie
    about a switch that may well be powering the observatory PC, and a sentinel integer
    becomes a number every reader has to remember is not a state. An absent field is what
    InfluxDB already has for "no value", and it plots as a gap.
    """
    fields = {}

    # roofDecisiveState() rather than the status word, so this records the same six-word
    # answer the operator, the API and the INDI driver are all looking at. Deriving it
    # here from limit switches would be a second implementation of that judgement, free
    # to disagree with the one on screen.
    state, _ = roofDecisiveState()
    code = roofStateCodes.get(state)
    if code is not None:
        fields["roof_state"] = code

    for name in switch_names:
        value = getSwitchState(name)
        if value is switch.State.ON:
            fields["switch_" + name] = True
        elif value is switch.State.OFF:
            fields["switch_" + name] = False

    mode = fanModeCodes.get(s.q("fan_mode", fallback=None))
    if mode is not None:
        fields["fans_mode"] = mode

    # The four motion relays are Pi GPIO and the board cannot see them, so unlike
    # everything below they need no status word -- roofDetail() reports them ahead of its
    # own no-reading early return for exactly the same reason. drive() only ever energizes
    # one relay of a pair, which is the interlock the whole Roof class is built around, so
    # the direction a half is driven says precisely which of its two contactors is closed.
    drive = getRoofDrive()
    for half in roof.RoofHalf:
        name = half.value.lower()
        direction = drive.get(half)
        fields["relay_" + name + "_open"] = direction is roof.Direction.OPEN
        fields["relay_" + name + "_close"] = direction is roof.Direction.CLOSE

    # The fans and the eight limit switches are all read out of the roof board's status
    # word, so with no reading there is nothing to say about any of them -- which is a
    # different thing from the fan mode above, and is why that one is not in here. Same
    # guard fanDetail() and roofDetail() use in apiv1, and for the same reason.
    word, _ = getRoofState()
    if word is not None and roof.Roof.isInitialized():
        instance = roof.Roof.get()
        fields["fans_running"] = bool(instance.fansAreOn(status=word))
        # Named off RoofSwitch rather than listed again here, so the eight names stay
        # written down in the one place that owns them -- the rule RoofSwitch.bit already
        # keeps for the status bits, and RoofHalf.openSwitches for the pairs.
        #
        # All eight, not a summary. roof_state above is already the summary, and it is
        # exactly the reading that produced it which says why a half stopped between its
        # switches, or which switch was the one that stopped reporting.
        for sw, engaged in instance.switchStates(status=word).items():
            fields["limit_" + sw.name.lower()] = bool(engaged)

        for half in roof.RoofHalf:
            name = half.value.lower()
            # Both, because they answer different questions and there are twenty seconds
            # in which neither is true: extendRequested is what the firmware was last
            # told, retracted is what it says about the stroke, and isRetracted() only
            # goes true 20 s after the last retract command. A motion waiting on a rod
            # looks identical to one that is stuck unless both are recorded.
            fields["rod_" + name + "_extend_requested"] = bool(
                    instance.rodExtendRequested(half, status=word))
            fields["rod_" + name + "_retracted"] = bool(
                    instance.rodRetracted(half, status=word))
            fields["position_" + name] = positionCodes[instance.halfPosition(half, status=word)]

        # The whole roof as well as the halves, though it is derived from them: position()
        # is UNKN whenever the two disagree, and a half-open roof is the case where that
        # distinction is the entire story.
        fields["position_roof"] = positionCodes[instance.position(status=word)]

    return fields


def closeStateDatabase():
    """Closes the state write API and client, and forgets both.

    Each close is guarded separately, as in closeEnvironmentDatabase(): one that fails
    must not stop the other, since the whole point is to leave nothing behind. The write
    API goes first, because flushing it needs the client it belongs to.
    """
    global stateInfluxClient, stateWriteApi
    if stateWriteApi is not None:
        try:
            stateWriteApi.close()
        except Exception as e:
            logger.warning("Error closing the state write API: {}".format(e))
        stateWriteApi = None
    if stateInfluxClient is not None:
        try:
            stateInfluxClient.close()
        except Exception as e:
            logger.warning("Error closing the state database client: {}".format(e))
        stateInfluxClient = None


def setupStateWorker():
    """Opens an InfluxDB client for the state archive. Returns whether there is one.

    False is not an error. The same three settings drive the readings' archive and the
    plots, so a site with no database configured simply keeps no history, and saying so
    at debug level is the whole of the report -- setupEnvironmentWorker() treats the
    identical case the identical way.
    """
    global stateInfluxClient, stateWriteApi
    closeStateDatabase()
    _db_url = s.q("weather_db_url", fallback=None)
    _db_token = s.q("weather_db_token", fallback=None)
    _db_org = s.q("weather_db_org", fallback=None)
    if _db_url in [None, ""] or _db_token in [None, ""] or _db_org in [None, ""]:
        logger.debug("No weather database configured, equipment state will not be stored")
        return False
    try:
        stateInfluxClient = InfluxDBClient(
                url = _db_url,
                token = _db_token,
                org = _db_org
            )
        stateWriteApi = stateInfluxClient.write_api(write_options=stateWriteOptions)
    except Exception as e:
        logger.error("Error setting up the state influx client: {}".format(e))
        closeStateDatabase()
        return False
    return True


def stateWorkerLoop(stopEvent, generation):
    """Writes a point whenever the equipment's state changes, and once a minute regardless.

    stopEvent is this worker's own and generation is what makes a worker that could not be
    joined harmless, exactly as in roofLoop() and environmentWorkerLoop().

    Paced on a deadline rather than by sleeping a fixed gap after each pass, so the period
    stays constant regardless of how long a pass takes, and waiting on the stop event
    rather than sleeping makes shutdown immediate instead of up to one period late.

    The comparison is against the fields last *written*, not the fields last seen, so a
    state that flips away and back between two passes does not go unrecorded -- and a
    field that has gone from known to absent counts as a change, because a dict without it
    does not equal a dict with it.
    """
    lastFields = None
    lastWrite = 0.0
    nextPoll = time.monotonic() + statePollPeriod
    while True:
        if stopEvent.wait(max(0.0, nextPoll - time.monotonic())):
            break
        nextPoll = time.monotonic() + statePollPeriod
        if generation != stateGeneration:
            logger.warning("State worker {} superseded by {}, exiting".format(
                generation, stateGeneration))
            break
        # Read once into a local: stopStateWorker() clears the global from the event loop
        # while this thread is running, and a pass must not find it None halfway through.
        api = stateWriteApi
        if api is None:
            continue
        try:
            fields = stateFields()
            if not fields:
                # Nothing is known yet -- no roof, no switches, no fan mode. InfluxDB
                # rejects a point with no fields anyway, and there would be nothing in it.
                continue
            now = time.monotonic()
            if fields == lastFields and now - lastWrite < stateHeartbeat:
                continue
            # Stamped here rather than left to the server. The write API hands the point
            # off to its own thread, and a point that arrives a retry interval late would
            # otherwise be recorded as having happened then.
            point = Point("oms").time(datetime.now(timezone.utc))
            for key, value in fields.items():
                point = point.field(key, value)
            api.write(
                    bucket=s.q("weather_db_bucket", fallback=None),
                    org=s.q("weather_db_org", fallback=None),
                    record=point)
            lastFields = fields
            lastWrite = now
        except Exception as e:
            logger.warning("Error in state loop: {}".format(e))


def stopStateWorker():
    """Stops the worker and closes the database client it was writing through."""
    global stateThread, stateStopEvent, stateGeneration
    # Before the join, not after: from here on any worker still running is superseded,
    # whether it manages to stop or not, and must not write another point.
    stateGeneration += 1
    if stateThread is not None and stateThread.is_alive():
        logger.info("Stopping state thread")
        stateStopEvent.set()
        stateThread.join(timeout=stateStopBudget)
        if stateThread.is_alive():
            logger.warning("State thread still alive")
        else:
            logger.info("State thread stopped")
    # Cleared either way: a thread that outlived its join is not something anything should
    # go on to join or signal again.
    stateThread = None
    # After the join, so the worker is not writing through a write API being closed under
    # it, and unconditionally, so a client survives no worker rather than the other way round.
    closeStateDatabase()


def startStateWorker():
    """Starts the state worker, if there is a database to write to.

    Unlike the environment worker, this does not start a thread that retries: what setup
    can fail on here is settings, not hardware. A database configured later arrives
    through a settings save, and that calls initStuff(), which calls startWorkers(), which
    is this function -- so the retry is the save itself, and an idle thread in the
    meantime would buy nothing.
    """
    global stateThread, stateStopEvent
    stopStateWorker()
    if not setupStateWorker():
        return
    # A fresh event per worker, handed over as an argument, rather than clearing the
    # shared one -- a previous worker that stopStateWorker() signalled but could not join
    # is still waiting on *its* event, and clearing that same object would resume it.
    workerStopEvent = threading.Event()
    stateStopEvent = workerStopEvent
    logger.info("Starting state loop")
    # stopStateWorker() bumped the generation above, so this worker takes the current
    # value and every older one is already superseded.
    stateThread = threading.Thread(
            target = stateWorkerLoop,
            args = (workerStopEvent, stateGeneration),
            daemon = True,
            name = "State worker"
            )
    stateThread.start()
    logger.info("State loop started")


def startWorkers():
    """Starts the four background workers, each independently.

    One worker failing to start must not keep the others down: they share no state, and
    losing the capture loop is no reason to also lose the environment readings the fan
    safety logic depends on.
    """
    for name, start in (
            ("capture loop", startCaptureLoop),
            ("environment worker", startEnvironmentWorker),
            ("weather worker", startWeatherWorker),
            # Last, and it only reads what the three above publish. A site with no
            # database configured starts no thread here at all -- see startStateWorker().
            ("state worker", startStateWorker),
            ):
        try:
            start()
        except Exception as e:
            msg = "Error starting {}: {}".format(name, e)
            logger.error(msg)
            triggerEvent("error", msg)

# Serializes initStuff(). Two clients pressing "Save & apply", or a save landing during
# startup, otherwise run the whole (re-)initialization concurrently: makeRoof() interleaves
# its stopRoof()/reset()/Roof()/thread-start with another copy of itself, roofThread gets
# overwritten, and each worker start can be run twice -- both callers see the old thread
# alive, both stop it, both start a new one.
#
# asyncio rather than threading, because every caller is on the event loop and a waiter has
# to yield rather than block it. Bound to the loop on first use, which is fine with the one
# loop the app has; a test process that runs several loops has to replace it between them.
initLock = asyncio.Lock()

# Set once the shutdown handler starts, so an initStuff() that has not begun yet returns
# instead of rebuilding what is being torn down. Read and written on the event loop only.
shuttingDown = False

# How long shutdown() waits for a settings save to finish applying before tearing down
# underneath it. A full initStuff() is fifteen to twenty seconds -- stopRoof alone can spend
# roofStopBudget() joining its worker and another on roofLock, which is 7s each at the
# shipped roof_timeout of 0.2 and 9s each at its 0.3 ceiling -- so this has to be comfortably
# more than that, and still bounded: a wedged serial port must not be able to hold the
# process open against whatever grace period the service manager allows.
#
# Marginal at the ceiling, and knowingly so. Expiring is not a failure here: the handler logs
# it and tears down anyway, on the stated grounds that an exit which cannot complete is worse
# than the race. Raising it trades that race against a slower exit, which is a service-manager
# question rather than an arithmetic one.
shutdownInitLockTimeout = 20

async def initStuff():
    """(Re-)initializes the roof, the switches and the background workers.

    Called at startup and again whenever settings are saved. Both callers run on the
    event loop, so everything that blocks -- joining worker threads, opening the roof
    and environment serial ports, each of which can take seconds on a wedged USB
    bridge -- is pushed to a worker thread. initSwitches() stays on the event loop:
    it can rewrite settings storage, which has to happen there (see applyFanMode), and
    is only GPIO work otherwise. It keeps its position between the two: makeRoof() drops
    the old Roof, and the motion relays it owned de-energize as they are collected, so a
    pin just handed from the roof to a switch would be pulled low again underneath the new
    switch if the switch were made first. startup() therefore does not reorder this -- it
    calls initSwitches() once itself, ahead of the whole thing, and this call then finds
    the unchanged pins already claimed and does nothing to them.

    The three steps are isolated from each other. A failure in one used to abandon the
    ones after it, so a single bad settings value could leave the process with no
    switches and no background threads at all until a restart -- and on the saveSettings
    path the exception died in the click handler, telling the user nothing. Each step now
    reports its own failure and the rest still run.

    Runs under initLock, so concurrent calls apply one after another instead of
    interleaving. Note what that does and does not promise: the settings themselves are
    already in storage before saveSettings() gets here, so a second save that lands while
    the first is still applying has its values picked up by whichever pass reads them
    next. What is guaranteed is that no two passes ever run at the same time.

    A pass that only gets the lock after shutdown() has started does nothing at all.
    Re-opening two serial ports and starting three workers while the teardown that was
    meant to be final is running would leave the process exiting with a roof it had
    already switched off -- see shutdown().
    """
    async with initLock:
        if shuttingDown:
            logger.info("Shutting down, not applying settings")
            return
        try:
            await asyncio.to_thread(makeRoof)
        except Exception as e:
            msg = "Error initializing roof: {}".format(e)
            logger.error(msg)
            triggerEvent("error", msg)
        try:
            initSwitches()
        except Exception as e:
            msg = "Error initializing switches: {}".format(e)
            logger.error(msg)
            triggerEvent("error", msg)
        try:
            await asyncio.to_thread(startWorkers)
        except Exception as e:
            msg = "Error starting workers: {}".format(e)
            logger.error(msg)
            triggerEvent("error", msg)

@app.on_shutdown
async def shutdown():
    """Tears everything down at once, and off the event loop.

    Every one of these blocks. Each worker stop joins its thread with a five second
    timeout; stopEnvironmentWorker then spends up to another five seconds acquiring its
    lock and up to five flushing the write API; stopRoof joins, then waits on roofLock to
    switch the fans off, which was measured at nearly twelve seconds against a wedged
    serial port. Run one after another on the event loop -- as three of these were -- that
    is half a minute of a blocked loop while uvicorn is trying to close the client
    websockets.

    Run together in threads instead, so the cost is the slowest teardown rather than their
    sum. They contend for nothing: the roof and the environment worker hold different
    locks, and the capture and weather loops hold none. The one interleaving that can
    happen is the weather worker posting a fan command through updateFans while stopRoof
    is tearing the roof down, which is harmless -- the mailbox is cleared at the start of
    stopRoof and anything landing after it belongs to a roof that no longer exists, in a
    process that is exiting.

    That last argument holds only while nothing re-creates the roof afterwards, and a
    settings save in flight does exactly that: makeRoof() would take roofLock after this
    handler released it, build a fresh Roof, open the port and start a worker -- after the
    teardown had already switched the fans off and stopped the weather worker. The process
    would then exit with the port open and the fans running, and nothing left to switch
    them off, since RPi.GPIO leaves pin state untouched at exit. So the teardown runs under
    initLock, and shuttingDown stops any pass that has not started yet. The wait is bounded
    and proceeds anyway on expiry: an exit that cannot complete is worse than the race.

    asyncio.to_thread rather than run.io_bound: NiceGUI tears down its own executor on
    shutdown. Failures are collected rather than raised, because one teardown that throws
    must not leave the other three unreported.
    """
    global shuttingDown
    # Before the lock is even attempted, so a save already waiting on initLock finds it
    # set the moment it gets in rather than starting a re-initialization behind us.
    shuttingDown = True
    holdingInitLock = False
    try:
        await asyncio.wait_for(initLock.acquire(), timeout=shutdownInitLockTimeout)
        holdingInitLock = True
    except asyncio.TimeoutError:
        logger.error(
                "Settings were still being applied {}s into shutdown; tearing down "
                "anyway. The roof may be left as that pass configured it".format(
                    shutdownInitLockTimeout))
    try:
        stops = (
                # First of the tuple, though these run concurrently: it is the one that
                # only reads, so nothing is lost by retiring it before the workers whose
                # state it was recording are torn down underneath it.
                ("state worker", stopStateWorker),
                ("capture loop", stopCaptureLoop),
                ("environment worker", stopEnvironmentWorker),
                ("weather worker", stopWeatherWorker),
                ("roof", stopRoof),
                )
        results = await asyncio.gather(
                *(asyncio.to_thread(stop) for _, stop in stops),
                return_exceptions=True
                )
        for (name, _), result in zip(stops, results):
            if isinstance(result, BaseException):
                logger.error("Error stopping {}: {}".format(name, result))
    finally:
        if holdingInitLock:
            initLock.release()

@app.on_startup
async def startup():
    global mainLoop
    mainLoop = asyncio.get_event_loop()
    # Switches first, before anything that can block. A switch set to restore its last
    # state powers equipment that is already running -- the observatory PC above all --
    # and it has to reach that state as early as possible. initStuff() opens the roof's
    # serial port first, which costs seconds on a wedged USB bridge, and a save landing
    # during startup can stretch that further. Only the pins are claimed here; initStuff()
    # calls initSwitches() again a moment later, which is free for pins that have not
    # changed. triggerEvent() only needs mainLoop, set above -- updateQueue buffers until
    # updateWorker is spawned, and no client is connected this early anyway.
    #
    # Under initLock, and released again before initStuff() takes it -- the lock is not
    # reentrant. No client exists yet at this point, so nothing can contend it; holding it
    # anyway costs nothing and makes the ordering guarantee independent of that argument.
    async with initLock:
        initSwitches()
    spawn(updateWorker())
    await initStuff()
    # Last, and after initStuff(): uvicorn's own handlers are in place by now, so there is
    # something to chain to, and the roof this stops exists. A signal arriving before this
    # line still gets the graceful shutdown uvicorn has always given it.
    installExitSignalHandlers()

# The slice of this file the API is allowed to touch, named one by one.
#
# apiv1 cannot import this module: it is a script run as __main__, and it imports apiv1
# itself. Handing over a namespace is the way round that, and doing it by explicit keyword
# rather than by passing globals() is the point -- this list *is* the contract, and a
# function that is not on it is one the API cannot reach. Bound here, at the end, so every
# name exists; the routes are registered at import time and answer 503 until this runs,
# which is before uvicorn has accepted a connection.
#
# Only callables and objects that are never rebound. Mutable module-level state --
# roofEngaged, weatherCache, lastRoofState -- is deliberately absent: the API reads it
# through the accessors above, which is what stops it from capturing a value that then goes
# stale for the life of the process.
apiv1.bind(
        roof=roof,
        switch=switch,
        settings=s,
        RoofStatus=RoofStatus,
        roofMotion=roofMotion,
        roofDecisiveState=roofDecisiveState,
        roofCommandsBlocked=roofCommandsBlocked,
        roofUnavailableReason=roofUnavailableReason,
        getRoofState=getRoofState,
        getRoofDrive=getRoofDrive,
        roofStateMaxAge=roofStateMaxAge,
        requestRoofMotion=requestRoofMotion,
        requestClearRoofFault=requestClearRoofFault,
        requestRoofEngaged=requestRoofEngaged,
        # Three functions rather than the rainOverride flag itself, for the reason stated
        # just above: the flag is rebound, and a bound copy of it would be a value that went
        # stale for the life of the process. rainReason() and rainInterlockReason() are both
        # here because the API has to be able to report the weather and the decision
        # separately -- an override is only legible next to what it is overriding.
        rainReason=rainReason,
        rainInterlockReason=rainInterlockReason,
        rainOverrideActive=rainOverrideActive,
        setRainOverride=setRainOverride,
        rainReading=rainReading,
        # An int that is never rebound, so it goes over as a value like roofStateMaxAge
        # does. It is the number the API has to quote when no threshold is configured.
        rainThresholdDefault=rainThresholdDefault,
        switchNames=switch_names,
        getSwitchState=getSwitchState,
        setSwitchState=setSwitchState,
        switchConfigured=switchConfigured,
        applyFanMode=applyFanMode,
        getWeatherCache=getWeatherCache,
        getEnvironment=getEnvironment,
        environmentStateMaxAge=environmentStateMaxAge,
        numericSetting=numericSetting,
        )

try:
    ui.run(dark=True, favicon="favicon.svg", port=args.port, reload=False)
except KeyboardInterrupt:
    logger.info("Shutdown requested, exiting")
