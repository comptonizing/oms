def checkRoofPins():
    if not s.has("roof_pins_west_close") or s.q("roof_pins_west_close") == "":
        return False
    if not s.has("roof_pins_west_open") or s.q("roof_pins_west_open") == "":
        return False
    if not s.has("roof_pins_east_close") or s.q("roof_pins_east_close") == "":
        return False
    if not s.has("roof_pins_east_open") or s.q("roof_pins_east_open") == "":
        return False
    if not s.has("roof_port") or s.q("roof_port") == "":
        return False
    return True

roofLock = threading.Lock()
roofThread = None
roofStopEvent = threading.Event()
lastRoofState = [False] * (max(c.value for c in roof.ResponseState) + 1)
lastRoofIconUpdate = time.time()
roofIconUpdateInterval = 3

def getLastRoofState():
    global lastRoofState
    return lastRoofState

def roofLoop():
    global roofThread, roofStopEvent, lastRoofState, roofLock, lastRoofIconUpdate
    while not roofStopEvent.is_set():
        time.sleep(0.05)
        try:
            with roofLock:
                currentRoofState = roof.Roof.get().getStatus()
            if currentRoofState != lastRoofState or time.time() - lastRoofIconUpdate > roofIconUpdateInterval:
                triggerEvent("roofUpdate", currentRoofState)
                lastRoofIconUpdate = time.time()
                lastRoofState = currentRoofState
        except Exception as e:
            logger.error("Error in roof thread: {}".format(e))


def makeRoof():
    global roofThread, roofStopEvent, lastRoofState, roofLock
    if roofThread is not None and roofThread.is_alive():
        logger.info("Stopping roof thread")
        roofStopEvent.set()
        roofThread.join()
        roofThread = None
    with roofLock:
        roof.Roof.reset()
        if not checkRoofPins():
            triggerEvent("roofUpdate", None)
            return False
        baud = 9600
        if s.has("roof_baud"):
            baud = s.q("roof_baud")
        timeout = 1
        if s.has("roof_timeout"):
            timeout = s.q("roof_timeout")
        try:
            roof.Roof(
                    s.q("roof_pins_west_open"),
                    s.q("roof_pins_west_close"),
                    s.q("roof_pins_east_open"),
                    s.q("roof_pins_east_close"),
                    s.q("roof_port"),
                    baud = baud,
                    timeout = timeout)
            triggerEvent("roofUpdate", roof.Roof.get().getStatus())
            roofThread = threading.Thread(target=roofLoop, name="OMS roof worker")
            roofThread.start()
        except Exception as e:
            logger.error("Could not initialize roof: {}".format(e))
            roofThread = None
            roof.Roof.reset()
            triggerEvent("roofUpdate", None)
            return False

    fans = s.q("fan_mode", fallback=None)
    if fans is not None:
        setFans(fans)
    return True

def setFans(mode, auto=False):
    with roofLock:
        if not roof.Roof.isInitialized():
            return
        logger.info(f"Switching fans {mode}")
        try:
            if mode == "on":
                status = roof.Roof.get().fansOn()
            elif mode == "off":
                status = roof.Roof.get().fansOff()
        except Exception as e:
            logger.error("Error setting fans to {}: {}".format(mode, e))
            return
    triggerEvent("fanUpdate", mode, auto)
    triggerEvent("roofUpdate", status)


def setFanMode(mode):
