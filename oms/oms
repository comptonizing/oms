    def updateStream():
        if last_stream_image is not None:
            with last_stream_image_lock:
                status_stream_image.set_source(last_stream_image)

    def updateWeather():
        try:
            data = apiv1.weather()
            if data.status_code != 200:
                raise Exception("Error getting weather")
        except:
            for thing in weather_labels.values():
                thing.set_text("Error")
                thing.classes("text-xl text-red-500")
            return
        d = json.loads(data.body)
        temperature = d["env_temperature"]
        colstr = ""
        if temperature < -20:
            colstr = "text-red-500"
        elif temperature < -10:
            colstr = "text-orange-500"
        elif temperature < 25:
            colstr = "text-green-500"
        elif temperature < 35:
            colstr = "text-orange-500"
        else:
            colstr = "text-red-500"
        weather_labels["env_temperature"].set_text("{:.1f} °C".format(temperature))
        weather_labels["env_temperature"].classes("text-xl " + colstr)

        humidity = d["env_humidity"]
        if humidity < 10:
            colstr = "text-red-500"
        elif humidity < 20:
            colstr = "text-orange-500"
        elif humidity < 80:
            colstr = "text-green-500"
        elif humidity < 90:
            colstr = "text-orange-500"
        else:
            colstr = "text-red-500"
        weather_labels["env_humidity"].set_text("{:.1f} %".format(humidity))
        weather_labels["env_humidity"].classes("text-xl " + colstr)

        dewpoint = d["env_dewpoint"]
        weather_labels["env_dewpoint"].set_text("{:.1f} °C".format(dewpoint))
        weather_labels["env_dewpoint"].classes("text-xl")

        rain = d["rain_percentage"]
        if rain < 5:
            colstr = "text-green-500"
        elif rain < 10:
            colstr = "text-orange-500"
        else:
            colstr = "text-red-500"
        weather_labels["rain_percentage"].set_text("{:.0f} %".format(rain))
        weather_labels["rain_percentage"].classes("text-xl " + colstr)

        elevation = s.q("weather", "elevation")
        pressure = d["env_pressure"] + ((d["env_pressure"] * 9.80665 * elevation)/(287 * (273 + temperature + (elevation/400))))
        weather_labels["env_pressure"].set_text("{:.0f} hPa".format(pressure))
        weather_labels["env_pressure"].classes("text-xl")

        sqm = d["sqm_mpsas"]
        if sqm < 18:
            colstr = "text-red-500"
        elif sqm < 20:
            colstr = "text-orange-500"
        else:
            colstr = "text-green-500"

        weather_labels["sqm_mpsas"].set_text("{:.1f}".format(sqm))
        weather_labels["sqm_mpsas"].classes("text-xl " + colstr)

        ir_sky = d["ir_sky"]
        weather_labels["ir_sky"].set_text("{:.1f} °C".format(ir_sky))
        weather_labels["ir_sky"].classes("text-xl")

        ir_diff = d["ir_diff"]
