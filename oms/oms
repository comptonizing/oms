switch_names = ["pier", "cctv", "pc", "allsky"]
switches = {}

def getSwitchState(name: str):
    if name not in switches:
        return switch.State.UNKN
    return switches[name]["switch"].state

def initSwitch(name: str, pin: int, init: str, last: str):
    if init == "on":
        initState = switch.State.ON
    elif init == "off":
        initState = switch.State.OFF
    elif init == "last":
        if last == "on":
            initState = switch.State.ON
        else:
            initState = switch.State.OFF
    if name in switches:
        if switches[name]["switch"].pin == pin:
            switches[name]["init"] = init
            return
        del switches[name]

    switches[name] = {
            "switch": switch.Switch(pin, init=initState),
            "init": init
            }

def deinitSwitch(name: str):
    pass

def initSwitches():
    names = switch_names
    for name in names:
        pin = s.q(name + "_pin", fallback=None)
        init = s.q(name + "_init", fallback=None)
        last = s.q(name + "_last", fallback=None)
        if pin is None:
            logger.warn("Pin for {} is not set up in settings, skipping".format(name))
            continue
        pin = int(pin)
        if pinUsedForRoof(pin):
            logger.warn("Switch for {} with pin {} is already in use for roof, removing".format(name, pin))
            s.rm(name + "_pin")
            s.rm(name + "_init")
            s.rm(name + "_last")
            continue
        initSwitch(name, pin, init, last)

addSwitchLock = threading.Lock()
def addSwitch(name: str, pin: int, init: str):
    with addSwitchLock:
        logger.debug("Adding switch {} pin {} initial {}".format(name, pin, init))
        if pinUsedForRoof(pin):
            raise ValueError("Pin {} already used for roof".format(pin))
        if name in switches.keys():
            raise ValueError("Switch with name {} already defined".format(name))
        for thing in switches:
            if switches[thing]["switch"].pin == pin:
                raise ValueError("Pin {} already used for switch {}".format(pin, thing))
        last = init
        if last == "last":
            last = "off"
        initSwitch(name, pin, init, last)
        stored = s.q("switches")
        stored[name] = {
                "pin": pin,
                "init": init,
                "last": last,
                }
        s.p("switches", stored)

removeSwitchLock = threading.Lock()
def removeSwitch(name: str):
    with removeSwitchLock:
        logger.debug("Removing switch {}".format(name))
        stored = s.q("switches")
        if name in stored:
            del stored[name]
            s.p("switches", stored)
        if name in switches:
            del switches[name]

setSwitchStateLock = threading.Lock()
def setSwitchState(name: str, state: switch.State):
    with setSwitchStateLock:
        stateString = switch.State.toString(state)
        logger.info(f"Setting switch {name} to {stateString}")
        switches[name]["switch"].setState(state)
        s.p(name + "_last", stateString)
        triggerEvent("setSwitchState", name, stateString)


def makeRoof():
    Roof.reset()
    if not s.has("roof_pins_west_close") or s.q("roof_pins_west_close") == "":
        return False
    if not s.has("roof_pins_west_open") or s.q("roof_pins_west_open") == "":
        return False
    if not s.has("roof_pins_east_close") or s.q("roof_pins_east_close") == "":
        return False
    if not s.has("roof_pins_east_open") or s.q("roof_pins_east_open") == "":
        return False
    if not s.has("roof_port") or s.q("roof_port") == "":
        return False
    baud = 9600
    if s.has("roof_baud"):
        baud = s.q("roof_baud")
    timeout = 1
    if s.has("roof_timeout"):
        timeout = s.q("roof_timeout")
    try:
        Roof(
                s.q("roof_pins_west_open"),
                s.q("roof_pins_west_close"),
                s.q("roof_pins_east_open"),
                s.q("roof_pins_east_close"),
                s.q("roof_port"),
                baud = baud,
                timeout = timeout)
    except Exception as e:
        logger.error("Could not initialize roof: {}".format(e))
        roof.clear()


