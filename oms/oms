    def updateRoofIcons(status: roof.ResponseState | None):
        if status is None:
            # The limit switch indicators are keyed by the lower-cased RoofSwitch name,
            # so the set stays in step with roof.py by construction.
            for sw in roof.RoofSwitch:
                status_indicators[sw.name.lower()].props("color=gray")
            for thing in ["west_push_north", "west_push_south", "east_push_north", "east_push_south"]:
                status_indicators[thing].style("background-color: transparent")
            for thing in ["west_open", "west_close", "east_open", "east_close"]:
                status_indicators[thing].set_visibility(False)
            for thing in status_indicators["fans"]:
                thing.classes(add="animate-none", remove="animate-spin")
            return

        colors = ["red", "green"]
        # Iterating the enum rather than asking Roof for switchStates(): this runs on
        # every roof update, including ones that arrive with no roof configured, and it
        # must not depend on the singleton being there.
        for sw in roof.RoofSwitch:
            status_indicators[sw.name.lower()].props(f"color={colors[status[sw.bit]]}")

        colors = ["background-color: transparent", "background-color: gray"]
        status_indicators["west_push_north"].style(colors[status[roof.ResponseState.WEST_STATE.value]])
        status_indicators["west_push_south"].style(colors[status[roof.ResponseState.WEST_STATE.value]])
        status_indicators["east_push_north"].style(colors[status[roof.ResponseState.EAST_STATE.value]])
        status_indicators["east_push_south"].style(colors[status[roof.ResponseState.EAST_STATE.value]])

        animateAdd = ["animate-none", "animate-spin"][status[roof.ResponseState.FANS.value]]
        animateRemove = ["animate-spin", "animate-none"][status[roof.ResponseState.FANS.value]]
        for thing in status_indicators["fans"]:
            thing.classes(add=animateAdd, remove=animateRemove)

        # The arrows already carry animate-pulse from where they were built, so lighting
        # one is purely a matter of visibility. Which way a half is being driven is not in
        # `status` at all -- the four motion relays are Pi GPIO and the board cannot see
        # them -- so it comes from the worker's separate publish. Read through
        # getRoofDrive() rather than roof.Roof.get(): this runs with a non-None status even
        # when no roof exists (onConnect passes an all-False list), and the singleton would
        # raise ValueError there and take out the connect handler.
        #
        # The two arrows on a side are mutually exclusive by construction, because
        # driving() answers with one direction or None.
        drive = getRoofDrive()
        for half in roof.RoofHalf:
            side = half.value.lower()
            status_indicators[side + "_open"].set_visibility(
                    drive.get(half) is roof.Direction.OPEN)
            status_indicators[side + "_close"].set_visibility(
                    drive.get(half) is roof.Direction.CLOSE)

    def updateRoofStaleness():
        """Shows/hides the "last updated" label under the roof diagram.

        Ticks on its own timer rather than off the roofUpdate event: a worker that has
        gone silent -- the one case this exists to catch -- never fires that event again,
        so nothing event-driven would ever notice. getRoofState() is read straight from
        the worker's own publish, independent of whatever this client last happened to be
        shown.
        """
        status, age = getRoofState()
        if status is None:
            # Nothing published yet, or the roof was torn down -- updateRoofIcons()
            # already grays the whole diagram out for this, and there is no real
            # last-known age to report alongside it.
            status_roof_stale.set_visibility(False)
            return
        if age > roofStateMaxAge:
            status_roof_stale.set_text("last updated {}s ago".format(int(age)))
            status_roof_stale.set_visibility(True)
        else:
            status_roof_stale.set_visibility(False)

    def updateStream():
        reason = cctvUnavailableReason()
        frameTime = None
        if reason is None:
            with last_stream_image_lock:
                frame = last_stream_image
                frameTime = last_stream_image_time
            if frame is None:
                # The worker has not come back with anything yet -- either it has just
                # started, or the camera was only just switched on and is still booting.
                reason = "Waiting for the stream ..."
            else:
                status_stream_image.set_source(frame)
        showUnavailable(status_stream_image, status_stream_message, reason)
        # Only judged while the image itself is on screen: showUnavailable() already
        # explains an unconfigured or not-yet-arrived stream, and a second label saying
        # the same thing in different words would only be noise.
        if reason is None and frameTime:
            age = time.monotonic() - frameTime
            if age > numericSetting("stream_refresh", 5) * 3:
                status_stream_stale.set_text("last updated {}s ago".format(int(age)))
                status_stream_stale.set_visibility(True)
            else:
                status_stream_stale.set_visibility(False)
        else:
            status_stream_stale.set_visibility(False)

