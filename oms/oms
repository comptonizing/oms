def grabRTSP(url, timeout=5):
    logger.debug("Grabbing frame from {}".format(url))
    try:
        logger.debug("Opening capture")
        cap = cv2.VideoCapture(url, cv2.CAP_FFMPEG)
        cap.set(cv2.CAP_PROP_OPEN_TIMEOUT_MSEC, timeout * 1000)
        cap.set(cv2.CAP_PROP_READ_TIMEOUT_MSEC, timeout * 1000)

        if not cap.isOpened():
            raise Exception("Failed to open RTSP stream at {}".format(url))
        logger.debug("Reading frame")
        ok, frame = cap.read()
        if not ok:
            raise Exception("Failed to read frame from stream at {}".format(url))
        if frame is None:
            raise Exception("Received empty frame from {}".format(url))
        return Image.fromarray(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
    finally:
        if cap is not None:
            cap.release()


def create_error_image(text: str):
    img = Image.new('RGB', (640, 360), color=(40, 40, 40))
    draw = ImageDraw.Draw(img)

    draw.text((20, 20), text, fill=(255, 255, 255))

    buffer = BytesIO()
    img.save(buffer, format='PNG')

    encoded = base64.b64encode(buffer.getvalue()).decode()

    return f'data:image/png;base64,{encoded}'



last_stream_image = None
last_stream_image_lock = threading.Lock()

def capture_loop():
    global last_stream_image
    while True:
        try:
            frame = grabRTSP(s.q("stream", "rtsp"))
        except Exception as e:
            frame = create_error_image(e)
        with last_stream_image_lock:
            last_stream_image = frame


