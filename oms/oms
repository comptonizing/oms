            colstr = "text-red-500"
        elif ir_diff < 20:
            colstr = "text-orange-500"
        else:
            colstr = "text-green-500"
        weather_labels["ir_diff"].set_text("{:.1f} °C".format(ir_diff))
        weather_labels["ir_diff"].classes("text-xl " + colstr)

        wind_speed = d["wind_speed"]
        if wind_speed < 15:
            colstr = "text-green-500"
        elif wind_speed < 20:
            colstr = "text-orange-500"
        else:
            colstr = "text-red-500"
        weather_labels["wind_speed"].set_text("{:.1f} km/h".format(wind_speed))
        weather_labels["wind_speed"].classes("text-xl " + colstr)

        wind_gust = d["wind_gust"]
        if wind_gust < 30:
            colstr = "text-green-500"
        elif wind_gust < 40:
            colstr = "text-orange-500"
        else:
            colstr = "text-red-500"
        weather_labels["wind_gust"].set_text("{:.1f} km/h".format(wind_gust))
        weather_labels["wind_gust"].classes("text-xl " + colstr)





