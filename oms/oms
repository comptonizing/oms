    # time.monotonic() of the last successful plot draw, or 0.0 if there has never been
    # one. Separate from plotRun, which tracks the pass in flight rather than the last
    # one to finish.
    lastPlotDraw = Container(0.0)

    def updatePlotStaleness():
        ts = lastPlotDraw.get()
        if not ts:
            weather_plot_stale_label.set_visibility(False)
            return
        age = time.monotonic() - ts
        maxAge = numericSetting("weather_plot_refresh", 60) * 3
        if age > maxAge:
            weather_plot_stale_label.set_text("last updated {}s ago".format(int(age)))
            weather_plot_stale_label.set_visibility(True)
        else:
            weather_plot_stale_label.set_visibility(False)

    async def updatePlots(*, supersede=True):
        """Redraws the plots. Latest wins, unless the caller asks not to.

        Both the refresh timer and the time-range selector land here, and a pass takes
        long enough that they overlap: a range change during a timer run left two
        coroutines mutating the same figures, one doing fig.data = [] part-way through the
        other's add_scatter.

        The pass in flight is cancelled rather than queued behind, or dropped. Every
        figure is rebuilt from scratch, so a half-finished pass has nothing worth keeping,
        and cancelling is what makes the range selector feel immediate -- dropping the new
        request would ignore the click, and queueing it would answer it seconds late.

        Cancelling suspends, so the swap has to happen under a lock or it reintroduces
        exactly what it exists to prevent: two callers arriving together both read the
        same pass, both find it not done -- a cancel is not delivered until the task next
        runs -- both await it, and both then spawn a replacement. Two passes on the same
        figures again, and plotRun holding only the second, so cancelPlots() could never
        reach the first and it would run on into the closed client it was querying.

        The lock covers the swap only, never the pass itself: a caller waiting for it
        goes on to supersede whatever it finds, which is still latest-wins and not a
        queue. Cancelling a pass that has already been cancelled is harmless, so the
        worst the wait costs is one replacement that is thrown away unstarted.

        supersede=False is the refresh timer's mode, and the difference is deliberate.
        A range-selector click or a save is a user gesture: it asks for something other
        than what is being drawn, so cancelling the pass in flight is the only answer
        that is not either late or wrong. A timer tick asks for exactly what the pass in
        flight is already computing, so cancelling it would mean a pass that takes longer
        than one refresh interval never finishes -- the plots would be permanently
        half-drawn on any database slow enough to matter. It drops itself instead, and
        the pass it found finishes and paints.
        """
        async with plotLock:
            running = plotRun.get()
            if running is not None and not running.done():
                if not supersede:
                    logger.debug("Plot refresh skipped: the previous pass is still running")
                    return
                running.cancel()
                try:
                    await running
                except asyncio.CancelledError:
                    pass
                except Exception as e:
                    logger.debug("Superseded plot pass ended with {}".format(e))
            task = spawn(_drawPlots())
            plotRun.set(task)
        try:
            await task
        except asyncio.CancelledError:
            # Superseded by a newer pass, which owns the figures now.
            pass

    def refreshPlots():
        """The refresh timer's entry point: start a pass, do not wait it out.

        ui.timer sleeps `interval - dt`, where dt is how long its callback took
        (nicegui/timer.py:97). updatePlots awaits the pass to completion, so pointing the
        timer straight at it made dt the length of the whole pass -- and a pass longer
        than the interval made that sleep negative, which returns at once. The result was
        plot passes running back to back forever instead of one per interval: fifteen
        queries, twenty add_scatter calls and five figure pushes, continuously, on the
        event loop that also serves the rest of the GUI.

        It does not take a sick database to get there. A pass over a 24h range is a few
        seconds of work on the Pi, so a "Plot refresh (s)" of 5 is enough -- and that
        field takes any number the operator types (see the interval validation still
        outstanding). Spawning and returning keeps dt at zero, so the ticks are spaced by
        the interval that was actually configured, whatever the database is doing.

        Returning without the result also means the tick cannot report a failure, which
        costs nothing here: _drawPlots answers a database error by painting it onto the
        figures rather than raising. Anything that does escape it lands in asyncio's
        handler, the same way it already does for the two spawn(updatePlots()) callers
        below.
        """
        spawn(updatePlots(supersede=False))

    def cancelPlots():
        """Stop an in-flight pass because the client it is querying is about to close.

        A pass holds one query API across all fifteen of its queries, so closing the
        client underneath it fails the rest of them with "Connector is closed."  Cancelling
        first means the pass stops at its current await instead of running into that.
        """
        running = plotRun.get()
        if running is not None and not running.done():
            running.cancel()
        plotRun.clear()

    async def blankPlots(message):
        """Replace every figure with one centred line of text.

        The axes are hidden along with the data: an empty grid with a note floating over
        it reads as a plot that failed to draw, rather than as one with nothing to draw.
        Pushed through pushPlot() like any other pass, so blanking eight figures does not
        stall the page any more than filling them does.
        """
        for plot in weather_plots.values():
            plot.figure.data = []
            plot.figure.update_layout(
                    annotations=[dict(
                        text=message,
                        xref='paper', yref='paper',
                        x=0.5, y=0.5,
                        xanchor='center', yanchor='middle',
                        showarrow=False,
                        font=dict(size=16, color='gray'),
                    )],
                    xaxis=dict(visible=False),
                    yaxis=dict(visible=False),
                )
            await pushPlot(plot)

    async def _drawPlots():
        # One API for the whole pass, so the fifteen queries below are answered by one
        # client and cannot straddle two. Which client it was matters in the handler.
        api = query_api.get()
        try:
            if api is None:
                # No database configured at all. Silently blank plots look like a fault
                # that swallowed its own error, so say what is missing and where to fix it.
                await blankPlots('No database configured (see Settings)')
                return
            for plot in weather_plots.values():
                plot.figure.layout.annotations = []
                plot.figure.update_xaxes(visible=True)
                plot.figure.update_yaxes(visible=True)
            await _updatePlots(api)
            lastPlotDraw.set(time.monotonic())
        except Exception as e:
            if query_api.get() is not api:
                # Not a database fault: the client this pass was querying was closed
                # underneath it -- a settings save or a disconnect -- so its remaining
                # queries failed with "Connector is closed." Whoever replaced the client
                # draws next; painting an error over the figures would only flash.
                logger.debug("Plot pass dropped: its database client was replaced ({})".format(e))
                return
            logger.error(f"Error updating weather plots: {e}")
            await blankPlots('No data available (check logs)')
        finally:
            # Runs on every path, including cancellation: whether this pass drew, failed,
            # or was superseded, the label must reflect the true age of the last drawing
            # that actually finished, not the outcome of this particular attempt.
            updatePlotStaleness()

    # Tailwind's text colours are mutually exclusive, so a new one has to take the old
    # one off the element: which of two present classes wins is decided by stylesheet
    # order, not by the order they were added in.
    weather_label_colors = "text-red-500 text-orange-500 text-green-500 text-gray-500"

    def updateWeather():
        labelSize = "text-3xl"

        def setLabel(name, text, color=""):
            """Write one weather value, taking off whatever colour the label had before.

            Every writer has to go through here: a label keeps the colour it was last
            given, so the red left behind by an "Error" pass would otherwise outlive the
            good reading that replaced it.
            """
            thing = weather_labels[name]
            thing.set_text(text)
            thing.classes((labelSize + " " + color).strip(), remove=weather_label_colors)

        reason = weatherUnavailableReason()
        if reason is None and weatherWarmingUp():
            reason = "the station has not answered since it came back yet"
        if reason is not None:
            # Not an error: either the station is unreachable because the allsky camera it
            # hangs off is not running -- which the allsky card next to this already
            # spells out -- or it is reachable but still warming up.
            logger.debug("No weather data expected: {}".format(reason))
            for thing in weather_labels.values():
                thing.set_text("N/A")
                thing.classes(labelSize + " text-gray-500", remove=weather_label_colors)
            weather_stale_label.set_visibility(False)
            return
        with weatherCacheLock:
            d = weatherCache
            cacheTimestamp = weatherCacheTimestamp
        weatherAge = time.monotonic() - cacheTimestamp
        weatherMaxAge = numericSetting("weather_refresh", 5) * 3
        if d is None or weatherAge > weatherMaxAge:
            logger.warning("No recent weather data available")
            for thing in weather_labels.values():
                thing.set_text("Error")
                thing.classes(labelSize + " text-red-500", remove=weather_label_colors)
            # 0.0 means the cache has never held anything at all, so there is no real
            # last-known age to report -- "Error" above already says all there is to say.
            if cacheTimestamp > 0.0:
                weather_stale_label.set_text("last updated {}s ago".format(int(weatherAge)))
                weather_stale_label.set_visibility(True)
            else:
                weather_stale_label.set_visibility(False)
            return
        weather_stale_label.set_visibility(False)
        # Coerced up front, and every block below tests for None: a field the station
        # left out or sent as null shows as absent on its own label. Comparing it against
        # a threshold raises, and one raise used to cost every field after it its update
        # -- the labels then held old readings while looking current.
        numbers = {name: asNumber(d.get(name)) for name in weather_labels}
        absent = sorted(name for name, value in numbers.items() if value is None)
        if absent:
            logger.debug("Weather fields not usable: {}".format(", ".join(absent)))
        for name in absent:
            setLabel(name, "N/A", "text-gray-500")

        try:
            temperature = numbers["env_temperature"]
            if temperature is not None:
                colstr = ""
                if temperature < -20:
                    colstr = "text-red-500"
                elif temperature < -10:
                    colstr = "text-orange-500"
                elif temperature < 25:
                    colstr = "text-green-500"
                elif temperature < 35:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("env_temperature", "{:.1f} °C".format(temperature), colstr)

            humidity = numbers["env_humidity"]
            if humidity is not None:
                if humidity < 10:
                    colstr = "text-red-500"
                elif humidity < 20:
                    colstr = "text-orange-500"
                elif humidity < 80:
                    colstr = "text-green-500"
                elif humidity < 90:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("env_humidity", "{:.1f} %".format(humidity), colstr)

            dewpoint = numbers["env_dewpoint"]
            if dewpoint is not None:
                setLabel("env_dewpoint", "{:.1f} °C".format(dewpoint))

            rain = numbers["rain_percentage"]
            if rain is not None:
                if rain < 5:
                    colstr = "text-green-500"
                elif rain < 10:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("rain_percentage", "{:.0f} %".format(rain), colstr)

            # No elevation entered means no sea-level correction, which is what an
            # elevation of zero computes anyway -- not a default, an identity.
            elevation = numericSetting("weather_elevation", 0)
            pressure = numbers["env_pressure"]
            if pressure is not None and elevation and temperature is None:
                # The correction needs the temperature. Without it the raw reading would
                # be wrong by more than it is worth showing, so leave the N/A standing.
                logger.debug("No temperature, so no sea-level correction for the pressure")
            elif pressure is not None:
                if elevation:
                    pressure += (pressure * 9.80665 * elevation)/(287 * (273 + temperature + (elevation/400)))
                setLabel("env_pressure", "{:.0f} hPa".format(pressure))

            sqm = numbers["sqm_mpsas"]
            if sqm is not None:
                if sqm < 18:
                    colstr = "text-red-500"
                elif sqm < 20:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-green-500"
                setLabel("sqm_mpsas", "{:.1f}".format(sqm), colstr)

            ir_sky = numbers["ir_sky"]
            if ir_sky is not None:
                setLabel("ir_sky", "{:.1f} °C".format(ir_sky))

            ir_diff = numbers["ir_diff"]
            if ir_diff is not None:
                if ir_diff < 15:
                    colstr = "text-red-500"
                elif ir_diff < 20:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-green-500"
                setLabel("ir_diff", "{:.1f} °C".format(ir_diff), colstr)

            wind_speed = numbers["wind_speed"]
            if wind_speed is not None:
                if wind_speed < 15:
                    colstr = "text-green-500"
                elif wind_speed < 20:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("wind_speed", "{:.1f} km/h".format(wind_speed), colstr)

            wind_gust = numbers["wind_gust"]
            if wind_gust is not None:
                if wind_gust < 30:
                    colstr = "text-green-500"
                elif wind_gust < 40:
                    colstr = "text-orange-500"
                else:
                    colstr = "text-red-500"
                setLabel("wind_gust", "{:.1f} km/h".format(wind_gust), colstr)
        except Exception as e:
            logger.error("Error updating weather labels: {}".format(e))



    # Run once against the freshly built page, so what the client first renders is
    # already right: the timers below only fire a refresh period later.
    updateWeather()
    updateStream()
    updateAllskyImages()

    weather_range_select.on_value_change(updatePlots)

    timers = {}

    influx_client = Container()
    query_api = Container()

    def clearTimers():
        """Retires this client's refresh timers, for good.

        delete(), not cancel(). cancel() only sets Timer._is_canceled, and nicegui's
        Timer._should_stop() (elements/timer.py) reads that *last*:

            self.is_deleted or self.client.id not in Client.instances or super()...

        so it dereferences the client weakref before it ever looks at the flag. A
        cancelled timer is still parked in its asyncio.sleep and only re-tests that
        condition once the sleep expires -- so if nicegui collects the client in
        between, the middle term raises "The client this element belongs to has been
        deleted", which escapes the loop and takes Timer._cleanup()'s parent_slot
        assertion with it. That is the traceback cancelling these was meant to remove,
        and cancelling does not remove it. The window is one interval wide, and
        stream_refresh and weather_plot_refresh both go up to 600s.

        delete() sets _deleted, which _should_stop() tests *first* and short-circuits
        on without touching the client, which _cleanup() also tests before touching
        parent_slot, and which nicegui reaches through _handle_delete ->
        cancel(with_current_invocation=True). It also detaches the element: a cancelled
        timer stayed in the page (and as a timer.js component in the browser) until its
        sleep ran out, so every settings save left up to five of them behind per client.

        Guarded per timer, so that one failure cannot leave the rest attached.
        """
        for name, timer in timers.items():
            try:
                timer.delete()
            except Exception as e:
                logger.warning("Error deleting the {} timer: {}".format(name, e))
        timers.clear()

    def initTimers():
        """(Re-)creates the refresh timers, skipping the ones with no interval set.

        There is no default refresh interval -- an unconfigured one means the operator
        has not said how often to refresh, so nothing refreshes periodically until they
        do. ui.timer(None) would raise and take the whole settings-update handler with
        it. processSettingsUpdate() calls this again on every save, so a timer appears as
        soon as its interval is entered.

        The timers are created with immediate=False. ui.timer defaults to firing its
        callback at once, and both callers below already call all four callbacks
        themselves -- so every save and every connect ran the whole refresh twice per
        client, two plot passes included, precisely while the process is re-opening
        serial ports and restarting three workers. The explicit calls are the half that
        stays: a timer whose interval is unset is never created, so leaving the first
        paint to the timers would mean an unconfigured refresh interval paints nothing
        at all rather than painting once.
        """
        clearTimers()
        # (setting, callback, fallback). Only the plots carry a fallback, and it is a
        # local one at the single place that reads it, not a defaults table coming back:
        # a plot pass costs fifteen queries, so leaving it unset must not mean "as often
        # as the labels refresh". Sixty seconds is the operator's choice of a floor.
        intervals = {
                "update_allsky_images": ("weather_refresh", updateAllskyImages, None),
                "update_weather": ("weather_refresh", updateWeather, None),
                # refreshPlots, not updatePlots: the timer must not await the pass it
                # starts, or a slow pass compresses its own interval away.
                "update_plots": ("weather_plot_refresh", refreshPlots, 60),
                "update_stream": ("stream_refresh", updateStream, None),
                }
        for name, (setting, callback, fallback) in intervals.items():
            # The type and range check that used to be written out here lives in
            # numericSetting now, along with the same check for every other numeric
            # setting -- this was the only one that ever had it.
            interval = numericSetting(setting, fallback)
            if interval is None:
                logger.warning("No usable {} set, {} will not refresh".format(setting, name))
                continue
            timers[name] = ui.timer(interval, callback, immediate=False)
        # Roof staleness has no configured interval to key off -- roofStateMaxAge is a
        # fixed 5s threshold, not a setting -- so it is not in the table above and ticks
        # on its own short, fixed cadence instead.
        timers["update_roof_staleness"] = ui.timer(1.0, updateRoofStaleness, immediate=False)

    def makeInfluxClient():
        oldClient = influx_client.get()
        if oldClient is not None:
            cancelPlots()
            spawn(oldClient.close())
            influx_client.clear()
            query_api.clear()
        _db_url = s.q("weather_db_url", fallback=None)
        _db_token = s.q("weather_db_token", fallback=None)
        _db_org = s.q("weather_db_org", fallback=None)
        if _db_url not in [None, ""] and _db_token not in [None, ""] and _db_org not in [None, ""]:
            client = InfluxDBClientAsync(
                    url = _db_url,
                    token = _db_token,
                    org = _db_org
                    )
            influx_client.set(client)
            query_api.set(client.query_api())

    def processSettingsUpdate():
        makeInfluxClient()
        initTimers()
        updateButtons()
        # A saved URL or switch pin can have made either camera available or taken it
        # away; the timers would not notice until their next tick.
        updateStream()
        updateAllskyImages()
        updateWeather()
        updateRoofStaleness()
        # A database entered (or cleared) just now changes what the plots should say, and
        # they would otherwise keep the old message until their next tick a minute away.
        spawn(updatePlots())


    def onConnect():
        makeInfluxClient()
        initTimers()
        updateButtons()
        updateStream()
        updateAllskyImages()
        # The one callback this handler did not use to call for itself: the immediate
        # first tick of the weather timer was doing it, and that tick is gone. The page
        # body paints the labels once as it is built, but a client can connect a moment
        # later than that, and the alternative is labels a whole refresh interval stale.
        updateWeather()
        # getRoofState(), not the raw lastRoofState: stopRoof() zeroes the timestamp but
        # leaves the last real reading in place, so a client connecting after the roof
        # failed used to be shown convincing red/green limit-switch icons for a roof that
        # is not there. Clients already connected grey out on the roofUpdate None event;
        # this is the path that had no such event to receive. getRoofState() returns None
        # once the timestamp is zeroed, and updateRoofIcons handles None.
        updateRoofIcons(getRoofState()[0])
        updateRoofStaleness()
        # Drawn once here rather than left blank until the first timer tick, which is a
        # whole plot interval away -- a minute of empty plots on a page that has just
        # loaded looks like a fault. Cheap to do: a pass this early is the only one
        # running, and a range change moments later simply cancels it.
        spawn(updatePlots())
        updateCallbacks[ui.context.client.id] = update
    ui.context.client.on_connect(onConnect)

    def onDisconnect():
        updateCallbacks.pop(ui.context.client.id, None)
        # Left running, these keep looping after the client is gone, and once NiceGUI
        # garbage-collects it the next tick dereferences a dead weakref and raises the
        # "client ... has been deleted" traceback instead of stopping quietly. See
        # clearTimers() for why that needs delete() and why cancel() does not do it.
        clearTimers()
        oldClient = influx_client.get()
        if oldClient is not None:
            cancelPlots()
            spawn(oldClient.close())
            influx_client.clear()
            query_api.clear()
    ui.context.client.on_disconnect(onDisconnect)

    async def update(thing: list):
        logger.debug("Processing event: {}".format(thing))
        if thing[0] == "setSwitchState":
            ui.notify(f"Switch {thing[1]} was turned {thing[2]}")
            updateButtons()
            if thing[1] == "cctv":
                updateStream()
            elif thing[1] == "allsky":
                # Powering the allsky decides both its image and the weather data.
                updateAllskyImages()
                updateWeather()
            return
        if thing[0] == "updateSettings":
            processSettingsUpdate()
            return
        if thing[0] == "roofUpdate":
            updateRoofIcons(thing[1])
            return
        if thing[0] == "fanUpdate":
            ui.notify(f"Fans set to {thing[1]} ({"auto" if thing[2] else "manual"})")
            return
        if thing[0] == "fanError":
            ui.notify(f"Error setting fans to {thing[1]}: {thing[2]}", type="negative")
            return
        if thing[0] == "switchError":
            ui.notify(f"Error setting switch {thing[1]}: {thing[2]}", type="negative")
            return
        if thing[0] == "warning":
            ui.notify(f"Warning: {thing[1]}", type="warning")
            return
        if thing[0] == "error":
            ui.notify(f"Error: {thing[1]}", type="warning")
            return
        logger.error(f"Unknown update event, ignoring: {thing}")

    updateCallbacks[ui.context.client.id] = update

    tabs.set_value("Status")

    ui.run_javascript('''
        Promise.race([
            document.fonts.ready,
            new Promise(resolve => setTimeout(resolve, 3000))
        ]).then(() => {
            const el = document.getElementById('loading-overlay');
            if (el) {
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            }
        });
    ''')

def startWorkers():
    """Starts the three background workers, each independently.

    One worker failing to start must not keep the other two down: they share no state,
    and losing the capture loop is no reason to also lose the environment readings the
    fan safety logic depends on.
    """
    for name, start in (
            ("capture loop", startCaptureLoop),
            ("environment worker", startEnvironmentWorker),
            ("weather worker", startWeatherWorker),
            ):
        try:
            start()
        except Exception as e:
            msg = "Error starting {}: {}".format(name, e)
            logger.error(msg)
            triggerEvent("error", msg)

# Serializes initStuff(). Two clients pressing "Save & apply", or a save landing during
# startup, otherwise run the whole (re-)initialization concurrently: makeRoof() interleaves
# its stopRoof()/reset()/Roof()/thread-start with another copy of itself, roofThread gets
# overwritten, and each worker start can be run twice -- both callers see the old thread
# alive, both stop it, both start a new one.
#
# asyncio rather than threading, because every caller is on the event loop and a waiter has
# to yield rather than block it. Bound to the loop on first use, which is fine with the one
# loop the app has; a test process that runs several loops has to replace it between them.
initLock = asyncio.Lock()

# Set once the shutdown handler starts, so an initStuff() that has not begun yet returns
# instead of rebuilding what is being torn down. Read and written on the event loop only.
shuttingDown = False

# How long shutdown() waits for a settings save to finish applying before tearing down
# underneath it. A full initStuff() is ten to fifteen seconds -- stopRoof alone can spend
# five joining its worker and five more on roofLock -- so this has to be comfortably more
# than that, and still bounded: a wedged serial port must not be able to hold the process
# open against whatever grace period the service manager allows.
shutdownInitLockTimeout = 20

async def initStuff():
    """(Re-)initializes the roof, the switches and the background workers.

    Called at startup and again whenever settings are saved. Both callers run on the
    event loop, so everything that blocks -- joining worker threads, opening the roof
    and environment serial ports, each of which can take seconds on a wedged USB
    bridge -- is pushed to a worker thread. initSwitches() stays on the event loop:
    it can rewrite settings storage, which has to happen there (see applyFanMode), and
    is only GPIO work otherwise. It keeps its position between the two: makeRoof() drops
    the old Roof, and the motion relays it owned de-energize as they are collected, so a
    pin just handed from the roof to a switch would be pulled low again underneath the new
    switch if the switch were made first. startup() therefore does not reorder this -- it
    calls initSwitches() once itself, ahead of the whole thing, and this call then finds
    the unchanged pins already claimed and does nothing to them.

    The three steps are isolated from each other. A failure in one used to abandon the
    ones after it, so a single bad settings value could leave the process with no
    switches and no background threads at all until a restart -- and on the saveSettings
    path the exception died in the click handler, telling the user nothing. Each step now
    reports its own failure and the rest still run.

    Runs under initLock, so concurrent calls apply one after another instead of
    interleaving. Note what that does and does not promise: the settings themselves are
    already in storage before saveSettings() gets here, so a second save that lands while
    the first is still applying has its values picked up by whichever pass reads them
    next. What is guaranteed is that no two passes ever run at the same time.

    A pass that only gets the lock after shutdown() has started does nothing at all.
    Re-opening two serial ports and starting three workers while the teardown that was
    meant to be final is running would leave the process exiting with a roof it had
    already switched off -- see shutdown().
    """
    async with initLock:
        if shuttingDown:
            logger.info("Shutting down, not applying settings")
            return
        try:
            await asyncio.to_thread(makeRoof)
        except Exception as e:
            msg = "Error initializing roof: {}".format(e)
            logger.error(msg)
            triggerEvent("error", msg)
        try:
            initSwitches()
        except Exception as e:
            msg = "Error initializing switches: {}".format(e)
            logger.error(msg)
            triggerEvent("error", msg)
        try:
            await asyncio.to_thread(startWorkers)
        except Exception as e:
            msg = "Error starting workers: {}".format(e)
            logger.error(msg)
            triggerEvent("error", msg)

@app.on_shutdown
async def shutdown():
    """Tears everything down at once, and off the event loop.

    Every one of these blocks. Each worker stop joins its thread with a five second
    timeout; stopEnvironmentWorker then spends up to another five seconds acquiring its
    lock and up to five flushing the write API; stopRoof joins, then waits on roofLock to
    switch the fans off, which was measured at nearly twelve seconds against a wedged
    serial port. Run one after another on the event loop -- as three of these were -- that
    is half a minute of a blocked loop while uvicorn is trying to close the client
    websockets.

    Run together in threads instead, so the cost is the slowest teardown rather than their
    sum. They contend for nothing: the roof and the environment worker hold different
    locks, and the capture and weather loops hold none. The one interleaving that can
    happen is the weather worker posting a fan command through updateFans while stopRoof
    is tearing the roof down, which is harmless -- the mailbox is cleared at the start of
    stopRoof and anything landing after it belongs to a roof that no longer exists, in a
    process that is exiting.

    That last argument holds only while nothing re-creates the roof afterwards, and a
    settings save in flight does exactly that: makeRoof() would take roofLock after this
    handler released it, build a fresh Roof, open the port and start a worker -- after the
    teardown had already switched the fans off and stopped the weather worker. The process
    would then exit with the port open and the fans running, and nothing left to switch
    them off, since RPi.GPIO leaves pin state untouched at exit. So the teardown runs under
    initLock, and shuttingDown stops any pass that has not started yet. The wait is bounded
    and proceeds anyway on expiry: an exit that cannot complete is worse than the race.

    asyncio.to_thread rather than run.io_bound: NiceGUI tears down its own executor on
    shutdown. Failures are collected rather than raised, because one teardown that throws
    must not leave the other three unreported.
    """
    global shuttingDown
    # Before the lock is even attempted, so a save already waiting on initLock finds it
    # set the moment it gets in rather than starting a re-initialization behind us.
    shuttingDown = True
    holdingInitLock = False
    try:
        await asyncio.wait_for(initLock.acquire(), timeout=shutdownInitLockTimeout)
        holdingInitLock = True
    except asyncio.TimeoutError:
        logger.error(
                "Settings were still being applied {}s into shutdown; tearing down "
                "anyway. The roof may be left as that pass configured it".format(
                    shutdownInitLockTimeout))
    try:
        stops = (
                ("capture loop", stopCaptureLoop),
                ("environment worker", stopEnvironmentWorker),
                ("weather worker", stopWeatherWorker),
                ("roof", stopRoof),
                )
        results = await asyncio.gather(
                *(asyncio.to_thread(stop) for _, stop in stops),
                return_exceptions=True
                )
        for (name, _), result in zip(stops, results):
            if isinstance(result, BaseException):
                logger.error("Error stopping {}: {}".format(name, result))
    finally:
        if holdingInitLock:
            initLock.release()

@app.on_startup
async def startup():
    global mainLoop
    mainLoop = asyncio.get_event_loop()
    # Switches first, before anything that can block. A switch set to restore its last
    # state powers equipment that is already running -- the observatory PC above all --
    # and it has to reach that state as early as possible. initStuff() opens the roof's
    # serial port first, which costs seconds on a wedged USB bridge, and a save landing
    # during startup can stretch that further. Only the pins are claimed here; initStuff()
    # calls initSwitches() again a moment later, which is free for pins that have not
    # changed. triggerEvent() only needs mainLoop, set above -- updateQueue buffers until
    # updateWorker is spawned, and no client is connected this early anyway.
    #
    # Under initLock, and released again before initStuff() takes it -- the lock is not
    # reentrant. No client exists yet at this point, so nothing can contend it; holding it
    # anyway costs nothing and makes the ordering guarantee independent of that argument.
    async with initLock:
        initSwitches()
    spawn(updateWorker())
    await initStuff()

try:
    ui.run(dark=True, favicon="favicon.svg", port=args.port, reload=False)
except KeyboardInterrupt:
    logger.info("Shutdown requested, exiting")
